digraph BD { graph [rankdir=TB,bgcolor="white",pad="0.3",nodesep="0.3",ranksep="0.5",splines=polyline]; node [shape=record,fontname="DejaVu Sans",fontsize=10,style=filled,fillcolor="#F4F7FA",color="#607080"]; edge [fontname="DejaVu Sans",fontsize=8,color="#708090",arrowsize=0.7];
"usuario" [label="{usuario|id PK : INT\lnombres : VARCHAR\lapellidos : VARCHAR\lcorreo : VARCHAR\lcontrasena : VARCHAR\ldni : VARCHAR\lactivo : BOOLEAN\l}"];
"administrador" [label="{administrador|usuario_id PK : INT\lcodigo_empleado : VARCHAR\l}"];
"cliente" [label="{cliente|usuario_id PK : INT\lfecha_registro : DATE\ltelefono : VARCHAR\l}"];
"sede" [label="{sede|id PK : INT\lrazon_social : VARCHAR\ldireccion : VARCHAR\lciudad : VARCHAR\ltelefono_contacto : VARCHAR\lactivo : BOOLEAN\l}"];
"sala" [label="{sala|id PK : INT\lsede_id : INT\lnombre : VARCHAR\laforo : INT\ltipo_sala : VARCHAR\lactivo : BOOLEAN\l}"];
"butaca" [label="{butaca|id PK : INT\lsala_id : INT\lfila : VARCHAR\lcolumna : INT\ltipo_butaca : VARCHAR\lactivo : BOOLEAN\l}"];
"evento" [label="{evento|id PK : INT\lprecio : DECIMAL\lactivo : BOOLEAN\l}"];
"pelicula" [label="{pelicula|evento_id PK : INT\lnombre_pelicula : VARCHAR\lduracion_minutos : INT\lgenero : ENUM\lclasificacion_edad : ENUM\ldirector : VARCHAR\l}"];
"obra_teatro" [label="{obra_teatro|evento_id PK : INT\ltitulo : VARCHAR\lnombre_director : VARCHAR\lelenco : VARCHAR\l}"];
"actividad_cultural" [label="{actividad_cultural|evento_id PK : INT\lnombre : VARCHAR\lexpositor : VARCHAR\ltipo_actividad : ENUM\l}"];
"funcion" [label="{funcion|id PK : INT\levento_id : INT\lsala_id : INT\lfecha : DATE\lhora_inicio : TIME\lhora_fin : TIME\lidioma : VARCHAR\lestado : ENUM\l}"];
"reserva" [label="{reserva|id PK : INT\lfuncion_id : INT\lcliente_id : INT\lcantidad : INT\lprecio_unitario : DECIMAL\lfecha_creacion : DATETIME\lfecha_expiracion : DATETIME\lestado : ENUM\l}"];
"reserva_butaca" [label="{reserva_butaca|reserva_id : INT\lbutaca_id : INT\l}"];
"pago" [label="{pago|id PK : INT\lreserva_id : INT\lcodigo_pago : VARCHAR\lmonto : DECIMAL\lfecha_pago : DATETIME\lestado : ENUM\l}"];
"entrada" [label="{entrada|id PK : INT\lreserva_id : INT\lbutaca_id : INT\lfecha_emision : DATETIME\lcodigo_qr : VARCHAR\lprecio_final : DECIMAL\lestado : ENUM\l}"];
"auditoria" [label="{auditoria|id PK : INT\lfuncion_id : INT\lfecha : DATETIME\lresponsable : VARCHAR\ldescripcion : VARCHAR\lestado : ENUM\l}"];
"administrador" -> "usuario" [label="usuario_id"];
"cliente" -> "usuario" [label="usuario_id"];
"sala" -> "sede" [label="sede_id"];
"butaca" -> "sala" [label="sala_id"];
"pelicula" -> "evento" [label="evento_id"];
"obra_teatro" -> "evento" [label="evento_id"];
"actividad_cultural" -> "evento" [label="evento_id"];
"funcion" -> "evento" [label="evento_id"];
"funcion" -> "sala" [label="sala_id"];
"reserva" -> "funcion" [label="funcion_id"];
"reserva" -> "cliente" [label="cliente_id"];
"reserva_butaca" -> "reserva" [label="reserva_id"];
"reserva_butaca" -> "butaca" [label="butaca_id"];
"pago" -> "reserva" [label="reserva_id"];
"entrada" -> "reserva" [label="reserva_id"];
"entrada" -> "reserva_butaca" [label="reserva_id, butaca_id"];
"auditoria" -> "funcion" [label="funcion_id"];
}