@inherits LayoutComponentBase

<div class="d-flex min-vh-100 flex-column">
<nav class="navbar navbar-expand-lg navbar-dark bg-primary" aria-label="Navegación principal">
    <div class="container-fluid px-3 px-lg-4">
        <a class="navbar-brand fw-semibold" href="">EntreFunciones</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation"
                aria-controls="mainNavigation" aria-expanded="false" aria-label="Mostrar u ocultar navegación">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNavigation">
            <div class="navbar-nav me-auto">
        @* ---------- Solo administrador ---------- *@
        <AuthorizeView Policy="Reportes">
            <NavLink class="nav-link" href="admin" Match="NavLinkMatch.All">Reportes</NavLink>
        </AuthorizeView>

        <AuthorizeView Policy="Ventas">
            <NavLink class="nav-link" href="admin/ventas">Ventas</NavLink>
        </AuthorizeView>

        <AuthorizeView Policy="Espacios">
            <NavLink class="nav-link" href="admin/sedes">Sedes</NavLink>
            <NavLink class="nav-link" href="admin/salas">Salas</NavLink>
        </AuthorizeView>

        <AuthorizeView Policy="Programacion">
            <NavLink class="nav-link" href="admin/catalogo">Catálogo</NavLink>
            <NavLink class="nav-link" href="admin/funciones">Funciones</NavLink>
            @*<NavLink class="nav-link" href="admin/funciones/nueva">Programar función</NavLink>*@
        </AuthorizeView>

        <AuthorizeView Policy="UsuariosRoles">
            <NavLink class="nav-link" href="admin/usuarios">Usuarios y roles</NavLink>
        </AuthorizeView>

        @* ---------- Cliente: páginas públicas (sin Authorize, ver Permisos.cs) ---------- *@
        <NavLink class="nav-link" href="cartelera">Cartelera</NavLink>

        @* ---------- Solo cliente autenticado (activar cuando existan las páginas) ---------- *@
        @*
        <AuthorizeView Policy="Compras">
            <NavLink class="nav-link" href="mis-compras">Mis compras</NavLink>
        </AuthorizeView>
        *@
            </div>

            <div class="navbar-nav align-items-lg-center border-top border-light border-opacity-25 mt-2 pt-2 mt-lg-0 pt-lg-0 border-lg-0">
        <AuthorizeView>
            <Authorized>
                <span class="navbar-text me-2">@context.User.Identity?.Name</span>
                @* Cerrar sesión debe ser un POST para que el servidor borre la cookie *@
                <form method="post" action="cuenta/logout" class="m-0">
                    <AntiforgeryToken />
                    <button type="submit" class="nav-link bg-transparent border-0">Cerrar sesión</button>
                </form>
            </Authorized>
            <NotAuthorized>
                <NavLink class="nav-link" href="login">Login</NavLink>
                <NavLink class="nav-link" href="registro">Registro</NavLink>
            </NotAuthorized>
        </AuthorizeView>
            </div>
        </div>
    </div>
</nav>

<main class="container py-4 flex-grow-1">
    @Body
</main>

<footer class="bg-light border-top py-3 mt-5">
    <div class="container text-center text-secondary small">
        © @DateTime.Now.Year EntreFunciones · Todos los derechos reservados
    </div>
</footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss" aria-label="Cerrar">🗙</span>
</div>
