@page "/Error"
@using System.Diagnostics

<PageTitle>Error</PageTitle>

<div class="page-shell page-shell-narrow">
<div class="alert alert-danger" role="alert">
    <h1 class="h3 alert-heading">No pudimos completar la solicitud</h1>
    <p class="mb-0">Ocurrió un error inesperado. Intenta nuevamente o vuelve al inicio.</p>
</div>

@if (ShowRequestId)
{
    <p class="small text-secondary">
        <strong>Identificador de la solicitud:</strong> <code>@RequestId</code>
    </p>
}

<a class="btn btn-primary" href="">Volver al inicio</a>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
