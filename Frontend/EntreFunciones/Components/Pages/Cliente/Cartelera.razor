@page "/cartelera"
@using System.Globalization
@using EntreFunciones.DTOSS
@using EntreFunciones.Servicios.Rest
@inject NavigationManager Nav
@inject ICatalogoService Catalogo

<PageTitle>Cartelera</PageTitle>

<div class="page-shell">
<div class="page-header">
    <div>
        <h1 class="page-title">Cartelera</h1>
        <p class="page-description">Explora los eventos y funciones disponibles.</p>
    </div>
</div>

@if (Cargando)
{
    <div class="text-center my-5" role="status">
        <div class="spinner-border" aria-hidden="true"></div>
        <p class="text-muted mt-2">Cargando cartelera...</p>
    </div>
}
else if (ErrorCarga is not null)
{
    <div class="alert alert-danger" role="alert">
        No se pudo cargar la cartelera: @ErrorCarga
        <button type="button" class="btn btn-sm btn-outline-danger ms-2" @onclick="Cargar">Reintentar</button>
    </div>
}
else
{
    <div class="filter-panel row g-3 align-items-end mx-0">
        <div class="col-6 col-md-3">
            <label for="filtroSede" class="form-label">Sede</label>
            <select id="filtroSede" class="form-select" @bind="FiltroSede">
                <option value="">Todas</option>
                @foreach (string sede in Sedes)
                {
                    <option value="@sede">@sede</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-3">
            <label for="filtroDistrito" class="form-label">Distrito</label>
            <select id="filtroDistrito" class="form-select" @bind="FiltroDistrito">
                <option value="">Todas</option>
                @foreach (string distrito in Distritos)
                {
                    <option value="@distrito">@distrito</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-3">
            <label for="filtroTipo" class="form-label">Tipo</label>
            <select id="filtroTipo" class="form-select" @bind="FiltroTipo">
                <option value="">Todos</option>
                <option value="PELICULA">Película</option>
                <option value="OBRA_TEATRO">Obra de teatro</option>
                <option value="ACTIVIDAD_CULTURAL">Actividad cultural</option>
            </select>
        </div>
        <div class="col-6 col-md-3">
            <label for="filtroPrecio" class="form-label">Precio máx. (S/)</label>
            <input id="filtroPrecio" type="number" min="0" class="form-control" @bind="FiltroPrecioMax" />
        </div>
        <div class="col-6 col-md-3">
            <label for="filtroFecha" class="form-label">Fecha</label>
            <input id="filtroFecha" type="date" class="form-control" @bind="FiltroFecha" />
        </div>
        <div class="col-6 col-md-3">
            <label for="filtroTematica" class="form-label">Temática</label>
            <select id="filtroTematica" class="form-select" @bind="FiltroTematica">
                <option value="">Todas</option>
                @foreach (string tematica in Tematicas)
                {
                    <option value="@tematica">@tematica</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-3">
            <label for="filtroAccesibilidad" class="form-label">Accesibilidad</label>
            <select id="filtroAccesibilidad" class="form-select" @bind="FiltroAccesibilidad">
                <option value="">Todas</option>
                <option value="SI">Sala accesible</option>
                <option value="NO">Sin característica registrada</option>
            </select>
        </div>
    </div>

    @if (!EventosFiltrados.Any())
    {
        <div class="empty-state" role="status">No hay funciones que coincidan con los filtros.</div>
    }
    else
    {
        @foreach (string tipo in TiposPresentes)
        {
            <h2 class="h5 mt-4 mb-3">@TextoTipo(tipo)</h2>
            <div class="row g-3">
                @foreach (EventoDTO evento in EventosFiltrados.Where(e => e.Tipo == tipo))
                {
                    (string sede, string ciudad) proxima = ProximaSedeYCiudad(evento.Id);

                    <div class="col-12 col-sm-6 col-lg-4">
                        <div class="card h-100 shadow-sm">
                            @if (TienePoster(evento.ImagenUrl))
                            {
                                @* Póster guardado en Amazon S3 *@
                                <img src="@evento.ImagenUrl" alt="Póster de @evento.Titulo" class="card-img-top" style="height:140px; object-fit:cover;" />
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center bg-light" style="height:140px;">
                                    <i class="@IconoTipo(evento.Tipo) text-secondary" style="font-size:3rem;"></i>
                                </div>
                            }
                            <div class="card-body d-flex flex-column">
                                <span class="badge text-bg-secondary align-self-start mb-2">@TextoTipo(evento.Tipo)</span>
                                <h3 class="card-title h5">@evento.Titulo</h3>
                                <p class="card-text text-muted mb-1">@(proxima.sede == "" ? "Sin funciones programadas" : $"{proxima.sede} · {proxima.ciudad}")</p>
                                <p class="card-text text-muted mb-2">@Tematica(evento)</p>
                                <p class="card-text mb-3">
                                    <strong>S/ @evento.Precio.ToString("N2", CultureInfo.InvariantCulture)</strong>
                                </p>
                                <button type="button" class="btn btn-primary mt-auto" @onclick="() => VerDetalle(evento.Id)">
                                    Ver detalle
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
}
</div>

@code {
    private string FiltroSede = string.Empty;
    private string FiltroDistrito = string.Empty;
    private string FiltroTipo = string.Empty;
    private string FiltroTematica = string.Empty;
    private string FiltroAccesibilidad = string.Empty;
    private DateOnly? FiltroFecha;
    private int? FiltroPrecioMax;

    private bool Cargando = true;
    private string? ErrorCarga;

    private List<EventoDTO> Eventos = new();
    private List<FuncionDTO> Funciones = new();

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }

    private async Task Cargar()
    {
        Cargando = true;
        ErrorCarga = null;
        try
        {
            // Solo eventos activos: el backend aun no distingue "publicado" de "activo" (RF-M4-01),
            // asi que por ahora se muestra todo evento activo tal cual EventoBL.findAll() lo devuelve.
            Funciones = (await Catalogo.ListarFunciones())
                .Where(f => f.Estado == "CONFIRMADA"
                    && DateOnly.TryParse(f.Fecha, out DateOnly fecha)
                    && fecha >= DateOnly.FromDateTime(DateTime.Today)
                    && (f.Sala?.IsActivo ?? true)
                    && (f.Sede?.IsActivo ?? true))
                .ToList();
            HashSet<int> publicados = Funciones.Select(f => f.IdEvento).ToHashSet();
            Eventos = (await Catalogo.ListarEventos())
                .Where(e => e.Activo && publicados.Contains(e.Id)).ToList();
        }
        catch (Exception ex)
        {
            ErrorCarga = ex.Message;
        }
        finally
        {
            Cargando = false;
        }
    }

    private List<string> Sedes => Funciones.Select(f => f.NombreSede ?? "").Where(s => s != "").Distinct().OrderBy(s => s).ToList();
    private List<string> Distritos => Funciones.Select(f => f.DistritoSede ?? "").Where(s => s != "").Distinct().OrderBy(s => s).ToList();
    private List<string> Tematicas => Eventos.Select(e => e.Tematica ?? "").Where(s => s != "").Distinct().OrderBy(s => s).ToList();
    private List<string> TiposPresentes => EventosFiltrados.Select(e => e.Tipo).Distinct().OrderBy(t => t).ToList();

    private IEnumerable<EventoDTO> EventosFiltrados => Eventos.Where(e =>
        (string.IsNullOrEmpty(FiltroTipo) || e.Tipo == FiltroTipo) &&
        (string.IsNullOrEmpty(FiltroTematica) || e.Tematica == FiltroTematica) &&
        (FiltroPrecioMax == null || e.Precio <= FiltroPrecioMax) &&
        Funciones.Any(f => f.IdEvento == e.Id
            && (string.IsNullOrEmpty(FiltroSede) || f.NombreSede == FiltroSede)
            && (string.IsNullOrEmpty(FiltroDistrito) || f.DistritoSede == FiltroDistrito)
            && (!FiltroFecha.HasValue || (DateOnly.TryParse(f.Fecha, out DateOnly fecha) && fecha == FiltroFecha.Value))
            && (string.IsNullOrEmpty(FiltroAccesibilidad)
                || (FiltroAccesibilidad == "SI" && f.SalaAccesible)
                || (FiltroAccesibilidad == "NO" && !f.SalaAccesible))));

    private (string sede, string ciudad) ProximaSedeYCiudad(int idEvento)
    {
        FuncionDTO? proxima = Funciones
            .Where(f => f.IdEvento == idEvento && f.Estado == "CONFIRMADA")
            .OrderBy(f => f.Fecha).ThenBy(f => f.HoraInicio)
            .FirstOrDefault();

        return proxima is null ? ("", "") : (proxima.NombreSede ?? "", proxima.CiudadSede ?? "");
    }

    private string Tematica(EventoDTO evento) => evento.Tipo switch
    {
        "PELICULA" => TextoGenero(evento.Genero),
        "OBRA_TEATRO" => string.IsNullOrWhiteSpace(evento.NombreDirector) ? "" : $"Dirección: {evento.NombreDirector}",
        "ACTIVIDAD_CULTURAL" => TextoTipoActividad(evento.TipoActividad),
        _ => ""
    };

    // Icono generico por tipo mientras el equipo decide como se van a manejar las imagenes
    // reales de cada evento (ver decisiones-diseno-catalogo-rest.md). No depende de esa decision:
    // es un icono decorativo de Bootstrap Icons, no una imagen propia del evento.
    // Solo las URLs completas (de S3) son imágenes reales; las rutas viejas de datos-demo no existen
    private static bool TienePoster(string? url) => url != null && url.StartsWith("http");

    private string IconoTipo(string tipo) => tipo switch
    {
        "PELICULA" => "bi bi-film",
        "OBRA_TEATRO" => "bi bi-emoji-smile",
        "ACTIVIDAD_CULTURAL" => "bi bi-people",
        _ => "bi bi-calendar-event"
    };

    private string TextoTipo(string tipo) => tipo switch
    {
        "PELICULA" => "Película",
        "OBRA_TEATRO" => "Obra de teatro",
        "ACTIVIDAD_CULTURAL" => "Actividad cultural",
        _ => tipo
    };

    private string TextoGenero(string? genero) => genero switch
    {
        "ACCION" => "Acción",
        "COMEDIA" => "Comedia",
        "DRAMA" => "Drama",
        "TERROR" => "Terror",
        "ANIMACION" => "Animación",
        "DOCUMENTAL" => "Documental",
        _ => genero ?? ""
    };

    private string TextoTipoActividad(string? tipo) => tipo switch
    {
        "CHARLA" => "Charla",
        "TALLER" => "Taller",
        "EXPOSICION" => "Exposición",
        "CONVERSATORIO" => "Conversatorio",
        _ => tipo ?? ""
    };

    private void VerDetalle(int id)
    {
        Nav.NavigateTo($"/evento/{id}");
    }
}
