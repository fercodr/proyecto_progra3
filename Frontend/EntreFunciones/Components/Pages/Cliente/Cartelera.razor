@page "/cartelera"
@using System.Globalization
@inject NavigationManager Nav

<PageTitle>Cartelera</PageTitle>

<h1 class="mb-3">Cartelera</h1>

<div class="row g-2 align-items-end mb-4">
    <div class="col-6 col-md-2">
        <label class="form-label">Fecha</label>
        <input type="date" class="form-control" @bind="FiltroFecha" />
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label">Sede</label>
        <select class="form-select" @bind="FiltroSede">
            <option value="">Todas</option>
            @foreach (string sede in Sedes)
            {
                <option value="@sede">@sede</option>
            }
        </select>
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label">Distrito</label>
        <select class="form-select" @bind="FiltroDistrito">
            <option value="">Todos</option>
            @foreach (string distrito in Distritos)
            {
                <option value="@distrito">@distrito</option>
            }
        </select>
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label">Tipo</label>
        <select class="form-select" @bind="FiltroTipo">
            <option value="">Todos</option>
            <option value="Pelicula">Película</option>
            <option value="ObraTeatro">Obra de teatro</option>
            <option value="ActividadCultural">Actividad cultural</option>
        </select>
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label">Precio máx. (S/)</label>
        <input type="number" min="0" class="form-control" @bind="FiltroPrecioMax" />
    </div>
    <div class="col-6 col-md-2 form-check ms-1">
        <input type="checkbox" class="form-check-input" id="chkAccesible" @bind="FiltroAccesible" />
        <label class="form-check-label" for="chkAccesible">Solo accesibles</label>
    </div>
</div>

@if (!EventosFiltrados.Any())
{
    <div class="alert alert-info">No hay funciones que coincidan con los filtros.</div>
}
else
{
    <div class="row g-3">
        @foreach (EventoCartelera evento in EventosFiltrados)
        {
            <div class="col-12 col-sm-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <span class="badge text-bg-secondary align-self-start mb-2">@TextoTipo(evento.Tipo)</span>
                        <h5 class="card-title">@evento.Titulo</h5>
                        <p class="card-text text-muted mb-1">@evento.Sede &middot; @evento.Distrito</p>
                        <p class="card-text text-muted mb-2">@evento.Tematica</p>
                        <p class="card-text mb-3">
                            <strong>S/ @evento.Precio.ToString("N2", CultureInfo.InvariantCulture)</strong>
                            @if (evento.Accesible)
                            {
                                <span class="badge text-bg-success ms-2">Accesible</span>
                            }
                        </p>
                        <button class="btn btn-primary mt-auto" @onclick="() => VerDetalle(evento.Id)">
                            Ver detalle
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private DateTime? FiltroFecha;
    private string FiltroSede = string.Empty;
    private string FiltroDistrito = string.Empty;
    private string FiltroTipo = string.Empty;
    private int? FiltroPrecioMax;
    private bool FiltroAccesible;

    // RF-M4-01: dato de ejemplo mientras no hay conexion al backend Java.
    // Reemplazar por EventoBL.findAll() (solo eventos confirmados / publicados) cuando se integre.
    private List<EventoCartelera> Eventos = new()
    {
        new EventoCartelera(1, "Pelicula", "Interestelar", "Cineplanet Jockey Plaza", "Surco", "Ciencia ficcion", 22.00, true),
        new EventoCartelera(2, "Pelicula", "Spider-Man: Brand New Day", "Cineplanet Norte", "Independencia", "Accion", 18.50, false),
        new EventoCartelera(3, "ObraTeatro", "La Muralla", "Teatro Municipal", "Lima", "Drama historico", 35.00, true),
        new EventoCartelera(4, "ActividadCultural", "Charla: Arte Contemporaneo", "Sede Miraflores", "Miraflores", "Charla", 10.00, true),
        new EventoCartelera(5, "ActividadCultural", "Taller de Ceramica", "Sede Barranco", "Barranco", "Taller", 25.00, false),
    };

    private List<string> Sedes => Eventos.Select(e => e.Sede).Distinct().OrderBy(s => s).ToList();
    private List<string> Distritos => Eventos.Select(e => e.Distrito).Distinct().OrderBy(s => s).ToList();

    private IEnumerable<EventoCartelera> EventosFiltrados => Eventos.Where(e =>
        (string.IsNullOrEmpty(FiltroSede) || e.Sede == FiltroSede) &&
        (string.IsNullOrEmpty(FiltroDistrito) || e.Distrito == FiltroDistrito) &&
        (string.IsNullOrEmpty(FiltroTipo) || e.Tipo == FiltroTipo) &&
        (FiltroPrecioMax == null || e.Precio <= FiltroPrecioMax) &&
        (!FiltroAccesible || e.Accesible));

    private string TextoTipo(string tipo) => tipo switch
    {
        "Pelicula" => "Película",
        "ObraTeatro" => "Obra de teatro",
        "ActividadCultural" => "Actividad cultural",
        _ => tipo
    };

    private void VerDetalle(int id)
    {
        Nav.NavigateTo($"/evento/{id}");
    }

    private record EventoCartelera(int Id, string Tipo, string Titulo, string Sede, string Distrito, string Tematica, double Precio, bool Accesible);
}
