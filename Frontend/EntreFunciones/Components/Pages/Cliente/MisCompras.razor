@page "/mis-compras"
<PageTitle>Mis compras</PageTitle>

<div class="page-shell">
    <div class="page-header">
        <div>
            <h1 class="page-title">Mis compras</h1>
            <p class="page-description">Consulta el estado y los datos de tus entradas.</p>
        </div>
    </div>

    @if (Entradas == null || !Entradas.Any())
    {
        <div class="empty-state" role="status">No tienes entradas registradas.</div>
    }
    else
    {
        <div class="data-table-wrapper shadow-sm">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Código / ID</th>
                        <th>Función</th>
                        <th>Fecha y Hora</th>
                        <th>Butaca</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entrada in Entradas)
                    {
                        <tr>
                            <td><strong>@entrada.CodigoEntrada</strong></td>
                            <td>@entrada.ObraONombre</td>
                            <td>@entrada.FuncionFechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@entrada.Butaca</td>
                            <td>
                                <span class="badge @ObtenerBadgeEstadoEntrada(entrada.Estado)">
                                    @entrada.Estado
                                </span>
                            </td>
                            <td class="text-end">
                                <button class="btn btn-outline-danger btn-sm" type="button">
                                    Cancelar entrada
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    public class EntradaDto
    {
        public int Id { get; set; }
        public string CodigoEntrada { get; set; } = string.Empty;
        public string ObraONombre { get; set; } = string.Empty;
        public DateTime FuncionFechaHora { get; set; }
        public string Butaca { get; set; } = string.Empty;
        public string Estado { get; set; } = "Vigente"; 
    }

    public List<EntradaDto> Entradas { get; set; } = new()
    {
        new EntradaDto { Id = 1, CodigoEntrada = "ENT-8921", ObraONombre = "Avengers Doomsday", FuncionFechaHora = DateTime.Now.AddDays(2), Butaca = "A-12", Estado = "Vigente" },
        new EntradaDto { Id = 2, CodigoEntrada = "ENT-4412", ObraONombre = "ChainsawMan: Reze Arc", FuncionFechaHora = DateTime.Now.AddDays(-5), Butaca = "B-05", Estado = "Utilizada" },
        new EntradaDto { Id = 3, CodigoEntrada = "ENT-1102", ObraONombre = "La Odisea", FuncionFechaHora = DateTime.Now.AddDays(10), Butaca = "C-01", Estado = "Cancelada" }
    };

    private string ObtenerBadgeEstadoEntrada(string estado) => estado switch
    {
        "Vigente" => "bg-success",
        "Utilizada" => "bg-secondary",
        "Cancelada" => "bg-danger",
        _ => "bg-light text-dark"
    };
}
