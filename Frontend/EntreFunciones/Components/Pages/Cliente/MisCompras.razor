@page "/mis-compras"
@attribute [Authorize(Policy = "Compras")]
@using EntreFunciones.DTOSS
@using EntreFunciones.Mappers
@using EntreFunciones.Servicios.Rest
@using EntreFunciones.ViewModels
@inject ICompraService Api
<PageTitle>Mis compras</PageTitle>

<div class="page-shell">
    <div class="page-header">
        <div>
            <h1 class="page-title">Mis compras</h1>
            <p class="page-description">Consulta el estado de tus reservas y completa los pagos pendientes.</p>
        </div>
        <a class="btn btn-primary" href="/cartelera"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Nueva compra</a>
    </div>

    @if (!string.IsNullOrEmpty(Mensaje))
    {
        <div class="alert alert-success alert-dismissible" role="status" aria-live="polite">
            @Mensaje
            <button type="button" class="btn-close" aria-label="Cerrar" @onclick="() => Mensaje = string.Empty"></button>
        </div>
    }

    @if (Cargando)
    {
        <div class="d-flex align-items-center gap-2 text-secondary" role="status" aria-live="polite">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            Cargando tus compras...
        </div>
    }
    else if (!string.IsNullOrEmpty(Error))
    {
        <div class="alert alert-danger" role="alert" aria-live="assertive">
            <h2 class="h5 alert-heading">No pudimos cargar tus compras</h2>
            <p>@Error</p>
            <button type="button" class="btn btn-danger btn-sm" @onclick="CargarAsync">Reintentar</button>
        </div>
    }
    else if (Compras.Count == 0)
    {
        <div class="empty-state" role="status">
            <p class="mb-2">Todavía no tienes compras registradas.</p>
            <a class="btn btn-outline-primary btn-sm" href="/cartelera">Ver la cartelera</a>
        </div>
    }
    else
    {
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <label for="filtroEstado" class="form-label mb-0 small text-muted">Estado</label>
            <select id="filtroEstado" class="form-select form-select-sm w-auto" @bind="FiltroEstado">
                <option value="">Todos</option>
                @foreach (string estado in Compras.Select(c => c.Estado).Distinct().Order())
                {
                    <option value="@estado">@estado</option>
                }
            </select>
            <IconoInfo Texto="Pendiente de pago: aún puedes pagarla. Pago en validación: ya pagaste y el administrador lo está revisando. Confirmada: el pago fue validado. Expirada: pasaron los 15 minutos sin pagar. Cancelada: la anulaste." />
        </div>

        <div class="data-table-wrapper shadow-sm">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Código</th>
                        <th scope="col">Función</th>
                        <th scope="col">Fecha de la función</th>
                        <th scope="col" class="text-end">Monto</th>
                        <th scope="col">Estado</th>
                        <th scope="col" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (CompraClienteViewModel compra in ComprasFiltradas)
                    {
                        <tr>
                            <td class="font-monospace">@compra.Codigo</td>
                            <td>@compra.Funcion</td>
                            <td>@compra.FechaFuncion.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end">@CompraClienteMapper.Soles(compra.Monto)</td>
                            <td><span class="badge @compra.EstadoClase">@compra.Estado</span></td>
                            <td class="text-end text-nowrap">
                                <button type="button" class="btn btn-outline-secondary btn-sm" aria-label="Ver detalle de @compra.Codigo"
                                        @onclick="() => Detalle = compra">
                                    <i class="bi bi-eye" aria-hidden="true"></i>
                                </button>
                                @if (compra.Pendiente)
                                {
                                    <a class="btn btn-success btn-sm ms-1" href="@($"/reserva/{compra.Id}/pago")">Pagar</a>
                                    <button type="button" class="btn btn-outline-danger btn-sm ms-1" @onclick="() => PorCancelar = compra">Cancelar</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@* Pop-up con la información adicional de la compra, para no sobrecargar la tabla *@
<ModalConfirmacion Visible="Detalle != null" Titulo="@($"Detalle de {Detalle?.Codigo}")" Icono="bi-receipt"
                   TextoConfirmar="Cerrar" TextoCancelar="Volver" Variante="secondary"
                   OnConfirmar="() => Detalle = null" OnCancelar="() => Detalle = null">
    @if (Detalle != null)
    {
        <dl class="row mb-0">
            <dt class="col-5 text-muted fw-normal">Función</dt>
            <dd class="col-7">@Detalle.Funcion</dd>
            <dt class="col-5 text-muted fw-normal">Fecha de la función</dt>
            <dd class="col-7">@Detalle.FechaFuncion.ToString("dd/MM/yyyy HH:mm")</dd>
            <dt class="col-5 text-muted fw-normal">Cantidad</dt>
            <dd class="col-7">@Detalle.Cantidad</dd>
            <dt class="col-5 text-muted fw-normal">Monto total</dt>
            <dd class="col-7">@CompraClienteMapper.Soles(Detalle.Monto)</dd>
            <dt class="col-5 text-muted fw-normal">Reservado el</dt>
            <dd class="col-7">@Detalle.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</dd>
            @if (Detalle.Pendiente)
            {
                <dt class="col-5 text-muted fw-normal">Pagar antes de</dt>
                <dd class="col-7">@Detalle.FechaExpiracion.ToString("dd/MM/yyyy HH:mm")</dd>
            }
            <dt class="col-5 text-muted fw-normal">Estado</dt>
            <dd class="col-7 mb-0"><span class="badge @Detalle.EstadoClase">@Detalle.Estado</span></dd>
        </dl>
    }
</ModalConfirmacion>

<ModalConfirmacion Visible="PorCancelar != null" Titulo="¿Cancelar reserva?" Variante="danger" Icono="bi-exclamation-triangle"
                   TextoConfirmar="Sí, cancelar" TextoCancelar="No, mantener" Procesando="Enviando"
                   OnConfirmar="CancelarAsync" OnCancelar="() => PorCancelar = null">
    <p class="mb-0">
        Se cancelará la reserva <strong>@PorCancelar?.Codigo</strong> de <strong>@PorCancelar?.Funcion</strong> y se liberarán sus butacas.
        Esta acción no se puede deshacer.
    </p>
</ModalConfirmacion>

@code {
    private List<CompraClienteViewModel> Compras = [];
    private string FiltroEstado = string.Empty;
    private IEnumerable<CompraClienteViewModel> ComprasFiltradas =>
        string.IsNullOrEmpty(FiltroEstado) ? Compras : Compras.Where(c => c.Estado == FiltroEstado);
    private CompraClienteViewModel? Detalle;
    private CompraClienteViewModel? PorCancelar;
    private bool Cargando;
    private bool Enviando;
    private string Error = string.Empty;
    private string Mensaje = string.Empty;

    protected override Task OnInitializedAsync() => CargarAsync();

    private async Task CargarAsync()
    {
        Cargando = true;
        Error = string.Empty;
        try
        {
            List<ReservaDto> reservas = await Api.ListarReservas();
            // Una reserva ACTIVA puede estar ya pagada (esperando validación): se consulta su pago.
            PagoDto[] pagos = await Task.WhenAll(reservas
                .Where(r => r.Estado == "ACTIVA")
                .Select(r => Api.GenerarPago(r.Id)));
            HashSet<int> pagadas = pagos.Where(p => !string.IsNullOrEmpty(p.FechaPago)).Select(p => p.ReservaId).ToHashSet();
            Compras = CompraClienteMapper.ToViewModels(reservas, pagadas);
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException or ServiceException or TaskCanceledException)
        {
            Error = e.Message;
        }
        finally
        {
            Cargando = false;
        }
    }

    private async Task CancelarAsync()
    {
        if (PorCancelar == null || Enviando) return;
        Enviando = true;
        string codigo = PorCancelar.Codigo;
        try
        {
            await Api.Cancelar(PorCancelar.Id);
            Mensaje = $"La reserva {codigo} fue cancelada.";
            PorCancelar = null;
            await CargarAsync();
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException or ServiceException or TaskCanceledException)
        {
            Error = e.Message;
            PorCancelar = null;
        }
        finally
        {
            Enviando = false;
        }
    }
}
