@page "/reserva/{Id:int}/pago"
@attribute [Authorize(Policy = "Compras")]
@using EntreFunciones.DTOSS
@using EntreFunciones.Mappers
@using EntreFunciones.Servicios.Rest
@using EntreFunciones.ViewModels
@implements IDisposable
@inject ICompraService Api
@inject NavigationManager Nav
<PageTitle>@TituloPagina</PageTitle>

<div class="page-shell page-shell-narrow">
    <PasosCompra PasoActual="Paso" />

    @if (Cargando)
    {
        <div class="d-flex align-items-center gap-2 text-secondary" role="status" aria-live="polite">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            Cargando detalles de la reserva...
        </div>
    }
    else if (!string.IsNullOrEmpty(Error))
    {
        <div class="alert alert-danger" role="alert" aria-live="assertive">
            <h1 class="h5 alert-heading">No pudimos cargar la reserva</h1>
            <p>@Error</p>
            <button type="button" class="btn btn-danger btn-sm me-2" @onclick="CargarAsync">Reintentar</button>
            <a class="btn btn-outline-danger btn-sm" href="/cartelera">Volver a la cartelera</a>
        </div>
    }
    else if (Reserva == null)
    {
        <div class="alert alert-warning" role="status" aria-live="polite">No se encontró la reserva solicitada.</div>
    }
    else if (Paso == 4)
    {
        @* ---------- Etapa 4: Confirmación ---------- *@
        <div class="card shadow-sm text-center">
            <div class="card-body p-4">
                @if (Reserva.Estado == "CONFIRMADA")
                {
                    <i class="bi bi-check-circle-fill text-success display-5" aria-hidden="true"></i>
                    @if (Gratuita)
                    {
                        <h1 class="h4 mt-3">¡Reserva confirmada!</h1>
                        <p class="text-muted">Esta función es gratuita, así que no necesitas pagar. Tus entradas ya fueron emitidas y también están en <strong>Mis compras</strong>.</p>
                    }
                    else
                    {
                        <h1 class="h4 mt-3">¡Compra confirmada!</h1>
                        <p class="text-muted">Tu pago fue validado. Tus entradas ya fueron emitidas y también están en <strong>Mis compras</strong>.</p>
                    }
                }
                else
                {
                    <i class="bi bi-hourglass-split text-primary display-5" aria-hidden="true"></i>
                    <h1 class="h4 mt-3">¡Pago registrado!</h1>
                    <p class="text-muted mb-1">
                        Tu pago está <strong>pendiente de validación</strong>
                        <IconoInfo Texto="Un administrador revisa cada pago. Cuando lo valide, tu reserva pasará a 'Confirmada' y tus entradas aparecerán en Mis compras." />
                    </p>
                    <p class="text-muted small">Puedes revisar el estado en cualquier momento desde Mis compras.</p>
                }

                <dl class="row text-start small bg-light rounded p-3 mx-0 my-3">
                    <dt class="col-5">Código de reserva</dt>
                    <dd class="col-7 mb-1 font-monospace">@Reserva.CodigoOId</dd>
                    @if (Pago != null)
                    {
                        <dt class="col-5">Código de pago</dt>
                        <dd class="col-7 mb-1 font-monospace">@Pago.CodigoPago</dd>
                    }
                    <dt class="col-5">Función</dt>
                    <dd class="col-7 mb-1">@Reserva.FuncionNombre</dd>
                    <dt class="col-5">Fecha de la función</dt>
                    <dd class="col-7 mb-1">@Reserva.FechaFuncion.ToString("dd/MM/yyyy HH:mm")</dd>
                    <dt class="col-5">@(Gratuita ? "Monto" : "Monto pagado")</dt>
                    <dd class="col-7 mb-0">@CompraClienteMapper.SolesOGratis(Reserva.MontoTotal)</dd>
                </dl>

                @* RF-M5-03: una entrada con su propio QR por cada cupo, apenas la reserva queda confirmada *@
                @if (Entradas.Count > 0)
                {
                    <h2 class="h6 text-start">Tus entradas</h2>
                    <div class="d-flex flex-wrap justify-content-center gap-3 mb-3">
                        @foreach (EntradaClienteViewModel entrada in Entradas)
                        {
                            <div class="text-center border rounded p-2">
                                <CodigoQr Valor="@entrada.CodigoQR" Tamano="140" TextoAlternativo="@($"Código QR de la entrada {entrada.Codigo}")" />
                                <div class="small font-monospace mt-1">@entrada.Codigo</div>
                                <div class="small text-muted">@entrada.Butaca</div>
                                <span class="badge @entrada.EstadoClase mt-1">@entrada.Estado</span>
                            </div>
                        }
                    </div>
                }
                else if (!string.IsNullOrEmpty(AvisoEntradas))
                {
                    <div class="alert alert-warning py-2 small text-start" role="alert">@AvisoEntradas</div>
                }

                <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center">
                    <a class="btn btn-primary" href="/mis-compras"><i class="bi bi-ticket-perforated me-1" aria-hidden="true"></i>Ver mis compras</a>
                    <a class="btn btn-outline-secondary" href="/cartelera">Volver a la cartelera</a>
                </div>
            </div>
        </div>
    }
    else if (Reserva.Estado != "ACTIVA" || Segundos <= 0)
    {
        @* Reserva que ya no se puede pagar (expiró o fue cancelada) *@
        <div class="alert alert-warning" role="alert">
            <h1 class="h5 alert-heading">
                Esta reserva está @(Segundos <= 0 && Reserva.Estado == "ACTIVA" ? "expirada" : CompraClienteMapper.EstadoTexto(Reserva.Estado).ToLower())
            </h1>
            <p class="mb-2">Las butacas se liberaron y ya no es posible pagarla. Puedes iniciar una nueva compra desde la cartelera.</p>
            <a class="btn btn-warning btn-sm me-2" href="/cartelera">Ir a la cartelera</a>
            <a class="btn btn-outline-secondary btn-sm" href="/mis-compras">Ver mis compras</a>
        </div>
    }
    else
    {
        <div class="page-header">
            <div>
                <h1 class="page-title">@TituloPagina</h1>
                <p class="page-description">
                    @(Paso == 2 ? "Revisa el detalle de tu reserva antes de continuar." : "Ingresa los datos de tu tarjeta para completar la compra.")
                </p>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(ErrorAccion))
        {
            <div class="alert alert-danger" role="alert" aria-live="assertive">@ErrorAccion</div>
        }

        <div class="alert @(Segundos < 120 ? "alert-danger" : "alert-warning") py-2 d-flex align-items-center gap-2" role="status">
            <i class="bi bi-clock" aria-hidden="true"></i>
            <span>Tiempo restante para pagar: <strong>@TiempoRestante</strong></span>
            <IconoInfo Texto="Tus butacas están bloqueadas mientras dure este tiempo. Si llega a 00:00 la reserva expira y las butacas se liberan." />
        </div>

        @if (Paso == 2)
        {
            @* ---------- Etapa 2: Reserva ---------- *@
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2 class="card-title h5 mb-0">Reserva <span class="text-primary font-monospace">@Reserva.CodigoOId</span></h2>
                        <span class="badge @CompraClienteMapper.EstadoClase(Reserva.Estado)">@CompraClienteMapper.EstadoTexto(Reserva.Estado)</span>
                    </div>
                    <dl class="row mb-0">
                        <dt class="col-sm-5 text-muted fw-normal">Función</dt>
                        <dd class="col-sm-7">@Reserva.FuncionNombre</dd>
                        <dt class="col-sm-5 text-muted fw-normal">Fecha de la función</dt>
                        <dd class="col-sm-7">@Reserva.FechaFuncion.ToString("dd/MM/yyyy HH:mm")</dd>
                        <dt class="col-sm-5 text-muted fw-normal">Cantidad</dt>
                        <dd class="col-sm-7">@Reserva.Cantidad @(Reserva.Cantidad == 1 ? "entrada" : "entradas")</dd>
                        <dt class="col-sm-5 text-muted fw-normal">Vence el</dt>
                        <dd class="col-sm-7">@Reserva.FechaExpiracion.ToString("dd/MM/yyyy HH:mm")</dd>
                        @if (Pago != null)
                        {
                            @* RF-M5-02: el cliente consulta el código de pago generado para su reserva *@
                            <dt class="col-sm-5 text-muted fw-normal">
                                Código de pago
                                <IconoInfo Texto="Es el código con el que el administrador busca y valida tu pago. Guárdalo por si necesitas hacer una consulta." />
                            </dt>
                            <dd class="col-sm-7 font-monospace text-break">@Pago.CodigoPago</dd>
                        }
                        <dt class="col-sm-5 text-muted fw-normal">Total a pagar</dt>
                        <dd class="col-sm-7 mb-0 fs-5 fw-semibold">@CompraClienteMapper.Soles(Reserva.MontoTotal)</dd>
                    </dl>
                </div>
            </div>

            <div class="d-flex flex-column-reverse flex-sm-row justify-content-between gap-2">
                <button type="button" class="btn btn-outline-danger" disabled="@Enviando" @onclick="() => MostrarCancelar = true">
                    Cancelar reserva
                </button>
                <button type="button" class="btn btn-primary" disabled="@(Enviando || Pago == null)" @onclick="IrAPago">
                    Continuar al pago <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
                </button>
            </div>
        }
        else
        {
            @* ---------- Etapa 3: Pago ---------- *@
            <div class="card shadow-sm mb-3 bg-light border-0">
                <div class="card-body py-2 d-flex flex-wrap justify-content-between gap-2 small">
                    <span><strong>@Reserva.FuncionNombre</strong> &middot; @Reserva.Cantidad @(Reserva.Cantidad == 1 ? "entrada" : "entradas")</span>
                    <span>Total: <strong>@CompraClienteMapper.Soles(Reserva.MontoTotal)</strong></span>
                    @if (Pago != null)
                    {
                        <span class="w-100 text-muted">Código de pago: <span class="font-monospace text-break">@Pago.CodigoPago</span></span>
                    }
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h2 class="h5 mb-3">
                        Datos de la tarjeta
                        <IconoInfo Texto="Pago simulado: los datos de la tarjeta no se envían ni se guardan en el sistema." />
                    </h2>
                    <form @onsubmit="PedirConfirmacionPago" @onsubmit:preventDefault="true" novalidate>
                        <div class="mb-3">
                            <label for="nombreTitular" class="form-label">Nombre del titular</label>
                            <input id="nombreTitular" type="text" autocomplete="cc-name" maxlength="50"
                                   class="form-control @ClaseCampo(TocadoNombre, ErrorNombre)"
                                   placeholder="Como figura en la tarjeta"
                                   @bind:get="NombreTitular" @bind:set="AlCambiarNombre" @bind:event="oninput"
                                   @onblur="() => TocadoNombre = true"
                                   aria-invalid="@((TocadoNombre && ErrorNombre != null).ToString().ToLower())" aria-describedby="errorNombre" />
                            @if (TocadoNombre && ErrorNombre != null)
                            {
                                <div id="errorNombre" class="invalid-feedback d-block">@ErrorNombre</div>
                            }
                        </div>

                        <div class="mb-3">
                            <label for="numeroTarjeta" class="form-label d-flex justify-content-between">
                                <span>Número de tarjeta</span>
                                @if (MarcaTarjeta != null)
                                {
                                    <span class="badge text-bg-light border">@MarcaTarjeta</span>
                                }
                            </label>
                            <input id="numeroTarjeta" type="text" inputmode="numeric" autocomplete="cc-number" maxlength="19"
                                   class="form-control font-monospace @ClaseCampo(TocadoNumero, ErrorNumero)"
                                   placeholder="0000 0000 0000 0000"
                                   @bind:get="NumeroTarjeta" @bind:set="AlCambiarNumero" @bind:event="oninput"
                                   @onblur="() => TocadoNumero = true"
                                   aria-invalid="@((TocadoNumero && ErrorNumero != null).ToString().ToLower())" aria-describedby="errorNumero" />
                            @if (TocadoNumero && ErrorNumero != null)
                            {
                                <div id="errorNumero" class="invalid-feedback d-block">@ErrorNumero</div>
                            }
                        </div>

                        <div class="row">
                            <div class="col-6 mb-3">
                                <label for="fechaExpiracion" class="form-label">Vencimiento (MM/AA)</label>
                                <input id="fechaExpiracion" type="text" inputmode="numeric" autocomplete="cc-exp" maxlength="5"
                                       class="form-control font-monospace @ClaseCampo(TocadoFecha, ErrorFecha)"
                                       placeholder="MM/AA"
                                       @bind:get="FechaExpiracion" @bind:set="AlCambiarFecha" @bind:event="oninput"
                                       @onblur="() => TocadoFecha = true"
                                       aria-invalid="@((TocadoFecha && ErrorFecha != null).ToString().ToLower())" aria-describedby="errorFecha" />
                                @if (TocadoFecha && ErrorFecha != null)
                                {
                                    <div id="errorFecha" class="invalid-feedback d-block">@ErrorFecha</div>
                                }
                            </div>
                            <div class="col-6 mb-3">
                                <label for="cvc" class="form-label">
                                    CVV
                                    <IconoInfo Texto="Son los 3 dígitos que aparecen en el reverso de la tarjeta." />
                                </label>
                                <input id="cvc" type="password" inputmode="numeric" autocomplete="cc-csc" maxlength="3"
                                       class="form-control font-monospace @ClaseCampo(TocadoCvc, ErrorCvc)"
                                       placeholder="123"
                                       @bind:get="Cvc" @bind:set="AlCambiarCvc" @bind:event="oninput"
                                       @onblur="() => TocadoCvc = true"
                                       aria-invalid="@((TocadoCvc && ErrorCvc != null).ToString().ToLower())" aria-describedby="errorCvc" />
                                @if (TocadoCvc && ErrorCvc != null)
                                {
                                    <div id="errorCvc" class="invalid-feedback d-block">@ErrorCvc</div>
                                }
                            </div>
                        </div>

                        <div class="d-flex flex-column-reverse flex-sm-row justify-content-between gap-2 mt-2">
                            <button type="button" class="btn btn-outline-secondary" disabled="@Enviando" @onclick="() => Paso = 2">
                                <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Volver a la reserva
                            </button>
                            <button type="submit" class="btn btn-success" disabled="@(Enviando || !PuedePagar)">
                                Pagar @CompraClienteMapper.Soles(Reserva.MontoTotal)
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        }

        <ModalConfirmacion Visible="MostrarPagar" Titulo="¿Confirmar pago?" Variante="success" Icono="bi-credit-card"
                           TextoConfirmar="Sí, pagar" Procesando="Enviando"
                           OnConfirmar="RegistrarPago" OnCancelar="() => MostrarPagar = false">
            <p class="mb-2">Se registrará el pago de <strong>@CompraClienteMapper.Soles(Reserva.MontoTotal)</strong> para <strong>@Reserva.FuncionNombre</strong>.</p>
            <p class="small text-muted mb-0">Luego un administrador validará el pago para confirmar tus entradas.</p>
        </ModalConfirmacion>

        <ModalConfirmacion Visible="MostrarCancelar" Titulo="¿Cancelar reserva?" Variante="danger" Icono="bi-exclamation-triangle"
                           TextoConfirmar="Sí, cancelar" TextoCancelar="No, mantener" Procesando="Enviando"
                           OnConfirmar="CancelarReserva" OnCancelar="() => MostrarCancelar = false">
            <p class="mb-0">Se liberarán las butacas de la reserva <strong>@Reserva.CodigoOId</strong>. Esta acción no se puede deshacer.</p>
        </ModalConfirmacion>
    }
</div>

@code {
    [Parameter] public int Id {get;set;}
    private ReservaDto? Reserva;
    private PagoDto? Pago;
    private string Error="";
    private string ErrorAccion="";
    private bool Cargando;
    private bool Enviando;
    private bool MostrarPagar;
    private bool MostrarCancelar;
    /// <summary>Etapa del flujo: 2 Reserva, 3 Pago, 4 Confirmación (la 1 es SeleccionButacas).</summary>
    private int Paso=2;
    private double SegundosIniciales;
    private readonly System.Diagnostics.Stopwatch Reloj=new();
    private readonly CancellationTokenSource Cierre=new();
    private Task? Temporizador;
    private double Segundos=>Math.Max(0,SegundosIniciales-Reloj.Elapsed.TotalSeconds);
    private bool PagoRegistrado=>Pago!=null && !string.IsNullOrEmpty(Pago.FechaPago);
    private bool PuedePagar=>Reserva?.Estado=="ACTIVA" && Segundos>0 && Pago?.Estado=="PENDIENTE" && !PagoRegistrado;
    private string TiempoRestante=>TimeSpan.FromSeconds(Segundos).ToString(@"mm\:ss");
    private string TituloPagina=>Paso switch {3=>"Pago",4=>"Confirmación",_=>"Reserva"};
    private string NombreTitular="",NumeroTarjeta="",FechaExpiracion="",Cvc="";
    /// <summary>Entradas emitidas de la reserva; solo existen cuando ya está CONFIRMADA (RF-M5-03).</summary>
    private List<EntradaClienteViewModel> Entradas=[];
    private string AvisoEntradas="";
    /// <summary>Función de precio cero: el backend la confirma y emite sus entradas sin pasar por el pago.</summary>
    private bool Gratuita=>Reserva?.MontoTotal==0;
    protected override Task OnParametersSetAsync() => CargarAsync();
    private async Task CargarAsync()
    {
        Cargando=true;Reserva=null;Pago=null;Entradas=[];Error="";ErrorAccion="";AvisoEntradas="";Paso=2;
        try {
            Reserva=await Api.Obtener(Id);
            SegundosIniciales=Math.Max(0,(Reserva.FechaExpiracion-Reserva.FechaServidor).TotalSeconds);Reloj.Restart();
            if(Reserva.Estado=="ACTIVA" && Segundos>0) {
                // Si el código de pago no se puede generar (por ejemplo, la función dejó de estar disponible),
                // se muestra el motivo sobre la reserva en vez de reemplazar toda la pantalla por un error.
                try { Pago=await Api.GenerarPago(Id); if(PagoRegistrado)Paso=4; }
                catch(ServiceException e) { ErrorAccion=e.Message; }
            }
            else if(Reserva.Estado=="CONFIRMADA") {
                Paso=4;
                try { Entradas=CompraClienteMapper.ToEntradaViewModels(await Api.ListarEntradas(Id),Reserva); }
                catch(ServiceException) { AvisoEntradas="No pudimos cargar tus entradas ahora. Las encontrarás en Mis compras."; }
            }
            Temporizador ??= ActualizarTiempo();
        }catch(Exception e) when(e is HttpRequestException or InvalidOperationException or ServiceException or TaskCanceledException) { Error=e.Message; }
        finally { Cargando=false; }
    }
    private async Task ActualizarTiempo()
    {
        using var timer=new PeriodicTimer(TimeSpan.FromSeconds(1));
        try { while(await timer.WaitForNextTickAsync(Cierre.Token))await InvokeAsync(StateHasChanged); }
        catch(OperationCanceledException) { }
    }
    private void IrAPago() { ErrorAccion="";Paso=3; }
    private void PedirConfirmacionPago()
    {
        // Al intentar pagar se muestran los errores de todos los campos, aunque no se hayan tocado.
        TocadoNombre=TocadoNumero=TocadoFecha=TocadoCvc=true;
        if(PuedePagar && TarjetaValida && !Enviando)MostrarPagar=true;
    }

    // ---------- Validación de la tarjeta (pago simulado: solo se valida en pantalla) ----------
    private bool TocadoNombre,TocadoNumero,TocadoFecha,TocadoCvc;
    private bool TarjetaValida=>ErrorNombre==null && ErrorNumero==null && ErrorFecha==null && ErrorCvc==null;
    private static string ClaseCampo(bool tocado,string? error)=>!tocado ? "" : error==null ? "is-valid" : "is-invalid";
    private static string SoloDigitos(string? texto,int maximo)=>new string((texto??"").Where(char.IsAsciiDigit).Take(maximo).ToArray());

    private void AlCambiarNombre(string? valor)
    {
        // Solo letras (con tildes y ñ), espacios, apóstrofo y guion; en mayúsculas como en la tarjeta.
        string limpio=new string((valor??"").Where(c=>char.IsLetter(c) || c==' ' || c=='\'' || c=='-').ToArray());
        NombreTitular=System.Text.RegularExpressions.Regex.Replace(limpio.TrimStart(),@"\s{2,}"," ").ToUpperInvariant();
    }
    private void AlCambiarNumero(string? valor)
    {
        // Agrupa en bloques de 4: "4111111111111111" -> "4111 1111 1111 1111".
        string digitos=SoloDigitos(valor,16);
        NumeroTarjeta=string.Join(" ",Enumerable.Range(0,(digitos.Length+3)/4).Select(i=>digitos.Substring(i*4,Math.Min(4,digitos.Length-i*4))));
        if(digitos.Length==16)TocadoNumero=true;
    }
    private void AlCambiarFecha(string? valor)
    {
        // Inserta la barra automáticamente: "1228" -> "12/28". Permite borrar sin que la barra estorbe.
        string digitos=SoloDigitos(valor,4);
        if(digitos.Length==1 && digitos[0]>'1')digitos="0"+digitos;
        FechaExpiracion=digitos.Length>2 ? $"{digitos[..2]}/{digitos[2..]}" : digitos;
        if(digitos.Length==4)TocadoFecha=true;
    }
    private void AlCambiarCvc(string? valor)
    {
        Cvc=SoloDigitos(valor,3);
        if(Cvc.Length==3)TocadoCvc=true;
    }

    private string? ErrorNombre
    {
        get
        {
            string nombre=NombreTitular.Trim();
            if(nombre.Length==0)return "Ingresa el nombre del titular.";
            string[] palabras=nombre.Split(' ',StringSplitOptions.RemoveEmptyEntries);
            if(palabras.Length<2 || palabras.Any(p=>p.Count(char.IsLetter)<2))return "Ingresa nombre y apellido tal como aparecen en la tarjeta.";
            return null;
        }
    }
    private string? ErrorNumero
    {
        get
        {
            string digitos=SoloDigitos(NumeroTarjeta,16);
            if(digitos.Length==0)return "Ingresa el número de la tarjeta.";
            if(digitos.Length<16)return $"El número debe tener 16 dígitos (faltan {16-digitos.Length}).";
            if(MarcaTarjeta==null)return "Solo se aceptan tarjetas Visa (empiezan con 4) o Mastercard (empiezan con 51-55 o 2221-2720).";
            if(!CumpleLuhn(digitos))return "El número de tarjeta no es válido. Revisa que lo hayas escrito bien.";
            return null;
        }
    }
    private string? MarcaTarjeta
    {
        get
        {
            string d=SoloDigitos(NumeroTarjeta,16);
            if(d.Length>=1 && d[0]=='4')return "Visa";
            if(d.Length>=2 && int.Parse(d[..2]) is >=51 and <=55)return "Mastercard";
            if(d.Length>=4 && int.Parse(d[..4]) is >=2221 and <=2720)return "Mastercard";
            return null;
        }
    }
    /// <summary>Algoritmo de Luhn: el dígito verificador que usan todas las tarjetas reales.</summary>
    private static bool CumpleLuhn(string digitos)
    {
        int suma=0;
        for(int i=0;i<digitos.Length;i++)
        {
            int d=digitos[digitos.Length-1-i]-'0';
            if(i%2==1){d*=2;if(d>9)d-=9;}
            suma+=d;
        }
        return suma%10==0;
    }
    private string? ErrorFecha
    {
        get
        {
            string digitos=SoloDigitos(FechaExpiracion,4);
            if(digitos.Length==0)return "Ingresa la fecha de vencimiento.";
            if(digitos.Length<4)return "Usa el formato MM/AA, por ejemplo 08/28.";
            int mes=int.Parse(digitos[..2]),anio=2000+int.Parse(digitos[2..]);
            if(mes is <1 or >12)return "El mes debe estar entre 01 y 12.";
            DateTime hoy=DateTime.Today;
            if(anio<hoy.Year || (anio==hoy.Year && mes<hoy.Month))return "La tarjeta está vencida.";
            if(anio>hoy.Year+15)return "La fecha de vencimiento no es válida.";
            return null;
        }
    }
    private string? ErrorCvc=>Cvc.Length switch
    {
        0=>"Ingresa el CVV.",
        <3=>"El CVV debe tener 3 dígitos.",
        _=>null
    };
    private async Task RegistrarPago()
    {
        if(Enviando || !PuedePagar || !TarjetaValida || Pago==null)return;
        Enviando=true;ErrorAccion="";
        try {
            // Pago simulado: nunca se envían ni almacenan tarjeta o CVC.
            await Api.RegistrarPago(Pago.Id);Pago.FechaPago="Registrado";
            Paso=4;
        }catch(Exception e) when(e is HttpRequestException or InvalidOperationException or ServiceException or TaskCanceledException) { ErrorAccion=e.Message; }
        finally { NombreTitular=NumeroTarjeta=FechaExpiracion=Cvc="";TocadoNombre=TocadoNumero=TocadoFecha=TocadoCvc=false;Enviando=false;MostrarPagar=false; }
    }
    private async Task CancelarReserva()
    {
        if(Enviando)return;Enviando=true;ErrorAccion="";
        try {await Api.Cancelar(Id);Nav.NavigateTo("/mis-compras");}
        catch(Exception e) when(e is HttpRequestException or InvalidOperationException or ServiceException or TaskCanceledException) { ErrorAccion=e.Message; }
        finally {Enviando=false;MostrarCancelar=false;}
    }
    public void Dispose(){Cierre.Cancel();Cierre.Dispose();}
}
