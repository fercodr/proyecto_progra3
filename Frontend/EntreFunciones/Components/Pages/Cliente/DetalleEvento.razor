@page "/evento/{Id:int}"
@using System.Globalization
@using EntreFunciones.DTOSS
@using EntreFunciones.Servicios.Rest
@inject NavigationManager Nav
@inject ICatalogoService Catalogo

<PageTitle>@(Evento?.Titulo ?? "Detalle del evento")</PageTitle>

<div class="page-shell">
@if (Cargando)
{
    <div class="text-center my-5" role="status">
        <div class="spinner-border" aria-hidden="true"></div>
        <p class="text-muted mt-2">Cargando evento...</p>
    </div>
}
else if (ErrorCarga is not null)
{
    <div class="alert alert-danger" role="alert">
        No se pudo cargar el evento: @ErrorCarga
        <button type="button" class="btn btn-sm btn-outline-danger ms-2" @onclick="Cargar">Reintentar</button>
    </div>
}
else if (Evento == null)
{
    <div class="alert alert-warning" role="status">
        No se encontró el evento solicitado.
        <a class="alert-link" href="/cartelera">Volver a la cartelera</a>
    </div>
}
else
{
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/cartelera">Cartelera</a></li>
            <li class="breadcrumb-item active">@Evento.Titulo</li>
        </ol>
    </nav>

    <div class="row g-4">
        <div class="col-12 col-md-7">
            @if (Evento.ImagenUrl != null && Evento.ImagenUrl.StartsWith("http"))
            {
                @* Póster guardado en Amazon S3 *@
                <img src="@Evento.ImagenUrl" alt="Póster de @Evento.Titulo" class="rounded mb-3 w-100" style="height:220px; object-fit:cover;" />
            }
            else
            {
                <div class="d-flex align-items-center justify-content-center bg-light rounded mb-3" style="height:220px;">
                    <i class="@IconoTipo(Evento.Tipo) text-secondary" style="font-size:5rem;"></i>
                </div>
            }
            <span class="badge text-bg-secondary mb-2">@TextoTipo(Evento.Tipo)</span>
            <h1 class="page-title mb-2">@Evento.Titulo</h1>
            @if (Evento.DuracionMinutos is not null)
            {
                <p class="text-muted mb-1">@Evento.DuracionMinutos min &middot; @TextoClasificacion(Evento.ClasificacionPorEdad)</p>
            }
            @if (!string.IsNullOrWhiteSpace(EtiquetaSecundaria))
            {
                <p class="mb-1"><strong>@EtiquetaSecundaria</strong>: @ValorSecundario</p>
            }
            <p class="fs-4"><strong>S/ @Evento.Precio.ToString("N2", CultureInfo.InvariantCulture)</strong></p>
        </div>
        <div class="col-12 col-md-5">
            <div class="card">
                <div class="card-body">
                    <h2 class="card-title h5">
                        Funciones disponibles
                        <i class="bi bi-info-circle text-muted" title="Solo se muestran funciones confirmadas o programadas; una función cancelada no aparece aquí."></i>
                    </h2>
                    @if (!Funciones.Any())
                    {
                        <p class="text-muted mb-0">No hay funciones programadas por el momento.</p>
                    }
                    else
                    {
                        <div class="list-group">
                            @foreach (FuncionDTO funcion in Funciones)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <div><strong>@FormatearFecha(funcion.Fecha)</strong> &middot; @FormatearHora(funcion.HoraInicio)</div>
                                        <div class="text-muted small">@funcion.NombreSede &middot; Sala @funcion.NombreSala &middot; @funcion.Idioma</div>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-primary" @onclick="() => ElegirFuncion(funcion.Id)">
                                        Elegir
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private bool Cargando = true;
    private string? ErrorCarga;
    private EventoDTO? Evento;
    private List<FuncionDTO> Funciones = new();

    protected override async Task OnParametersSetAsync()
    {
        await Cargar();
    }

    private async Task Cargar()
    {
        Cargando = true;
        ErrorCarga = null;
        try
        {
            Evento = await Catalogo.ObtenerEvento(Id, completo: true);
            Funciones = (Evento.Funciones ?? new())
                .Where(f => f.Estado != "CANCELADA")
                .OrderBy(f => f.Fecha).ThenBy(f => f.HoraInicio)
                .ToList();
        }
        catch (Exception ex)
        {
            ErrorCarga = ex.Message;
        }
        finally
        {
            Cargando = false;
        }
    }

    private string EtiquetaSecundaria => Evento?.Tipo switch
    {
        "PELICULA" => "Director",
        "OBRA_TEATRO" => "Director",
        "ACTIVIDAD_CULTURAL" => "Expositor",
        _ => ""
    } ?? "";

    private string ValorSecundario => Evento?.Tipo switch
    {
        "PELICULA" => Evento.Director ?? "",
        "OBRA_TEATRO" => Evento.NombreDirector ?? "",
        "ACTIVIDAD_CULTURAL" => Evento.Expositor ?? "",
        _ => ""
    } ?? "";

    // Icono generico por tipo mientras el equipo decide como se van a manejar las imagenes
    // reales de cada evento (ver decisiones-diseno-catalogo-rest.md).
    private string IconoTipo(string tipo) => tipo switch
    {
        "PELICULA" => "bi bi-film",
        "OBRA_TEATRO" => "bi bi-emoji-smile",
        "ACTIVIDAD_CULTURAL" => "bi bi-people",
        _ => "bi bi-calendar-event"
    };

    private string TextoTipo(string tipo) => tipo switch
    {
        "PELICULA" => "Película",
        "OBRA_TEATRO" => "Obra de teatro",
        "ACTIVIDAD_CULTURAL" => "Actividad cultural",
        _ => tipo
    };

    private string TextoClasificacion(string? clasificacion) => clasificacion switch
    {
        "APTA_TODO_PUBLICO" => "Apta para todo público",
        "PG13" => "PG-13",
        "MAYORES_18" => "Solo mayores de 18",
        _ => clasificacion ?? ""
    };

    private string FormatearFecha(string fechaIso) =>
        DateOnly.TryParse(fechaIso, out DateOnly fecha) ? fecha.ToString("dd/MM/yyyy") : fechaIso;

    private string FormatearHora(string horaIso) =>
        TimeOnly.TryParse(horaIso, out TimeOnly hora) ? hora.ToString("HH:mm") : horaIso;

    private void ElegirFuncion(int funcionId)
    {
        Nav.NavigateTo($"/funcion/{funcionId}/butacas");
    }
}
