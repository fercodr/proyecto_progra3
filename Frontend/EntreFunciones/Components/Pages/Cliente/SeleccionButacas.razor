@page "/funcion/{Id:int}/butacas"
@using System.Globalization
@using EntreFunciones.DTOSS
@using EntreFunciones.Mappers
@using EntreFunciones.Servicios.Rest
@inject NavigationManager Nav
@inject ICompraService Api
@attribute [Authorize(Policy = "Compras")]

<PageTitle>Selección de butacas</PageTitle>

<div class="page-shell">
<PasosCompra PasoActual="1" />

@if (Cargando)
{
    <div class="d-flex align-items-center gap-2 text-secondary" role="status" aria-live="polite">
        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
        Cargando disponibilidad de butacas...
    </div>
}
else if (!string.IsNullOrEmpty(Error))
{
    <div class="alert alert-danger" role="alert" aria-live="assertive">
        <h1 class="h5 alert-heading">No pudimos cargar la selección</h1>
        <p>@Error</p>
        <button type="button" class="btn btn-danger btn-sm me-2" @onclick="CargarAsync">Reintentar</button>
        <a class="btn btn-outline-danger btn-sm" href="/cartelera">Volver a la cartelera</a>
    </div>
}
else if (Funcion == null)
{
    <div class="alert alert-warning" role="status" aria-live="polite">
        No se encontró la función solicitada.
        <a class="alert-link" href="/cartelera">Volver a la cartelera</a>
    </div>
}
else
{
    <div class="page-header">
        <div>
            <h1 class="page-title">@Funcion.Titulo</h1>
            <p class="page-description">@Funcion.Sede &middot; Sala @Funcion.Sala &middot; @Funcion.Fecha.ToString("dd/MM/yyyy") &middot; @Funcion.HoraInicio</p>
        </div>
    </div>

    @if (!Funcion.AforoNumerado)
    {
        @* RF-M4-02: funcion de aforo general (ActividadCultural) -> se indica cantidad, no butacas. *@
        <div class="card mb-3 quantity-card">
            <div class="card-body">
                <h2 class="card-title h5">Cantidad de cupos</h2>
                <p class="text-muted">Esta función no tiene butacas numeradas; indica cuántos cupos deseas reservar.</p>
                <label class="form-label" for="cantidadCupos">Número de cupos</label>
                <div class="input-group mb-3 quantity-input">
                    <button type="button" class="btn btn-outline-secondary" aria-label="Disminuir cantidad" @onclick="DecrementarCantidad">−</button>
                    <input id="cantidadCupos" type="number" class="form-control text-center" min="1" max="@Funcion.CuposDisponibles" @bind="Cantidad" @bind:event="oninput" />
                    <button type="button" class="btn btn-outline-secondary" aria-label="Aumentar cantidad" @onclick="IncrementarCantidad">+</button>
                </div>
                <p class="text-muted small mb-0">Cupos disponibles: @Funcion.CuposDisponibles</p>
            </div>
        </div>
    }
    else
    {
        <div class="seat-map card mb-3">
            <div class="card-body">
                <div class="screen mb-3">PANTALLA / ESCENARIO</div>

                <div class="seat-map-scroll">
                    <div class="seat-rows">
                        @foreach (string fila in Filas)
                        {
                            <div class="seat-row">
                                <span class="fila-letra" aria-hidden="true">@fila</span>
                                @foreach (ButacaDto butaca in Butacas.Where(b => b.Fila == fila).OrderBy(b => b.Columna))
                                {
                                    <button type="button" class="butaca @ClaseButaca(butaca)"
                                            aria-label="@DescripcionButaca(butaca)"
                                            aria-pressed="@butaca.Elegida"
                                            disabled="@(!butaca.Activo || butaca.Ocupada || Enviando)"
                                            @onclick="() => ToggleButaca(butaca)">
                                        @butaca.Columna
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-3 mt-3 small text-muted leyenda" aria-label="Leyenda de butacas">
                    <span class="leyenda-item"><span class="muestra libre"></span>Libre</span>
                    <span class="leyenda-item"><span class="muestra ocupada"></span>Ocupada</span>
                    <span class="leyenda-item"><span class="muestra bloqueada"></span>Inactiva</span>
                    <span class="leyenda-item"><span class="muestra elegida"></span>Elegida</span>
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(ErrorAccion))
    {
        <div class="alert alert-danger summary-card" role="alert" aria-live="assertive">@ErrorAccion</div>
    }

    <div class="card summary-card">
        <div class="card-body">
            <h2 class="card-title h5">Resumen</h2>
            @if (Funcion.AforoNumerado)
            {
                <p class="mb-1">Butacas: <strong>@(ButacasElegidasTexto == "" ? "Ninguna" : ButacasElegidasTexto)</strong></p>
            }
            <p class="mb-1">Cantidad: <strong>@CantidadElegida</strong></p>
            <p class="mb-1">Precio unitario: <strong>@CompraClienteMapper.Soles(Funcion.Precio)</strong></p>
            <p class="mb-3">Total: <strong>@CompraClienteMapper.Soles(Total)</strong></p>
            <button type="button" class="btn btn-primary w-100" disabled="@(CantidadElegida <= 0 || Enviando)" @onclick="() => MostrarConfirmacion = true">
                Continuar
            </button>
            <p class="small text-muted mt-2 mb-0">
                Se separarán por 15 minutos
                <IconoInfo Texto="Al continuar se crea tu reserva y las butacas quedan bloqueadas para otros usuarios durante 15 minutos. Si no pagas en ese tiempo, se liberan automáticamente." />
            </p>
        </div>
    </div>

    <ModalConfirmacion Visible="MostrarConfirmacion" Titulo="¿Confirmar reserva?" Icono="bi-ticket-perforated"
                       TextoConfirmar="Sí, reservar" Procesando="Enviando"
                       OnConfirmar="ContinuarAReserva" OnCancelar="() => MostrarConfirmacion = false">
        <p class="mb-2">Vas a reservar para <strong>@Funcion.Titulo</strong>:</p>
        <ul class="mb-2">
            <li>@Funcion.Fecha.ToString("dd/MM/yyyy") &middot; @Funcion.HoraInicio &middot; @Funcion.Sede, sala @Funcion.Sala</li>
            @if (Funcion.AforoNumerado)
            {
                <li>Butacas: @ButacasElegidasTexto</li>
            }
            else
            {
                <li>Cupos: @CantidadElegida</li>
            }
            <li>Total a pagar: <strong>@CompraClienteMapper.Soles(Total)</strong></li>
        </ul>
        <p class="small text-muted mb-0">Tendrás 15 minutos para completar el pago.</p>
    </ModalConfirmacion>
}
</div>

@code {
    [Parameter] public int Id { get; set; }
    private DisponibilidadDto? Funcion;
    private List<ButacaDto> Butacas = [];
    private IEnumerable<string> Filas => Butacas.Select(b=>b.Fila).Distinct().OrderBy(f=>f);
    private int Cantidad = 1;
    private bool Cargando;
    private bool Enviando;
    private string Error = "";
    protected override Task OnParametersSetAsync() => CargarAsync();
    private async Task CargarAsync()
    {
        Cargando=true;
        Error="";Funcion=null;Butacas=[];
        try { Funcion=await Api.Disponibilidad(Id);Butacas=Funcion.Butacas;Cantidad=Math.Min(1,Funcion.CuposDisponibles); }
        catch(Exception e) when(e is HttpRequestException or InvalidOperationException or ServiceException or TaskCanceledException) { Error=e.Message; }
        finally { Cargando=false; }
    }
    private int CantidadElegida => Funcion?.AforoNumerado==true?Butacas.Count(b=>b.Elegida):Cantidad;
    private decimal Total => CantidadElegida * (Funcion?.Precio ?? 0);
    private string ButacasElegidasTexto => string.Join(", ", Butacas.Where(b=>b.Elegida).OrderBy(b=>b.Fila).ThenBy(b=>b.Columna).Select(b=>$"{b.Fila}{b.Columna}"));
    private bool MostrarConfirmacion;
    private string ErrorAccion = "";
    private string ClaseButaca(ButacaDto b)=>!b.Activo?"bloqueada":b.Ocupada?"ocupada":b.Elegida?"elegida":"libre";
    private string DescripcionButaca(ButacaDto b)=>$"Butaca {b.Fila}{b.Columna}: {(!b.Activo?"inactiva":b.Ocupada?"ocupada":b.Elegida?"seleccionada":"libre")}";
    private void ToggleButaca(ButacaDto b) { if(b.Activo && !b.Ocupada && !Enviando)b.Elegida=!b.Elegida; }
    private void IncrementarCantidad() { if(Funcion!=null && Cantidad<Funcion.CuposDisponibles)Cantidad++; }
    private void DecrementarCantidad() { if(Cantidad>1)Cantidad--; }
    private async Task ContinuarAReserva()
    {
        if(Enviando || Funcion==null || CantidadElegida<=0)return;
        Enviando=true;ErrorAccion="";
        try {
            var reserva=await Api.Crear(Id,Butacas.Where(b=>b.Elegida).Select(b=>b.Id).ToArray(),CantidadElegida);
            Nav.NavigateTo($"/reserva/{reserva.Id}/pago");
        } catch(Exception e) when(e is HttpRequestException or InvalidOperationException or ServiceException or TaskCanceledException) { ErrorAccion=e.Message; }
        finally { Enviando=false;MostrarConfirmacion=false; }
    }
}
