@page "/funcion/{Id:int}/butacas"
@using System.Globalization
@inject NavigationManager Nav

<PageTitle>Selección de butacas</PageTitle>

@if (Funcion == null)
{
    <div class="alert alert-warning">
        No se encontró la función solicitada.
        <a href="/cartelera">Volver a la cartelera</a>
    </div>
}
else
{
    <h1 class="mb-1">@Funcion.Titulo</h1>
    <p class="text-muted mb-4">@Funcion.Sede &middot; Sala @Funcion.Sala &middot; @Funcion.Fecha.ToString("dd/MM/yyyy") &middot; @Funcion.HoraInicio.ToString("hh\\:mm")</p>

    @if (!Funcion.AforoNumerado)
    {
        @* RF-M4-02: funcion de aforo general (ActividadCultural) -> se indica cantidad, no butacas. *@
        <div class="card mb-3" style="max-width: 420px;">
            <div class="card-body">
                <h5 class="card-title">Cantidad de cupos</h5>
                <p class="text-muted">Esta función no tiene butacas numeradas; indica cuántos cupos deseas reservar.</p>
                <div class="input-group mb-3" style="max-width: 200px;">
                    <button class="btn btn-outline-secondary" @onclick="DecrementarCantidad">-</button>
                    <input type="number" class="form-control text-center" min="1" max="@Funcion.CuposDisponibles" @bind="Cantidad" @bind:event="oninput" />
                    <button class="btn btn-outline-secondary" @onclick="IncrementarCantidad">+</button>
                </div>
                <p class="text-muted small mb-0">Cupos disponibles: @Funcion.CuposDisponibles</p>
            </div>
        </div>
    }
    else
    {
        <div class="seat-map card mb-3" style="max-width: 560px;">
            <div class="card-body">
                <div class="screen mb-3">PANTALLA / ESCENARIO</div>

                @foreach (string fila in Filas)
                {
                    <div class="d-flex align-items-center mb-1">
                        <span class="fila-letra">@fila</span>
                        @for (int col = 1; col <= ColumnasPorFila; col++)
                        {
                            int columna = col;
                            string filaActual = fila;
                            Butaca butaca = Butacas.First(b => b.Fila == filaActual && b.Columna == columna);
                            <button type="button"
                                    class="butaca @ClaseButaca(butaca)"
                                    disabled="@(butaca.Estado != EstadoButaca.Libre && butaca.Estado != EstadoButaca.Elegida)"
                                    @onclick="() => ToggleButaca(butaca)">
                                @columna
                            </button>
                        }
                    </div>
                }

                <div class="d-flex gap-3 mt-3 small text-muted leyenda">
                    <span class="leyenda-item"><span class="muestra libre"></span>Libre</span>
                    <span class="leyenda-item"><span class="muestra ocupada"></span>Ocupada</span>
                    <span class="leyenda-item"><span class="muestra bloqueada"></span>Bloqueada</span>
                    <span class="leyenda-item"><span class="muestra elegida"></span>Elegida</span>
                </div>
            </div>
        </div>
    }

    <div class="card" style="max-width: 420px;">
        <div class="card-body">
            <h5 class="card-title">Resumen</h5>
            <p class="mb-1">Cantidad: <strong>@CantidadElegida</strong></p>
            <p class="mb-3">Total: <strong>S/ @((CantidadElegida * Funcion.Precio).ToString("N2", CultureInfo.InvariantCulture))</strong></p>
            <button class="btn btn-primary w-100" disabled="@(CantidadElegida == 0)" @onclick="ContinuarAReserva">
                Reservar
            </button>
        </div>
    </div>
}

<style>
    .seat-map .screen {
        text-align: center;
        font-size: 11px;
        letter-spacing: .14em;
        color: #6c757d;
        border-bottom: 3px solid #adb5bd;
        padding-bottom: 6px;
    }
    .fila-letra {
        width: 18px;
        font-size: 12px;
        color: #6c757d;
        flex-shrink: 0;
    }
    .butaca {
        width: 28px;
        height: 26px;
        margin: 2px;
        border: 1px solid #adb5bd;
        border-radius: 4px 4px 7px 7px;
        background: #e9ecef;
        font-size: 10px;
        line-height: 1;
        padding: 0;
    }
    .butaca.libre { background: #e9ecef; }
    .butaca.ocupada { background: #adb5bd; color: #fff; cursor: not-allowed; }
    .butaca.bloqueada {
        background: repeating-linear-gradient(45deg, #ced4da 0 3px, transparent 3px 6px);
        cursor: not-allowed;
    }
    .butaca.elegida { background: #7a1f4b; color: #fff; border-color: #7a1f4b; }
    .leyenda-item { display: flex; align-items: center; gap: 4px; }
    .muestra { display: inline-block; width: 12px; height: 12px; border-radius: 3px; }
    .muestra.libre { background: #e9ecef; border: 1px solid #adb5bd; }
    .muestra.ocupada { background: #adb5bd; }
    .muestra.bloqueada { background: repeating-linear-gradient(45deg, #ced4da 0 2px, transparent 2px 4px); border: 1px solid #adb5bd; }
    .muestra.elegida { background: #7a1f4b; }
</style>

@code {
    [Parameter]
    public int Id { get; set; }

    private const int ColumnasPorFila = 8;
    private readonly string[] Filas = { "A", "B", "C", "D" };

    // RF-M4-02: datos de ejemplo mientras no hay conexion al backend Java.
    // Reemplazar por FuncionBL.findById(Id) y ButacaBL.listarPorSala al integrar.
    private List<FuncionButacas> Funciones = new()
    {
        new FuncionButacas(101, "Interestelar", "Cineplanet Jockey Plaza", "3", DateTime.Today.AddDays(1), new TimeSpan(18, 30, 0), 22.00, true, 0),
        new FuncionButacas(102, "Interestelar", "Cineplanet Jockey Plaza", "3", DateTime.Today.AddDays(1), new TimeSpan(21, 0, 0), 22.00, true, 0),
        new FuncionButacas(103, "Spider-Man: Brand New Day", "Cineplanet Norte", "1", DateTime.Today.AddDays(2), new TimeSpan(20, 0, 0), 18.50, true, 0),
        new FuncionButacas(104, "La Muralla", "Teatro Municipal", "Principal", DateTime.Today.AddDays(3), new TimeSpan(19, 0, 0), 35.00, true, 0),
        new FuncionButacas(105, "Charla: Arte Contemporaneo", "Sede Miraflores", "Auditorio", DateTime.Today.AddDays(2), new TimeSpan(17, 0, 0), 10.00, false, 40),
        new FuncionButacas(106, "Taller de Ceramica", "Sede Barranco", "Taller 1", DateTime.Today.AddDays(4), new TimeSpan(10, 0, 0), 25.00, false, 15),
    };

    private FuncionButacas? Funcion;
    private List<Butaca> Butacas = new();
    private int Cantidad = 1;

    protected override void OnParametersSet()
    {
        Funcion = Funciones.FirstOrDefault(f => f.Id == Id);
        if (Funcion != null && Funcion.AforoNumerado)
        {
            GenerarButacasDeEjemplo();
        }
    }

    private void GenerarButacasDeEjemplo()
    {
        Butacas = new List<Butaca>();
        var ocupadas = new HashSet<(string, int)> { ("A", 3), ("B", 1), ("B", 2), ("C", 5), ("D", 2), ("D", 3), ("D", 8) };
        var bloqueadas = new HashSet<(string, int)> { ("A", 6), ("A", 7) };

        foreach (string fila in Filas)
        {
            for (int columna = 1; columna <= ColumnasPorFila; columna++)
            {
                EstadoButaca estado = EstadoButaca.Libre;
                if (ocupadas.Contains((fila, columna))) estado = EstadoButaca.Ocupada;
                else if (bloqueadas.Contains((fila, columna))) estado = EstadoButaca.Bloqueada;

                Butacas.Add(new Butaca(fila, columna, estado));
            }
        }
    }

    private int CantidadElegida => Funcion != null && Funcion.AforoNumerado
        ? Butacas.Count(b => b.Estado == EstadoButaca.Elegida)
        : Cantidad;

    private string ClaseButaca(Butaca butaca) => butaca.Estado switch
    {
        EstadoButaca.Libre => "libre",
        EstadoButaca.Ocupada => "ocupada",
        EstadoButaca.Bloqueada => "bloqueada",
        EstadoButaca.Elegida => "elegida",
        _ => "libre"
    };

    private void ToggleButaca(Butaca butaca)
    {
        if (butaca.Estado == EstadoButaca.Libre)
        {
            butaca.Estado = EstadoButaca.Elegida;
        }
        else if (butaca.Estado == EstadoButaca.Elegida)
        {
            butaca.Estado = EstadoButaca.Libre;
        }
    }

    private void IncrementarCantidad()
    {
        if (Funcion != null && Cantidad < Funcion.CuposDisponibles)
        {
            Cantidad++;
        }
    }

    private void DecrementarCantidad()
    {
        if (Cantidad > 1)
        {
            Cantidad--;
        }
    }

    private void ContinuarAReserva()
    {
        // RF-M5-01: siguiente pantalla (Reserva y pago) la implementa otro integrante del equipo.
        Nav.NavigateTo($"/reserva/{Id}/pago");
    }

    private enum EstadoButaca { Libre, Ocupada, Bloqueada, Elegida }

    private class Butaca
    {
        public string Fila { get; }
        public int Columna { get; }
        public EstadoButaca Estado { get; set; }

        public Butaca(string fila, int columna, EstadoButaca estado)
        {
            Fila = fila;
            Columna = columna;
            Estado = estado;
        }
    }

    private record FuncionButacas(int Id, string Titulo, string Sede, string Sala, DateTime Fecha, TimeSpan HoraInicio,
        double Precio, bool AforoNumerado, int CuposDisponibles);
}
