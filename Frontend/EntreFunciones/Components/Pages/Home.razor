@page "/"
@* Provisional: según el documento, "/" será la Cartelera (pantalla 04). Reemplazar cuando exista. *@

<PageTitle>Inicio</PageTitle>

<div class="page-shell page-shell-narrow py-4">
<AuthorizeView>
    <Authorized>
        <h1 class="page-title mb-3">Bienvenido, @context.User.Identity?.Name</h1>
        <AuthorizeView Roles="Administrador" Context="admin">
            <p>Use el menú <strong>Seguridad</strong> para gestionar usuarios y roles.</p>
        </AuthorizeView>
    </Authorized>
    <NotAuthorized>
        <h1 class="page-title mb-3">Bienvenido a EntreFunciones</h1>
        <p>Inicie sesión para continuar o regístrese como cliente.</p>
        <div class="d-flex gap-2">
            <a class="btn btn-primary" href="login">Iniciar sesión</a>
            <a class="btn btn-outline-primary" href="registro">Registrarse</a>
        </div>
    </NotAuthorized>
</AuthorizeView>
</div>
