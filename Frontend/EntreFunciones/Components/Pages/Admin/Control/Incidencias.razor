@page "/incidencias"
@using EntreFunciones.DTOSS
@using EntreFunciones.Servicios
@using EntreFunciones.Servicios.Rest
@using EntreFunciones.ViewModels
@using Microsoft.AspNetCore.Components.Forms
@inject IAuditoriaService Auditorias

<PageTitle>Incidencias</PageTitle>

<div class="page-shell">
    <div class="page-header">
        <div>
            <h1 class="page-title">Incidencias</h1>
            <p class="page-description">Registra y consulta las incidencias de cada función.</p>
        </div>

        <button type="button" class="btn btn-primary" @onclick="AbrirNueva">
            Nueva incidencia
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="alert alert-danger" role="alert">@Error</div>
    }
    @if (!string.IsNullOrWhiteSpace(Mensaje))
    {
        <div class="alert alert-success" role="status">@Mensaje</div>
    }

    @if (VistaActual == Vista.Inicio)
    {
        <div class="filter-panel">
            <div class="row g-3">
                <div class="col-12 col-md-3">
                    <label for="buscarId" class="form-label">Buscar por ID</label>
                    <input id="buscarId" type="number" min="1"
                           class="form-control" @bind="BusquedaId" />
                </div>

                <div class="col-12 col-md-5">
                    <label for="buscarDescripcion" class="form-label">Descripción</label>
                    <input id="buscarDescripcion" type="search"
                           class="form-control"
                           placeholder="Ej. dato incorrecto"
                           @bind="DescripcionFiltro" />
                </div>

                <div class="col-12 col-md-4">
                    <label for="filtroEstado" class="form-label">Estado</label>
                    <select id="filtroEstado" class="form-select"
                            @bind="EstadoFiltro">
                        <option value="">Todos</option>
                        <option value="PENDIENTE">Pendiente</option>
                        <option value="EN_PROCESO">En proceso</option>
                        <option value="RESUELTA">Resuelta</option>
                    </select>
                </div>
            </div>

            <div class="d-flex flex-wrap justify-content-end gap-2 mt-3">
                <button type="button" class="btn btn-outline-secondary"
                        @onclick="LimpiarFiltros">
                    Limpiar
                </button>
                <button type="button" class="btn btn-primary"
                        disabled="@Procesando" @onclick="Buscar">
                    Buscar
                </button>
            </div>
        </div>

        @if (ResultadosCargados)
        {
            <div class="data-table-wrapper mb-4">
                <table class="table table-bordered align-middle mb-0">
                    <thead style="--bs-table-bg: #edf2f9;">
                        <tr>
                            <th scope="col">Código</th>
                            <th scope="col">Función</th>
                            <th scope="col">Descripción</th>
                            <th scope="col">Fecha</th>
                            <th scope="col">Responsable</th>
                            <th scope="col">Estado</th>
                            <th scope="col">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Resultados.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="text-center text-secondary py-4">
                                    No se encontraron incidencias.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (AuditoriaViewModel incidencia in Resultados)
                            {
                                <tr>
                                    <th scope="row" class="fw-normal">#@incidencia.Id</th>
                                    <td>@PresentarFuncion(incidencia.Funcion)</td>
                                    <td>@incidencia.Descripcion</td>
                                    <td class="text-nowrap">@incidencia.Fecha.ToString("dd/MM/yyyy, HH:mm")</td>
                                    <td>@incidencia.ResponsablePresentacion</td>
                                    <td>
                                        <span class="badge rounded-pill @ClaseEstado(incidencia.EstadoAuditoria)">
                                            @NombreEstado(incidencia.EstadoAuditoria)
                                        </span>
                                    </td>
                                    <td>
                                        <button type="button"
                                                class="btn btn-outline-primary btn-sm"
                                                @onclick="() => Gestionar(incidencia)">
                                            Gestionar
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    }

    @if (VistaActual == Vista.Nueva)
    {
        <EditForm Model="Nueva" OnValidSubmit="Registrar"
                  FormName="nuevaIncidencia">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <section class="card card-body mb-4">
                <h2 class="fs-4 fw-bold mb-3">Nueva incidencia</h2>

                <div class="mb-3">
                    <label for="nuevaFuncion" class="form-label">Función</label>
                    <select id="nuevaFuncion" class="form-select"
                            @bind="Nueva.FuncionId">
                        <option value="0">Selecciona una función</option>
                        @foreach (FuncionViewModel funcion in Funciones)
                        {
                            <option value="@funcion.Id">@funcion.Presentacion</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label for="nuevaDescripcion" class="form-label">Descripción</label>
                    <textarea id="nuevaDescripcion" class="form-control"
                              rows="3" maxlength="500"
                              placeholder="Describe lo ocurrido..."
                              @bind="Nueva.Descripcion"></textarea>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6">
                        <label for="nuevoResponsable" class="form-label">Responsable</label>
                        <select id="nuevoResponsable" class="form-select"
                                @bind="Nueva.ResponsableId">
                            <option value="0">Selecciona un responsable</option>
                            @foreach (AdministradorViewModel responsable in Responsables)
                            {
                                <option value="@responsable.Id">@responsable.NombreCompleto</option>
                            }
                        </select>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="form-label">Estado inicial</div>
                        <span class="badge rounded-pill text-bg-warning">Pendiente</span>
                    </div>
                </div>

                <p class="small text-secondary mb-0">
                    El código, la fecha y el estado inicial se asignarán en el servidor.
                </p>

                <div class="d-flex flex-wrap justify-content-end gap-2 mt-4">
                    <button type="button" class="btn btn-outline-secondary"
                            @onclick="Volver">Cancelar</button>
                    <button type="submit" class="btn btn-primary"
                            disabled="@Procesando">Registrar incidencia</button>
                </div>
            </section>
        </EditForm>
    }

    @if (VistaActual == Vista.Detalle && Seleccionada is not null)
    {
        <EditForm Model="Atencion" OnValidSubmit="Actualizar"
                  FormName="atenderIncidencia">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <section class="card card-body">
                <h2 class="fs-4 fw-bold mb-3">
                    Atender incidencia #@Seleccionada.Id
                </h2>

                <div class="row g-3">
                    <div class="col-12 col-md-8">
                        <div class="fw-semibold mb-1">Función</div>
                        <p class="mb-0">@PresentarFuncion(Seleccionada.Funcion)</p>
                    </div>

                    <div class="col-12 col-md-4">
                        <div class="fw-semibold mb-1">Fecha de registro</div>
                        <p class="mb-0">@Seleccionada.Fecha.ToString("dd/MM/yyyy, HH:mm")</p>
                    </div>

                    <div class="col-12">
                        <div class="fw-semibold mb-1">Descripción original</div>
                        <p class="mb-0">@Seleccionada.Descripcion</p>
                    </div>

                    <div class="col-12">
                        <div class="fw-semibold mb-1">Responsable registrado</div>
                        <p class="mb-0">
                            @Seleccionada.ResponsablePresentacion
                            @if (Seleccionada.Responsable is not null
                                 && !Seleccionada.Responsable.IsActivo)
                            {
                                <span class="badge text-bg-secondary ms-2">Histórico / inactivo</span>
                            }
                            else if (Seleccionada.Responsable is null)
                            {
                                <span class="badge text-bg-secondary ms-2">Pendiente de vinculación</span>
                            }
                        </p>
                    </div>
                </div>

                <hr class="my-4" />
                <h3 class="fs-5 text-primary mb-3">Atención</h3>

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label for="editarResponsable" class="form-label">Responsable</label>
                        <select id="editarResponsable" class="form-select"
                                @bind="Atencion.ResponsableId">
                            <option value="0">Selecciona un responsable activo</option>
                            @foreach (AdministradorViewModel responsable in Responsables)
                            {
                                <option value="@responsable.Id">@responsable.NombreCompleto</option>
                            }
                        </select>
                    </div>

                    <div class="col-12 col-md-6">
                        <label for="editarEstado" class="form-label">Estado</label>
                        <select id="editarEstado" class="form-select"
                                @bind="Atencion.Estado">
                            <option value="PENDIENTE">Pendiente</option>
                            <option value="EN_PROCESO">En proceso</option>
                            <option value="RESUELTA">Resuelta</option>
                        </select>
                    </div>
                </div>

                <div class="d-flex flex-wrap justify-content-end gap-2 mt-4">
                    <button type="button" class="btn btn-outline-secondary"
                            @onclick="Volver">Cancelar</button>
                    <button type="submit" class="btn btn-primary"
                            disabled="@Procesando">Guardar cambios</button>
                </div>
            </section>
        </EditForm>
    }
</div>

@code {
    private enum Vista
    {
        Inicio,
        Nueva,
        Detalle
    }

    private readonly List<AuditoriaViewModel> Resultados = new();
    private List<AdministradorViewModel> Responsables = new();
    private List<FuncionViewModel> Funciones = new();
    private NuevaAuditoriaFormModel Nueva = new();
    private AtencionAuditoriaFormModel Atencion = new();
    private AuditoriaViewModel? Seleccionada;
    private Vista VistaActual = Vista.Inicio;
    private int? BusquedaId;
    private string DescripcionFiltro = string.Empty;
    private string EstadoFiltro = string.Empty;
    private bool ResultadosCargados;
    private bool Procesando;
    private string Error = string.Empty;
    private string Mensaje = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CargarOpciones();
    }

    private async Task CargarOpciones()
    {
        try
        {
            Task<List<AdministradorViewModel>> responsablesTask =
                Auditorias.FindResponsablesActivos();
            Task<List<FuncionViewModel>> funcionesTask =
                Auditorias.FindFuncionesAsignables();
            await Task.WhenAll(responsablesTask, funcionesTask);
            Responsables = await responsablesTask;
            Funciones = await funcionesTask;
        }
        catch (Exception ex) when (EsErrorDeServicio(ex))
        {
            Error = ex.Message;
        }
    }

    private async Task Buscar()
    {
        LimpiarMensajes();
        Procesando = true;
        try
        {
            Resultados.Clear();
            if (BusquedaId.HasValue && BusquedaId.Value > 0)
            {
                Resultados.Add(await Auditorias.FindById(BusquedaId.Value));
            }
            else
            {
                EstadoAuditoria? estado = string.IsNullOrWhiteSpace(EstadoFiltro)
                    ? null
                    : Enum.Parse<EstadoAuditoria>(EstadoFiltro);
                Resultados.AddRange(await Auditorias.FindAll(
                    DescripcionFiltro,
                    estado));
            }
            ResultadosCargados = true;
        }
        catch (Exception ex) when (EsErrorDeServicio(ex))
        {
            Error = ex.Message;
        }
        finally
        {
            Procesando = false;
        }
    }

    private void AbrirNueva()
    {
        LimpiarMensajes();
        Nueva = new NuevaAuditoriaFormModel();
        VistaActual = Vista.Nueva;
    }

    private async Task Registrar()
    {
        LimpiarMensajes();
        Procesando = true;
        try
        {
            AuditoriaViewModel registrada = await Auditorias.Insert(Nueva);
            Resultados.RemoveAll(item => item.Id == registrada.Id);
            Resultados.Insert(0, registrada);
            ResultadosCargados = true;
            Mensaje = $"Incidencia #{registrada.Id} registrada.";
            VistaActual = Vista.Inicio;
        }
        catch (Exception ex) when (EsErrorDeServicio(ex))
        {
            Error = ex.Message;
        }
        finally
        {
            Procesando = false;
        }
    }

    private void Gestionar(AuditoriaViewModel incidencia)
    {
        LimpiarMensajes();
        Seleccionada = incidencia;
        bool responsableSigueActivo = incidencia.Responsable is not null
            && Responsables.Any(item =>
                item.Id == incidencia.Responsable.Id);
        Atencion = new AtencionAuditoriaFormModel
        {
            ResponsableId = responsableSigueActivo
                ? incidencia.Responsable!.Id
                : 0,
            Estado = incidencia.EstadoAuditoria
        };
        VistaActual = Vista.Detalle;
    }

    private async Task Actualizar()
    {
        if (Seleccionada is null)
        {
            return;
        }

        LimpiarMensajes();
        Procesando = true;
        try
        {
            AuditoriaViewModel actualizada = await Auditorias.Update(
                Seleccionada.Id,
                Atencion);
            int indice = Resultados.FindIndex(item => item.Id == actualizada.Id);
            if (indice >= 0)
            {
                Resultados[indice] = actualizada;
            }
            Seleccionada = actualizada;
            Mensaje = $"Incidencia #{actualizada.Id} actualizada.";
            VistaActual = Vista.Inicio;
        }
        catch (Exception ex) when (EsErrorDeServicio(ex))
        {
            Error = ex.Message;
        }
        finally
        {
            Procesando = false;
        }
    }

    private void Volver()
    {
        LimpiarMensajes();
        VistaActual = Vista.Inicio;
        Seleccionada = null;
    }

    private void LimpiarFiltros()
    {
        BusquedaId = null;
        DescripcionFiltro = string.Empty;
        EstadoFiltro = string.Empty;
    }

    private void LimpiarMensajes()
    {
        Error = string.Empty;
        Mensaje = string.Empty;
    }

    private static string PresentarFuncion(FuncionViewModel? funcion)
    {
        return funcion?.Presentacion ?? "Sin función asociada (histórico)";
    }

    private static string NombreEstado(EstadoAuditoria estado)
    {
        return estado switch
        {
            EstadoAuditoria.PENDIENTE => "Pendiente",
            EstadoAuditoria.EN_PROCESO => "En proceso",
            EstadoAuditoria.RESUELTA => "Resuelta",
            _ => estado.ToString()
        };
    }

    private static string ClaseEstado(EstadoAuditoria estado)
    {
        return estado switch
        {
            EstadoAuditoria.PENDIENTE => "text-bg-warning",
            EstadoAuditoria.EN_PROCESO => "text-bg-info",
            EstadoAuditoria.RESUELTA => "text-bg-success",
            _ => "text-bg-secondary"
        };
    }

    private static bool EsErrorDeServicio(Exception ex)
    {
        return ex is HttpRequestException
            or InvalidOperationException
            or ServiceException
            or TaskCanceledException;
    }
}
