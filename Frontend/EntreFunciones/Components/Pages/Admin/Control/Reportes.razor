@page "/admin" 
@attribute [Authorize(Policy = "Reportes")]
 
@rendermode InteractiveServer

<PageTitle> Reportes | Entre Funciones </PageTitle>


<h1 class="fs-2 fw-bold mb-1">Reportes</h1>

<div class="mx-auto" style="max-width: 1100px">
   
    <div class="d-flex justify-content-between align-items-center ">
        <p class="small text-secondary">
            Resumen @fechaDesde.ToString("dd/MM/yyyy") - @fechaHasta.ToString("dd/MM/yyyy")
        </p>
     </div>

<p class="text-secondary  mb-4">
	Consulta la ocupacion los ingresos y la asistencia de las funciones.
</p>



<div class="overflow-auto mb-4">
    <div class="row flex-nowrap g-3 mx-0">
        <div class="col" style="min-width: 220px">
            <SummeryCard Atribute="Entradas no canceladas"
                         Amount="100" />
        </div>
        <div class="col" style="min-width: 220px">
            <SummeryCard Atribute="Ingresos Validos"
                         Amount="3000" />

        </div>
        <div class="col" style="min-width: 220px">
            <SummeryCard Atribute="Asistentes"
                         Amount="120" />
        </div>
    </div>
</div>

    <div class="overflow-auto mb-4 border rounded p-3" style="background-color: #f3f8ff;">
        <div class="row flex-nowrap g-3 mx-0">
            <div class="col" style="min-width: 220px">
                <div class="card-body">
                    <h5 class="card-title">Sede</h5>
                    <select class="form-select form-select-sm" aria-label="Small select example">
                        <option selected>Todas</option>
                        <option value="1">Norte</option>
                        <option value="2">Centro</option>
                        <option value="3">Sur</option>
                    </select>
                </div>
            </div>
            <div class="col" style="min-width: 220px">
                <div class="card-body">
                    <h5 class="card-title">Sala</h5>
                    <select class="form-select form-select-sm" aria-label="Small select example">
                        <option selected>Todas</option>
                        <option value="1">Sala1</option>
                        <option value="2">Sala2</option>
                        <option value="3">Sala3</option>
                    </select>
                </div>
            </div>

            <div class="col" style="min-width: 220px">
                <div class="card-body">
                    <label class="form-label">Desde</label>
                    <input type="date" id="desde" class="form-control form-control-sm" 
                     
                     @bind="fechaDesde"/>
                    
                </div>
            </div>

            <div class="col" style="min-width: 220px">
                <div class="card-body">
                    <label class="form-label">Hasta</label>
                    <input type="date" id="hasta" class="form-control form-control-sm"
                    
                    @bind="fechaHasta"/>
                </div>
            </div>


        </div>
    </div>
    


    <ul class="nav nav-tabs">
        <li class="nav-item">
            <a class="nav-link @(mostrarOcupacion ? "active" : "")"
               href="admin" @onclick="() => mostrarOcupacion = true"
               @onclick:preventDefault>
                Ocupacion
            </a>
        </li>

        <li class="nav-item">
        <a class="nav-link @(!mostrarOcupacion ? "active" : "")"
               href="admin" @onclick="() => mostrarOcupacion = false"
                    @onclick:preventDefault>
            Ingresos y Entradas
        </a>
         
        </li>

    </ul>

    @if (mostrarOcupacion)
    {
        <label class="form-label"></label>
        <table class="table table-bordered">
            <thead class="table-light">
                <tr>
                    <th scope="col">Evento/Funcion</th>
                    <th scope="col">Sede/Sala</th>
                    <th scope="col">Aforo</th>
                    <th scope="col">Entradas</th>
                    <th scope="col">Ocupacion</th>
                </tr>
            </thead>

            <tbody>
                <tr>
                    <th scope="row" class="fw-normal">Evento A / 20-10, 18:00 </th>
                    <td>Centro / Sala 1</td>
                    <td>100</td>
                    <td>60</td>
                    <td>60 %</td>
                </tr>

                <tr>
                    <th scope="row" class="fw-normal">Evento B / 21-10, 19:30 </th>
                    <td>Centro / Sala 4</td>
                    <td>100</td>
                    <td>20</td>
                    <td>30 %</td>
                </tr>
                <tr>
                    <th scope="row" class="fw-normal">Evento C / 22-10, 15:00 </th>
                    <td>Centro / Sala 2</td>
                    <td>200</td>
                    <td>30</td>
                    <td>50 %</td>
                </tr>
            </tbody>
        </table>
    }else
    {
        <label class="form-label"></label>
        <table class="table table-bordered">
            <thead class="table-light">
                <tr>
                    <th scope="col">Evento/fech</th>
                    <th scope="col">Sede/tipo</th>
                    <th scope="col">Ingresos</th>
                    <th scope="col">Asistentes</th>
                    <th scope="col">Entradas canceladas</th>
                </tr>
            </thead>

            <tbody>
                <tr>
                    <th scope="row" class="fw-normal">Evento A / 20-10 </th>
                    <td>Centro / Pelicula</td>
                    <td>S/1200</td>
                    <td>50</td>
                    <td>0</td>
                </tr>

                <tr>
                    <th scope="row" class="fw-normal">Evento B / 21-10</th>
                    <td>Centro / Obra</td>
                    <td>S/ 800</td>
                    <td>30</td>
                    <td>0</td>
                </tr>
                <tr>
                    <th scope="row" class="fw-normal">Evento C / Actividad cultural </th>
                    <td>Centro / Actividad cultural</td>
                    <td>S/1000</td>
                    <td>40</td>
                    <td>0</td>
                </tr>



            </tbody>
        </table>
    }




       
</div>
@code {
    private bool mostrarOcupacion = false;
    private DateTime fechaDesde = DateTime.Today;
    private DateTime fechaHasta = DateTime.Today;


    
}