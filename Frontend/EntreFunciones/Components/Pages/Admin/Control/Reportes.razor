@page "/admin" 
@attribute [Authorize(Policy = "Reportes")]
 
@rendermode InteractiveServer

<PageTitle>Reportes</PageTitle>

<div class="page-shell">
    <div class="page-header">
        <div>
            <h1 class="page-title">Reportes</h1>
            <p class="page-description">Consulta la ocupación, los ingresos y la asistencia de las funciones.</p>
            <p class="small text-secondary mt-2 mb-0">Resumen del @fechaDesde.ToString("dd/MM/yyyy") al @fechaHasta.ToString("dd/MM/yyyy")</p>
        </div>
    </div>



<div class="overflow-auto mb-4">
    <div class="row flex-nowrap g-3 mx-0">
        <div class="col" style="min-width: 220px">
            <SummeryCard Atribute="Entradas no canceladas"
                         Amount="100" />
        </div>
        <div class="col" style="min-width: 220px">
            <SummeryCard Atribute="Ingresos válidos"
                         Amount="3000" />

        </div>
        <div class="col" style="min-width: 220px">
            <SummeryCard Atribute="Asistentes"
                         Amount="120" />
        </div>
    </div>
</div>

 <!--FILTROS-->
    <div class="filter-panel">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-sm-6 col-lg-3">
                    <label for="sedeReporte" class="form-label">Sede</label>
                    <select id="sedeReporte" class="form-select form-select-sm">
                        <option selected>Todas</option>
                        <option value="1">Norte</option>
                        <option value="2">Centro</option>
                        <option value="3">Sur</option>
                    </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                    <label for="salaReporte" class="form-label">Sala</label>
                    <select id="salaReporte" class="form-select form-select-sm">
                        <option selected>Todas</option>
                        <option value="1">Sala1</option>
                        <option value="2">Sala2</option>
                        <option value="3">Sala3</option>
                    </select>
            </div>

            <div class="col-12 col-sm-6 col-lg-3">
                    <label for="desde" class="form-label">Desde</label>
                    <input type="date" id="desde" class="form-control form-control-sm" 
                     
                     @bind="fechaDesde"/>
                    
            </div>

            <div class="col-12 col-sm-6 col-lg-3">
                    <label for="hasta" class="form-label">Hasta</label>
                    <input type="date" id="hasta" class="form-control form-control-sm"
                    
                    @bind="fechaHasta"/>
            </div>


        </div>
    </div>
    <!----------->

    <!-----TABLA RESULTADO------>

    <ul class="nav nav-tabs" role="tablist" aria-label="Tipos de reporte">
        <li class="nav-item">
            <button type="button" class="nav-link @(mostrarOcupacion ? "active" : "")" role="tab"
                    aria-selected="@mostrarOcupacion" @onclick="() => mostrarOcupacion = true">
                Ocupación
            </button>
        </li>

        <li class="nav-item">
            <button type="button" class="nav-link @(!mostrarOcupacion ? "active" : "")" role="tab"
                    aria-selected="@(!mostrarOcupacion)" @onclick="() => mostrarOcupacion = false">
                Ingresos y entradas
            </button>
         
        </li>

    </ul>

    @if (mostrarOcupacion)
    {
        <div class="data-table-wrapper mt-3">
        <table class="table table-bordered">
            <thead class="table-light">
                <tr>
                    <th scope="col">Evento / Función</th>
                    <th scope="col">Sede/Sala</th>
                    <th scope="col">Aforo</th>
                    <th scope="col">Entradas</th>
                    <th scope="col">Ocupación</th>
                </tr>
            </thead>

            <tbody>
                <tr>
                    <th scope="row" class="fw-normal">Evento A / 20-10, 18:00 </th>
                    <td>Centro / Sala 1</td>
                    <td>100</td>
                    <td>60</td>
                    <td>60 %</td>
                </tr>

                <tr>
                    <th scope="row" class="fw-normal">Evento B / 21-10, 19:30 </th>
                    <td>Centro / Sala 4</td>
                    <td>100</td>
                    <td>20</td>
                    <td>30 %</td>
                </tr>
                <tr>
                    <th scope="row" class="fw-normal">Evento C / 22-10, 15:00 </th>
                    <td>Centro / Sala 2</td>
                    <td>200</td>
                    <td>30</td>
                    <td>50 %</td>
                </tr>
            </tbody>
        </table>
        </div>
    }else
    {
        <div class="data-table-wrapper mt-3">
        <table class="table table-bordered">
            <thead class="table-light">
                <tr>
                    <th scope="col">Evento / fecha</th>
                    <th scope="col">Sede/tipo</th>
                    <th scope="col">Ingresos</th>
                    <th scope="col">Asistentes</th>
                    <th scope="col">Entradas canceladas</th>
                </tr>
            </thead>

            <tbody>
                <tr>
                    <th scope="row" class="fw-normal">Evento A / 20-10 </th>
                    <td>Centro / Película</td>
                    <td>S/1200</td>
                    <td>50</td>
                    <td>0</td>
                </tr>

                <tr>
                    <th scope="row" class="fw-normal">Evento B / 21-10</th>
                    <td>Centro / Obra</td>
                    <td>S/ 800</td>
                    <td>30</td>
                    <td>0</td>
                </tr>
                <tr>
                    <th scope="row" class="fw-normal">Evento C / Actividad cultural </th>
                    <td>Centro / Actividad cultural</td>
                    <td>S/1000</td>
                    <td>40</td>
                    <td>0</td>
                </tr>



            </tbody>
        </table>
        </div>
    }




       
</div>
@code {

    private bool mostrarOcupacion = false;
    private DateTime fechaDesde = DateTime.Today;
    private DateTime fechaHasta = DateTime.Today;

    private void executeFindBySede()
    {

    }
}
