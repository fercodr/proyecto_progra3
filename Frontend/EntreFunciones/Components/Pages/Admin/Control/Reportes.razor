@page "/admin"
@attribute [Authorize(Policy = "Reportes")]
@rendermode InteractiveServer
@using EntreFunciones.ViewModels
@inject IFuncionService FuncionesService
@inject ISedeService SedesService
@inject ISalaService SalasService
@inject IJSRuntime JS

<PageTitle>Reportes</PageTitle>

<div class="page-shell">
    <div class="page-header">
        <div>
            <h1 class="page-title">Reportes</h1>
            <p class="page-description">Consulta la ocupación por entradas vigentes emitidas y los ingresos confirmados de las funciones.</p>
            @if (tieneConsulta)
            {
                <p class="small text-secondary mt-2 mb-0">
                    @ResumenPeriodo
                </p>
            }
        </div>
    </div>

    @if (cargandoCatalogos)
    {
        <div class="alert alert-info" role="status">Cargando catálogos...</div>
    }

    @if (!string.IsNullOrWhiteSpace(errorCatalogos))
    {
        <div class="alert alert-danger" role="alert">@errorCatalogos</div>
    }

    <ul class="nav nav-tabs mb-3" role="tablist" aria-label="Tipos de reporte">
        <li class="nav-item">
            <button type="button" class="nav-link @(mostrarOcupacion ? "active" : "")" role="tab"
                    aria-selected="@mostrarOcupacion" @onclick="() => CambiarReporte(true)">
                Ocupación por entradas
            </button>
        </li>
        <li class="nav-item">
            <button type="button" class="nav-link @(!mostrarOcupacion ? "active" : "")" role="tab"
                    aria-selected="@(!mostrarOcupacion)" @onclick="() => CambiarReporte(false)">
                Ingresos y cancelaciones
            </button>
        </li>
    </ul>

    <div class="filter-panel mb-4">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-sm-6 col-lg-2">
                <label for="sedeReporte" class="form-label">Sede</label>
                <select id="sedeReporte" class="form-select form-select-sm"
                        @bind="sedeSeleccionada" @bind:after="CambiarSede">
                    <option value="">Todas</option>
                    @foreach (SedeViewModel sede in sedes)
                    {
                        <option value="@sede.Id">@sede.RazonSocial</option>
                    }
                </select>
            </div>
            @if (mostrarOcupacion)
            {
                <div class="col-12 col-sm-6 col-lg-2">
                    <label for="salaReporte" class="form-label">Sala</label>
                    <select id="salaReporte" class="form-select form-select-sm"
                            @bind="salaSeleccionada" disabled="@cargandoSalas">
                        <option value="">Todas</option>
                        @foreach (SalaViewModel sala in salas)
                        {
                            <option value="@sala.Id">@sala.Nombre</option>
                        }
                    </select>
                </div>
            }
            else
            {
                <div class="col-12 col-sm-6 col-lg-2">
                    <label for="tipoEventoReporte" class="form-label">Tipo de actividad</label>
                    <select id="tipoEventoReporte" class="form-select form-select-sm"
                            @bind="tipoEventoSeleccionado">
                        <option value="">Todos</option>
                        <option value="PELICULA">Película</option>
                        <option value="OBRA_TEATRO">Obra de teatro</option>
                        <option value="ACTIVIDAD_CULTURAL">Actividad cultural</option>
                    </select>
                </div>
            }
            <div class="col-12 col-sm-6 col-lg-2">
                <label for="desde" class="form-label">Desde (fecha de función)</label>
                <input type="date" id="desde" class="form-control form-control-sm" @bind="fechaDesde" />
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label for="hasta" class="form-label">Hasta (fecha de función)</label>
                <input type="date" id="hasta" class="form-control form-control-sm" @bind="fechaHasta" />
            </div>
            <div class="col-12 col-lg-2 d-grid gap-2">
                <button type="button" class="btn btn-primary btn-sm"
                        @onclick="Consultar" disabled="@(Ocupado)">
                    @(cargandoConsulta ? "Consultando..." : "Consultar")
                </button>
                <button type="button" class="btn btn-outline-primary btn-sm"
                        @onclick="DescargarPdf" disabled="@(Ocupado || !tieneConsulta)">
                    @(descargandoPdf ? "Generando PDF..." : "Descargar PDF")
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm"
                        @onclick="Limpiar" disabled="@(Ocupado)">
                    Limpiar
                </button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorConsulta))
    {
        <div class="alert alert-danger" role="alert">@errorConsulta</div>
    }
    else if (cargandoConsulta)
    {
        <div class="alert alert-info" role="status">Cargando resultados...</div>
    }
    else if (tieneConsulta && resultados.Count == 0)
    {
        <div class="alert alert-secondary" role="status">No hay funciones para los filtros seleccionados.</div>
    }

    @if (tieneConsulta && string.IsNullOrWhiteSpace(errorConsulta))
    {
        <div class="overflow-auto mb-4">
            <div class="row flex-nowrap g-3 mx-0">
                @if (mostrarOcupacion)
                {
                    <div class="col" style="min-width: 220px">
                        <SummeryCard Atribute="Funciones" Amount="@resultados.Count" Unit="funciones" />
                    </div>
                    <div class="col" style="min-width: 220px">
                        <SummeryCard Atribute="Entradas vigentes emitidas"
                                     Amount="@TotalEntradasVigentes" Unit="entradas" />
                    </div>
                }
                else
                {
                    <div class="col" style="min-width: 220px">
                        <SummeryCard Atribute="Ingresos confirmados" Amount="@TotalIngresos" Unit="S/" />
                    </div>
                    <div class="col" style="min-width: 220px">
                        <SummeryCard Atribute="Entradas emitidas" Amount="@TotalEntradasEmitidas" Unit="entradas" />
                    </div>
                    <div class="col" style="min-width: 220px">
                        <SummeryCard Atribute="Entradas canceladas" Amount="@TotalEntradasCanceladas" Unit="entradas" />
                    </div>
                }
            </div>
        </div>

        @if (resultados.Count > 0)
        {
            @if (mostrarOcupacion)
            {
                <div class="data-table-wrapper">
                    <table class="table table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th>Evento / Función</th>
                                <th>Sede / Sala</th>
                                <th>Aforo</th>
                                <th>Entradas vigentes emitidas</th>
                                <th>Ocupación</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (FuncionViewModel funcion in resultados)
                            {
                                <tr>
                                    <th scope="row" class="fw-normal">@TituloFuncion(funcion)</th>
                                    <td>@UbicacionFuncion(funcion)</td>
                                    <td>@funcion.Aforo</td>
                                    <td>@(funcion.EntradasVigentes?.ToString() ?? "0")</td>
                                    <td>@Porcentaje(funcion)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="data-table-wrapper">
                    <table class="table table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th>Evento / fecha</th>
                                <th>Sede / tipo</th>
                                <th>Ingresos confirmados</th>
                                <th>Entradas emitidas</th>
                                <th>Entradas canceladas</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (FuncionViewModel funcion in resultados)
                            {
                                <tr>
                                    <th scope="row" class="fw-normal">@TituloFecha(funcion)</th>
                                    <td>@TipoSede(funcion)</td>
                                    <td>S/ @((funcion.IngresosConfirmados ?? 0m).ToString("N2"))</td>
                                    <td>@(funcion.EntradasEmitidas?.ToString() ?? "0")</td>
                                    <td>@(funcion.EntradasCanceladas?.ToString() ?? "0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    }
</div>

@code {
    private DateOnly? fechaDesde;
    private DateOnly? fechaHasta;
    private DateOnly? periodoDesde;
    private DateOnly? periodoHasta;
    private int? sedeSeleccionada;
    private int? salaSeleccionada;
    private string tipoEventoSeleccionado = string.Empty;
    private List<SedeViewModel> sedes = new();
    private List<SalaViewModel> salas = new();
    private List<FuncionViewModel> resultados = new();
    private bool mostrarOcupacion = true;
    private bool cargandoConsulta;
    private bool cargandoCatalogos;
    private bool cargandoSalas;
    private bool descargandoPdf;
    private bool tieneConsulta;
    private string? errorCatalogos;
    private string? errorConsulta;
    private bool Ocupado => cargandoConsulta || cargandoSalas
        || cargandoCatalogos || descargandoPdf;

    private decimal TotalIngresos => resultados.Sum(x => x.IngresosConfirmados ?? 0m);
    private int TotalEntradasVigentes => resultados.Sum(x => x.EntradasVigentes ?? 0);
    private int TotalEntradasEmitidas => resultados.Sum(x => x.EntradasEmitidas ?? 0);
    private int TotalEntradasCanceladas => resultados.Sum(x => x.EntradasCanceladas ?? 0);
    private string ResumenPeriodo => (periodoDesde, periodoHasta) switch
    {
        (null, null) => "Todo el periodo",
        (DateOnly desde, null) => $"Desde el {desde:dd/MM/yyyy}",
        (null, DateOnly hasta) => $"Hasta el {hasta:dd/MM/yyyy}",
        (DateOnly desde, DateOnly hasta) => $"Del {desde:dd/MM/yyyy} al {hasta:dd/MM/yyyy}"
    };

    protected override async Task OnInitializedAsync()
    {
        errorCatalogos = null;
        cargandoCatalogos = true;
        try
        {
            sedes = await SedesService.FindAll();
            salas = await SalasService.FindAll();
            await Consultar();
        }
        catch (Exception ex)
        {
            errorCatalogos = ex.Message;
        }
        finally
        {
            cargandoCatalogos = false;
        }
    }

    private async Task CambiarSede()
    {
        salaSeleccionada = null;
        errorCatalogos = null;
        cargandoSalas = true;
        try
        {
            salas = sedeSeleccionada.HasValue
                ? await SalasService.FindBySede(sedeSeleccionada.Value)
                : await SalasService.FindAll();
        }
        catch (Exception ex)
        {
            errorCatalogos = ex.Message;
            salas = new List<SalaViewModel>();
        }
        finally
        {
            cargandoSalas = false;
        }
    }

    private async Task Consultar()
    {
        if (cargandoConsulta)
        {
            return;
        }
        errorConsulta = null;
        if (fechaDesde.HasValue && fechaHasta.HasValue
            && fechaDesde.Value > fechaHasta.Value)
        {
            resultados = new List<FuncionViewModel>();
            tieneConsulta = false;
            errorConsulta = "La fecha desde no puede ser posterior a hasta.";
            return;
        }

        cargandoConsulta = true;
        resultados = new List<FuncionViewModel>();
        tieneConsulta = false;
        try
        {
            List<FuncionViewModel> respuesta = await FuncionesService.FindReportes(
                fechaDesde,
                fechaHasta,
                sedeSeleccionada,
                mostrarOcupacion ? salaSeleccionada : null,
                mostrarOcupacion || string.IsNullOrWhiteSpace(tipoEventoSeleccionado)
                    ? null
                    : tipoEventoSeleccionado);
            resultados = respuesta;
            periodoDesde = fechaDesde;
            periodoHasta = fechaHasta;
            tieneConsulta = true;
        }
        catch (Exception ex)
        {
            errorConsulta = ex.Message;
        }
        finally
        {
            cargandoConsulta = false;
        }
    }

    private async Task Limpiar()
    {
        if (cargandoConsulta || cargandoSalas || cargandoCatalogos)
        {
            return;
        }

        fechaDesde = null;
        fechaHasta = null;
        sedeSeleccionada = null;
        salaSeleccionada = null;
        tipoEventoSeleccionado = string.Empty;
        await CambiarSede();
        await Consultar();
    }

    private async Task DescargarPdf()
    {
        if (Ocupado || !tieneConsulta)
        {
            return;
        }

        errorConsulta = null;
        descargandoPdf = true;
        try
        {
            // Actualiza primero la tabla con los mismos filtros que recibirá el PDF.
            await Consultar();
            if (!tieneConsulta || !string.IsNullOrWhiteSpace(errorConsulta))
            {
                return;
            }

            byte[] contenido;
            string nombre;
            if (mostrarOcupacion)
            {
                contenido = await FuncionesService.DescargarReporteOcupacion(
                    fechaDesde, fechaHasta, sedeSeleccionada, salaSeleccionada);
                nombre = "reporte-ocupacion-funciones.pdf";
            }
            else
            {
                contenido = await FuncionesService.DescargarReporteIngresos(
                    fechaDesde,
                    fechaHasta,
                    sedeSeleccionada,
                    string.IsNullOrWhiteSpace(tipoEventoSeleccionado)
                        ? null
                        : tipoEventoSeleccionado);
                nombre = "reporte-ingresos-cancelaciones.pdf";
            }

            using DotNetStreamReference referencia = new(
                new MemoryStream(contenido));
            await JS.InvokeVoidAsync(
                "entreFunciones.descargarStream",
                nombre,
                "application/pdf",
                referencia);
        }
        catch (Exception ex)
        {
            errorConsulta = ex.Message;
        }
        finally
        {
            descargandoPdf = false;
        }
    }

    private async Task CambiarReporte(bool ocupacion)
    {
        if (mostrarOcupacion == ocupacion)
        {
            return;
        }
        mostrarOcupacion = ocupacion;
        await Consultar();
    }

    private static string TituloFuncion(FuncionViewModel funcion)
        => $"{funcion.Evento?.Titulo ?? funcion.Titulo} / {funcion.Fecha:dd/MM}, {funcion.HoraInicio:HH\\:mm}-{funcion.HoraFin:HH\\:mm}";

    private static string TituloFecha(FuncionViewModel funcion)
        => $"{funcion.Evento?.Titulo ?? funcion.Titulo} / {funcion.Fecha:dd/MM/yyyy}";

    private static string UbicacionFuncion(FuncionViewModel funcion)
        => $"{funcion.SedeRelacionada?.RazonSocial ?? funcion.Sede} / {funcion.SalaRelacionada?.Nombre ?? funcion.Sala}";

    private static string TipoSede(FuncionViewModel funcion)
        => $"{funcion.SedeRelacionada?.RazonSocial ?? funcion.Sede} / {funcion.Evento?.Tipo ?? "No disponible"}";

    private static string Porcentaje(FuncionViewModel funcion)
        => funcion.PorcentajeOcupacion is null ? "No disponible" : $"{funcion.PorcentajeOcupacion:N2} %";
}
