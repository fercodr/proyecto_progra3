@page "/admin/ventas"
@attribute [Authorize(Policy = "Ventas")]
@rendermode InteractiveServer
@inject ICompraService Api
@using EntreFunciones.DTOSS
@using EntreFunciones.Servicios.Rest
@using EntreFunciones.Servicios.Impl
@using Microsoft.AspNetCore.Components.QuickGrid
@using EntreFunciones.ViewModels
@using EntreFunciones.Seguridad

<PageTitle>Ventas</PageTitle>

<div class="page-shell">
    @if (Cargando)
    {
        <div class="d-flex align-items-center gap-2 text-secondary" role="status" aria-live="polite">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            Cargando reservas y pagos...
        </div>
    }
    else if (!string.IsNullOrEmpty(Error))
    {
        <div class="alert alert-danger" role="alert" aria-live="assertive">
            <h1 class="h5 alert-heading">No pudimos cargar Ventas</h1>
            <p>@Error</p>
            <button type="button" class="btn btn-danger btn-sm" @onclick="Cargar">Reintentar</button>
        </div>
    }
    else
    {
    <!-- Encabezado -->
    <div class="page-header">
        <div>
            <h1 class="page-title">Ventas</h1>
            <p class="page-description">Consulta las reservas y gestiona los pagos de las funciones.</p>
        </div>
    </div>

    <!-- Pestañas -->
    <ul class="nav nav-tabs mb-4" role="tablist" aria-label="Secciones de Ventas">
        <li class="nav-item">
            <button type="button" class="nav-link @(PestanaActiva == "reservas" ? "active" : "")" role="tab" aria-selected="@(PestanaActiva == "reservas")" @onclick='() => PestanaActiva = "reservas"'>
                Reservas
            </button>
        </li>
        <li class="nav-item">
            <button type="button" class="nav-link @(PestanaActiva == "pagos" ? "active" : "")" role="tab" aria-selected="@(PestanaActiva == "pagos")" @onclick='() => PestanaActiva = "pagos"'>
                Pagos
            </button>
        </li>
    </ul>

    <!-- SECCIÓN: RESERVAS -->
    @if (PestanaActiva == "reservas")
    {
        <section class="mb-5">

            <h2 class="fs-5 mb-3">Reservas</h2>

            <!-- Filtros -->
            <div class="filter-panel">

                <div class="row g-3">

                    <div class="col-md-6 col-lg-3">
                        <label for="funcion" class="form-label">Función</label>
                        <select id="funcion" class="form-select" @bind="FiltroFuncion">
                            <option value="">Todas</option>
                            @foreach (string funcion in Reservas.Select(r=>r.Funcion).Distinct())
                            {
                                <option value="@funcion">@funcion</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6 col-lg-3">
                        <label for="cliente" class="form-label">Cliente</label>
                        <input type="text" id="cliente" class="form-control" placeholder="Nombre o DNI" @bind="FiltroCliente" @bind:event="oninput" />
                    </div>

                    <div class="col-md-6 col-lg-3">
                        <label for="estadoReserva" class="form-label">Estado</label>
                        <select id="estadoReserva" class="form-select" @bind="FiltroEstadoReserva">
                            <option value="">Todos</option>
                            @foreach (string estado in new[] { "Pendiente", "Confirmada", "Expirada", "Cancelada" })
                            {
                                <option value="@estado">@estado</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6 col-lg-3">
                        <label for="expiracion" class="form-label">Expiración</label>
                        <select id="expiracion" class="form-select" @bind="FiltroExpiracion">
                            <option value="">Todas</option>
                            <option value="NoVencido">Plazo no vencido</option>
                            <option value="Vencido">Plazo vencido</option>
                        </select>
                    </div>

                </div>

                <div class="d-flex justify-content-end gap-2 mt-3">
                    <button type="button" class="btn btn-outline-secondary" @onclick="LimpiarFiltrosReservas">
                        Limpiar
                    </button>
                    <button type="button" class="btn btn-primary" @onclick="FiltrarReservas">
                        Filtrar
                    </button>
                </div>

            </div>

            @if (!ReservasFiltradas.Any())
            {
                <p class="empty-state">
                    No se encontraron reservas con los filtros seleccionados.
                </p>
            }
            else
            {
                <div class="data-table-wrapper">
                    <QuickGrid Items="ReservasFiltradas" Pagination="PaginacionReservas" Class="table table-bordered align-middle">
                        <PropertyColumn Title="Reserva" Property="r => r.Codigo" Sortable="true" />
                        <TemplateColumn Title="Cliente">
                            @context.Cliente
                            <div class="small text-secondary">DNI: @context.Dni</div>
                        </TemplateColumn>
                        <TemplateColumn Title="Función">
                            @context.Funcion
                            <div class="small text-secondary">@context.FechaFuncion</div>
                        </TemplateColumn>
                        <PropertyColumn Title="Cantidad" Property="r => r.Cantidad" Align="Align.Center" Sortable="true" />
                        <PropertyColumn Title="Expira" Property="r => r.Expira" Sortable="true" />
                        <TemplateColumn Title="Estado">
                            <span class="badge @ClaseBadgeReserva(context.Estado)">@context.Estado</span>
                        </TemplateColumn>
                    </QuickGrid>
                    <Paginator State="PaginacionReservas"></Paginator>
                </div>
            }

        </section>
    }

    <!-- SECCIÓN: PAGOS -->
    @if (PestanaActiva == "pagos")
    {
        <section>

            <h2 class="fs-5 mb-3">Pagos</h2>

            <!-- Filtros -->
            <div class="filter-panel">

                <div class="row g-3 align-items-end">

                    <div class="col-md-5">
                        <label for="codigoPago" class="form-label">Código de pago</label>
                        <input type="text" id="codigoPago" class="form-control" placeholder="Ej.: PAG-001" @bind="FiltroCodigoPago" @bind:event="oninput" />
                    </div>

                    <div class="col-md-3">
                        <div class="form-check mb-2">
                            <input type="checkbox" id="soloPendientes" class="form-check-input" @bind="SoloPendientes" />
                            <label for="soloPendientes" class="form-check-label">Solo pendientes</label>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-outline-secondary" @onclick="LimpiarFiltrosPagos">
                                Limpiar
                            </button>
                            <button type="button" class="btn btn-primary" disabled="@BuscandoPago" @onclick="BuscarPagos">
                                @(BuscandoPago ? "Buscando..." : "Buscar")
                            </button>
                        </div>
                    </div>

                </div>
            </div>

            @if (!PagosFiltrados.Any())
            {
                <p class="empty-state">
                    No se encontraron pagos con los filtros seleccionados.
                </p>
            }
            else
            {
                <div class="data-table-wrapper">
                    <QuickGrid Items="PagosFiltrados" Pagination="PaginacionPagos" Class="table table-bordered align-middle">
                        <PropertyColumn Title="Código de pago" Property="p => p.Codigo" Sortable="true" />
                        <TemplateColumn Title="Reserva / Cliente">
                            @context.Reserva
                            <div class="small text-secondary">@context.Cliente</div>
                        </TemplateColumn>
                        <TemplateColumn Title="Monto" Align="Align.End">
                            <span class="text-nowrap">S/ @context.Monto.ToString("F2")</span>
                        </TemplateColumn>
                        <PropertyColumn Title="Fecha de pago" Property="p => p.FechaPago" Sortable="true" />
                        <TemplateColumn Title="Estado">
                            <span class="badge @ClaseBadgePago(context.Estado)">@context.Estado</span>
                        </TemplateColumn>
                        <TemplateColumn Title="Acciones">
                            @if (context.Estado == "Pendiente")
                            {
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-success btn-sm" @onclick="() => ValidarPago(context.Codigo)">
                                        Validar
                                    </button>
                                    <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => RechazarPago(context.Codigo)">
                                        Rechazar
                                    </button>
                                </div>
                            }
                            else
                            {
                                <span class="text-secondary">Sin acciones</span>
                            }
                        </TemplateColumn>
                    </QuickGrid>
                    <Paginator State="PaginacionPagos"></Paginator>
                </div>
            }

            @if (!string.IsNullOrEmpty(PagoAConfirmar))
            {
                <div class="card border-primary mt-4">
                    <div class="card-body">
                        <h3 class="fs-5 card-title">Confirmar operación</h3>
                        <p class="card-text">
                            @MensajeConfirmacion
                        </p>
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-outline-secondary" @onclick="CancelarConfirmacion">
                                Cancelar
                            </button>
                            <button type="button" class="btn btn-primary" disabled="@Enviando" @onclick="ConfirmarOperacion">
                                Confirmar
                            </button>
                        </div>
                    </div>
                </div>
            }

        </section>
    }
    }

</div>

@code {
    // RF-M5-02 / RF-M5-03: consumo REST; las reglas viven en Java.
    private string PestanaActiva = "reservas";

    // --- Reservas ---
    private string FiltroFuncion = string.Empty;
    private string FiltroCliente = string.Empty;
    private string FiltroEstadoReserva = string.Empty;
    private string FiltroExpiracion = string.Empty;
    private PaginationState PaginacionReservas { get; } = new() { ItemsPerPage = 5 };

    private IQueryable<ReservaVentaViewModel> ReservasFiltradas { get; set; } = Enumerable.Empty<ReservaVentaViewModel>().AsQueryable();

    // --- Pagos ---
    private string FiltroCodigoPago = string.Empty;
    private bool SoloPendientes;
    private PaginationState PaginacionPagos { get; } = new() { ItemsPerPage = 5 };

    private IQueryable<PagoVentaViewModel> PagosFiltrados { get; set; } = Enumerable.Empty<PagoVentaViewModel>().AsQueryable();

    private string PagoAConfirmar = string.Empty;
    private string MensajeConfirmacion = string.Empty;

    private List<ReservaVentaViewModel> Reservas=[];
    private List<PagoVentaViewModel> Pagos=[];
    private List<PagoDto> PagosApi=[];
    private List<ReservaDto> ReservasApi=[];
    private bool RechazarOperacion,Enviando,Cargando,BuscandoPago;
    private string Error="";
    protected override async Task OnInitializedAsync() { await Cargar(); }
    private async Task Cargar()
    {
        Cargando=true;Error="";
        try {
            ReservasApi=await Api.ListarReservas();PagosApi=await Api.ListarPagos();
            Reservas=ReservasApi.Select(r=>new ReservaVentaViewModel {Codigo=r.CodigoOId,Cliente=r.Cliente,Dni=r.Dni,Funcion=r.FuncionNombre,FechaFuncion=r.FechaFuncion.ToString("dd/MM/yyyy HH:mm"),Cantidad=r.Cantidad,Expira=r.FechaExpiracion.ToString("dd/MM/yyyy HH:mm"),Estado=EstadoReserva(r.Estado)}).ToList();
            Pagos=PagosApi.Select(p=>new PagoVentaViewModel {Codigo=p.CodigoPago,Reserva=$"RES-{p.ReservaId}",Cliente=p.Cliente,Monto=p.Monto,FechaPago=p.FechaPago,Estado=p.Estado=="PENDIENTE"?"Pendiente":p.Estado=="VALIDADO"?"Validado":"Rechazado"}).ToList();
            FiltrarReservas();MostrarPagosCargados();
        } catch(Exception e) when(e is HttpRequestException or InvalidOperationException or ServiceException or TaskCanceledException) {Error=e.Message;}
        finally { Cargando=false; }
    }
    private static string EstadoReserva(string e)=>e switch {"ACTIVA"=>"Pendiente","CONFIRMADA"=>"Confirmada","EXPIRADA"=>"Expirada",_=>"Cancelada"};

    private void FiltrarReservas()
    {
        ReservasFiltradas = Reservas
            .Where(r => string.IsNullOrEmpty(FiltroFuncion) || r.Funcion == FiltroFuncion)
            .Where(r => string.IsNullOrEmpty(FiltroCliente)
                || r.Cliente.Contains(FiltroCliente, StringComparison.OrdinalIgnoreCase)
                || r.Dni.Contains(FiltroCliente, StringComparison.OrdinalIgnoreCase))
            .Where(r => string.IsNullOrEmpty(FiltroEstadoReserva) || r.Estado == FiltroEstadoReserva)
            .Where(r => string.IsNullOrEmpty(FiltroExpiracion) || ReservasApi.Any(a=>a.CodigoOId==r.Codigo && (FiltroExpiracion=="Vencido"?a.FechaExpiracion<=a.FechaServidor:a.FechaExpiracion>a.FechaServidor)))
            .AsQueryable();
    }

    private void LimpiarFiltrosReservas()
    {
        FiltroFuncion = string.Empty;
        FiltroCliente = string.Empty;
        FiltroEstadoReserva = string.Empty;
        FiltroExpiracion = string.Empty;
        ReservasFiltradas = Reservas.AsQueryable();
    }

    private void MostrarPagosCargados()
    {
        PagosFiltrados = Pagos
            .Where(p => !SoloPendientes || p.Estado == "Pendiente")
            .AsQueryable();
    }

    private async Task BuscarPagos()
    {
        Error = string.Empty;
        if (string.IsNullOrWhiteSpace(FiltroCodigoPago))
        {
            MostrarPagosCargados();
            return;
        }

        BuscandoPago = true;
        try
        {
            PagoDto encontrado = await Api.BuscarPagoPorCodigo(FiltroCodigoPago);
            PagoVentaViewModel pago = MapearPago(encontrado);
            PagosFiltrados = (!SoloPendientes || pago.Estado == "Pendiente")
                ? new[] { pago }.AsQueryable()
                : Enumerable.Empty<PagoVentaViewModel>().AsQueryable();
        }
        catch (ServiceException ex) when (ex.StatusCode == 404)
        {
            PagosFiltrados = Enumerable.Empty<PagoVentaViewModel>().AsQueryable();
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException
                or ArgumentException or ServiceException or TaskCanceledException)
        {
            Error = ex.Message;
            PagosFiltrados = Enumerable.Empty<PagoVentaViewModel>().AsQueryable();
        }
        finally
        {
            BuscandoPago = false;
        }
    }

    private static PagoVentaViewModel MapearPago(PagoDto p) => new()
    {
        Codigo = p.CodigoPago,
        Reserva = $"RES-{p.ReservaId}",
        Cliente = p.Cliente,
        Monto = p.Monto,
        FechaPago = p.FechaPago,
        Estado = p.Estado == "PENDIENTE" ? "Pendiente"
            : p.Estado == "VALIDADO" ? "Validado" : "Rechazado"
    };

    private void LimpiarFiltrosPagos()
    {
        FiltroCodigoPago = string.Empty;
        SoloPendientes = false;
        MostrarPagosCargados();
    }

    private string ClaseBadgeReserva(string estado) => estado switch
    {
        "Pendiente" => "bg-warning text-dark",
        "Confirmada" => "bg-success",
        "Expirada" => "bg-secondary",
        "Cancelada" => "bg-danger",
        _ => "bg-secondary"
    };

    private string ClaseBadgePago(string estado) => estado switch
    {
        "Pendiente" => "bg-warning text-dark",
        "Validado" => "bg-success",
        "Rechazado" => "bg-danger",
        _ => "bg-secondary"
    };

    private void ValidarPago(string codigo)
    {
        RechazarOperacion=false;
        PagoAConfirmar = codigo;
        PagoVentaViewModel? pago = Pagos.FirstOrDefault(p => p.Codigo == codigo);
        MensajeConfirmacion = pago == null
            ? string.Empty
            : $"¿Deseas validar el pago {pago.Codigo} de {pago.Cliente} por S/ {pago.Monto:F2}?";
    }

    private void RechazarPago(string codigo)
    {
        RechazarOperacion=true;
        PagoAConfirmar = codigo;
        PagoVentaViewModel? pago = Pagos.FirstOrDefault(p => p.Codigo == codigo);
        MensajeConfirmacion = pago == null
            ? string.Empty
            : $"¿Deseas rechazar el pago {pago.Codigo} de {pago.Cliente} por S/ {pago.Monto:F2}?";
    }

    private void CancelarConfirmacion()
    {
        PagoAConfirmar = string.Empty;
        MensajeConfirmacion = string.Empty;
    }

    private async Task ConfirmarOperacion()
    {
        if(Enviando)return;Enviando=true;Error="";
        try {
            var pago=PagosApi.Single(p=>p.CodigoPago==PagoAConfirmar);
            if(RechazarOperacion)await Api.Rechazar(pago.Id);else await Api.Validar(pago.Id);
            CancelarConfirmacion();await Cargar();
        }catch(Exception e) when(e is HttpRequestException or InvalidOperationException or ServiceException or TaskCanceledException) {Error=e.Message;}
        finally {Enviando=false;}
    }
}
