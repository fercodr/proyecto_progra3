@page "/admin/validar-ingreso"
@attribute [Authorize(Policy = "Ventas")]
@rendermode InteractiveServer
@inject ICompraService Api
@using EntreFunciones.DTOSS
@using EntreFunciones.Servicios.Rest

<PageTitle>Validación de ingreso</PageTitle>

<div class="page-shell">
    <div class="page-header">
        <div>
            <h1 class="page-title">Validación de ingreso</h1>
            <p class="page-description">Busca la reserva del cliente y valida o rechaza sus entradas en la puerta.</p>
        </div>
    </div>

    @if (Cargando)
    {
        <div class="d-flex align-items-center gap-2 text-secondary" role="status" aria-live="polite">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            Cargando reservas...
        </div>
    }
    else if (!string.IsNullOrEmpty(Error))
    {
        <div class="alert alert-danger" role="alert" aria-live="assertive">
            <h2 class="h5 alert-heading">No pudimos cargar las reservas</h2>
            <p>@Error</p>
            <button type="button" class="btn btn-danger btn-sm" @onclick="CargarAsync">Reintentar</button>
        </div>
    }
    else
    {
        <div class="filter-panel mb-3">
            <label for="buscar" class="form-label">Buscar por código de reserva, cliente o DNI</label>
            <input type="text" id="buscar" class="form-control" placeholder="Ej.: RES-42, Juan Pérez, 71122334"
                   @bind="Busqueda" @bind:event="oninput" />
        </div>

        @if (!string.IsNullOrEmpty(ErrorAccion))
        {
            <div class="alert alert-warning py-2 px-3" role="alert">@ErrorAccion</div>
        }

        @if (!ReservasFiltradas.Any())
        {
            <p class="empty-state">No se encontraron reservas confirmadas con esa búsqueda.</p>
        }
        else
        {
            <div class="data-table-wrapper shadow-sm mb-4">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Reserva</th>
                            <th scope="col">Cliente</th>
                            <th scope="col">Función</th>
                            <th scope="col" class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (ReservaDto reserva in ReservasFiltradas)
                        {
                            <tr class="@(ReservaSeleccionada?.Id == reserva.Id ? "table-active" : "")">
                                <td class="font-monospace">@reserva.CodigoOId</td>
                                <td>
                                    @reserva.Cliente
                                    <div class="small text-secondary">DNI: @reserva.Dni</div>
                                </td>
                                <td>
                                    @reserva.FuncionNombre
                                    <div class="small text-secondary">@reserva.FechaFuncion.ToString("dd/MM/yyyy HH:mm")</div>
                                </td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => SeleccionarAsync(reserva)">
                                        Ver entradas
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (ReservaSeleccionada != null)
        {
            <div class="card border-primary">
                <div class="card-body">
                    <h2 class="fs-5 card-title">Entradas de @ReservaSeleccionada.CodigoOId — @ReservaSeleccionada.Cliente</h2>

                    @if (CargandoEntradas)
                    {
                        <div class="d-flex align-items-center gap-2 text-secondary" role="status" aria-live="polite">
                            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                            Cargando entradas...
                        </div>
                    }
                    else if (Entradas.Count == 0)
                    {
                        <p class="text-muted small mb-0">Esta reserva todavía no tiene entradas emitidas.</p>
                    }
                    else
                    {
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">Entrada</th>
                                    <th scope="col">Butaca</th>
                                    <th scope="col">Estado</th>
                                    <th scope="col" class="text-end">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (EntradaDto entrada in Entradas)
                                {
                                    <tr>
                                        <td>#@entrada.Id</td>
                                        <td>@(string.IsNullOrEmpty(entrada.ButacaIdentificador) ? "—" : entrada.ButacaIdentificador)</td>
                                        <td><span class="badge @ClaseEstado(entrada.Estado)">@TextoEstado(entrada.Estado)</span></td>
                                        <td class="text-end">
                                            @if (entrada.Estado == "VIGENTE")
                                            {
                                                <div class="d-flex gap-2 justify-content-end">
                                                    <button type="button" class="btn btn-success btn-sm" disabled="@Enviando"
                                                            @onclick="() => ValidarAsync(entrada)">
                                                        Validar ingreso
                                                    </button>
                                                    <button type="button" class="btn btn-outline-danger btn-sm" disabled="@Enviando"
                                                            @onclick="() => RechazarAsync(entrada)">
                                                        Rechazar
                                                    </button>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-secondary small">Sin acciones</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    private List<ReservaDto> Reservas = [];
    private string Busqueda = string.Empty;
    private bool Cargando;
    private bool Enviando;
    private string Error = string.Empty;
    private string ErrorAccion = string.Empty;

    private ReservaDto? ReservaSeleccionada;
    private List<EntradaDto> Entradas = [];
    private bool CargandoEntradas;

    // Solo tiene sentido validar ingreso de reservas ya confirmadas (son las que tienen entradas emitidas).
    private IEnumerable<ReservaDto> ReservasFiltradas => Reservas
        .Where(r => r.Estado == "CONFIRMADA")
        .Where(r => string.IsNullOrWhiteSpace(Busqueda)
            || r.CodigoOId.Contains(Busqueda, StringComparison.OrdinalIgnoreCase)
            || r.Cliente.Contains(Busqueda, StringComparison.OrdinalIgnoreCase)
            || r.Dni.Contains(Busqueda, StringComparison.OrdinalIgnoreCase));

    protected override Task OnInitializedAsync() => CargarAsync();

    private async Task CargarAsync()
    {
        Cargando = true;
        Error = string.Empty;
        try
        {
            Reservas = await Api.ListarReservas();
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException or ServiceException or TaskCanceledException)
        {
            Error = e.Message;
        }
        finally
        {
            Cargando = false;
        }
    }

    private async Task SeleccionarAsync(ReservaDto reserva)
    {
        ReservaSeleccionada = reserva;
        ErrorAccion = string.Empty;
        CargandoEntradas = true;
        try
        {
            Entradas = await Api.ListarEntradas(reserva.Id);
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException or ServiceException or TaskCanceledException)
        {
            ErrorAccion = "No se pudieron cargar las entradas: " + e.Message;
            Entradas = [];
        }
        finally
        {
            CargandoEntradas = false;
        }
    }

    private async Task ValidarAsync(EntradaDto entrada)
    {
        if (Enviando || ReservaSeleccionada == null) return;
        Enviando = true;
        ErrorAccion = string.Empty;
        try
        {
            await Api.ValidarIngreso(entrada.CodigoQR);
            await SeleccionarAsync(ReservaSeleccionada);
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException or ServiceException or TaskCanceledException)
        {
            ErrorAccion = e.Message;
        }
        finally
        {
            Enviando = false;
        }
    }

    private async Task RechazarAsync(EntradaDto entrada)
    {
        if (Enviando || ReservaSeleccionada == null) return;
        Enviando = true;
        ErrorAccion = string.Empty;
        try
        {
            await Api.CancelarEntrada(entrada.Id);
            await SeleccionarAsync(ReservaSeleccionada);
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException or ServiceException or TaskCanceledException)
        {
            ErrorAccion = e.Message;
        }
        finally
        {
            Enviando = false;
        }
    }

    private static string TextoEstado(string estado) => estado switch
    {
        "VIGENTE" => "Vigente",
        "UTILIZADA" => "Utilizada",
        "CANCELADA" => "Cancelada",
        _ => estado
    };

    private static string ClaseEstado(string estado) => estado switch
    {
        "VIGENTE" => "text-bg-warning",
        "UTILIZADA" => "text-bg-success",
        "CANCELADA" => "text-bg-danger",
        _ => "text-bg-secondary"
    };
}
