@page "/admin/recursos/nuevo"
@page "/admin/recursos/editar/{Id:int}"
@attribute [Authorize(Policy = "Espacios")]
@inject NavigationManager Nav;

@using EntreFunciones.ViewModels

@* 13. Recursos · RF-M2-02 (Lab 9: solo interfaz, Guardar no registra nada) *@

<PageTitle>Recursos</PageTitle>

<h3 class="mb-3">@(Id == null ? "Nuevo recurso" : "Editar recurso")</h3>

@if (MensajeError != null) {
    <div class="alert alert-danger">@MensajeError</div>
}

<EditForm Model="ViewModel" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Nombre</label>
        <InputText tabindex="1" class="form-control" @bind-Value="ViewModel.Nombre" />
        <ValidationMessage For="() => ViewModel.Nombre" />
    </div>
    <div class="mb-3">
        <label class="form-label">Tipo</label>
        <InputSelect tabindex="2" class="form-select" @bind-Value="ViewModel.Tipo">
            <option value="">-- Seleccione --</option>
            @foreach (string tipo in DatosEspaciosDemo.TiposRecurso) {
                <option value="@tipo">@tipo</option>
            }
        </InputSelect>
        <ValidationMessage For="() => ViewModel.Tipo" />
    </div>
    <div class="form-check mb-3">
        <InputCheckbox tabindex="3" class="form-check-input" @bind-Value="ViewModel.IsActivo" />
        <label class="form-check-label">Activo</label>
    </div>

    <button tabindex="4" type="submit" class="btn btn-primary">Guardar</button>
    <a tabindex="5" class="btn btn-outline-secondary" href="admin/recursos">Cancelar</a>
</EditForm>

@code {
    [Parameter]
    public int? Id { get; set; }

    private RecursoViewModel ViewModel { get; set; } = new();
    private string? MensajeError { get; set; }

    protected override void OnParametersSet() {
        if (Id == null) {
            ViewModel = new RecursoViewModel();
            return;
        }
        RecursoViewModel? recurso = DatosEspaciosDemo.Recursos.FirstOrDefault(r => r.Id == Id.Value);
        if (recurso == null) {
            Nav.NavigateTo("/admin/recursos");
            return;
        }
        // Se trabaja sobre una copia para no modificar los datos de ejemplo
        ViewModel = recurso.Clonar();
    }

    private void Guardar() {
        // Lab 9: solo interfaz. Aquí se llamará al servicio de recursos (insertar o modificar).
        Nav.NavigateTo("/admin/recursos");
    }
}
