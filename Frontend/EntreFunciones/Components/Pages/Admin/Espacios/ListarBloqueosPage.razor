@page "/admin/bloqueos"
@attribute [Authorize(Policy = "Espacios")]
@inject NavigationManager Nav;

@using Microsoft.AspNetCore.Components.QuickGrid
@using EntreFunciones.ViewModels

@* 13. Bloqueos · RF-M2-02 (Lab 9: solo interfaz, datos de ejemplo) *@

<PageTitle>Bloqueos</PageTitle>

<div class="d-flex justify-content-between mb-3">
    <h3 class="mb-3">Bloqueos</h3>
    <button tabindex="5" class="btn btn-success" @onclick="() => NuevoBloqueo()">
        Nuevo bloqueo
    </button>
</div>

<div class="d-flex align-items-center gap-2 mb-3">
    <label class="text-nowrap">Bloqueado:</label>
    <select tabindex="1" class="form-select" @bind="FiltroObjetivo">
        <option value="">Salas y recursos</option>
        <option value="Sala">Solo salas</option>
        <option value="Recurso">Solo recursos</option>
    </select>
    <label class="text-nowrap">Estado:</label>
    <select tabindex="2" class="form-select" @bind="FiltroEstado">
        <option value="">Todos</option>
        <option value="Vigente">Vigente</option>
        <option value="Programado">Programado</option>
        <option value="Finalizado">Finalizado</option>
    </select>
    <button tabindex="3" class="btn btn-primary" @onclick="() => FiltrarBloqueos()">Filtrar</button>
    <button tabindex="4" class="btn btn-secondary" @onclick="() => LimpiarFiltro()">Limpiar</button>
</div>

@if (!Bloqueos.Any()) {
    <div class="alert alert-info">No hay bloqueos registrados.</div>
}
else {
    <QuickGrid Items="Bloqueos" Pagination="Paginacion" Class="table table-striped table-hover">
        <PropertyColumn Title="Id" Property="b => b.Id" Sortable="true" />
        <PropertyColumn Title="Tipo" Property="b => b.TipoObjetivo" Sortable="true" />
        <PropertyColumn Title="Bloqueado" Property="b => b.NombreObjetivo" Sortable="true" />
        <PropertyColumn Title="Motivo" Property="b => b.Motivo" />
        <PropertyColumn Title="Inicio" Property="b => b.FechaInicio" Format="dd/MM/yyyy HH:mm" Sortable="true" />
        <PropertyColumn Title="Fin" Property="b => b.FechaFin" Format="dd/MM/yyyy HH:mm" Sortable="true" />
        <TemplateColumn Title="Estado">
            <span class="badge @ClaseEstado(context.Estado)">@context.Estado</span>
        </TemplateColumn>
        <TemplateColumn Title="Acciones">
            <button class="btn btn-primary btn-sm" @onclick="() => EditarBloqueo(context.Id)">
                Editar
            </button>
            <button class="btn btn-danger btn-sm" @onclick="() => LevantarBloqueo(context.Id)">
                Levantar
            </button>
        </TemplateColumn>
    </QuickGrid>
    <Paginator State="Paginacion"></Paginator>
}

@code {
    private IQueryable<BloqueoViewModel> Bloqueos { get; set; } = Enumerable.Empty<BloqueoViewModel>().AsQueryable();
    private string FiltroObjetivo { get; set; } = string.Empty;
    private string FiltroEstado { get; set; } = string.Empty;
    private PaginationState Paginacion { get; } = new() { ItemsPerPage = 5 };

    protected override void OnInitialized() {
        Bloqueos = DatosEspaciosDemo.Bloqueos.AsQueryable();
    }

    private void NuevoBloqueo() {
        Nav.NavigateTo("/admin/bloqueos/nuevo");
    }

    private void EditarBloqueo(int id) {
        Nav.NavigateTo($"/admin/bloqueos/editar/{id}");
    }

    private void LevantarBloqueo(int id) {
        // Lab 9: solo interfaz. Aquí se llamará al servicio de bloqueos (desactivar el bloqueo).
    }

    private void FiltrarBloqueos() {
        Bloqueos = DatosEspaciosDemo.Bloqueos
            .Where(b => FiltroObjetivo == string.Empty || b.TipoObjetivo == FiltroObjetivo)
            .Where(b => FiltroEstado == string.Empty || b.Estado == FiltroEstado)
            .AsQueryable();
    }

    private void LimpiarFiltro() {
        FiltroObjetivo = string.Empty;
        FiltroEstado = string.Empty;
        Bloqueos = DatosEspaciosDemo.Bloqueos.AsQueryable();
    }

    private static string ClaseEstado(string estado) {
        return estado switch {
            "Vigente" => "text-bg-danger",
            "Programado" => "text-bg-warning",
            _ => "text-bg-secondary"
        };
    }
}
