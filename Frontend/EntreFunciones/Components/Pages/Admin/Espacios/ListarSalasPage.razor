@page "/admin/salas"
@attribute [Authorize(Policy = "Espacios")]
@inject NavigationManager Nav

@using Microsoft.AspNetCore.Components.QuickGrid
@using EntreFunciones.ViewModels

@* 11. Salas · RF-M2-01 (Lab 9: solo interfaz, datos de ejemplo)
   Se puede abrir filtrada por sede desde el listado de sedes: /admin/salas?sede=1 *@

<PageTitle>Salas</PageTitle>

<div class="page-shell">
<div class="page-header">
    <div>
        <h1 class="page-title">Salas</h1>
        <p class="page-description">Consulta las salas, su aforo y la sede a la que pertenecen.</p>
    </div>
    <button type="button" class="btn btn-primary" @onclick="NuevaSala">
        Nueva sala
    </button>
</div>

<div class="filter-panel">
    <div class="row g-3 align-items-end">
        <div class="col-12 col-md-5">
            <label for="filtroSede" class="form-label">Sede</label>
            <select id="filtroSede" class="form-select" @bind="FiltroSede">
                <option value="0">Todas las sedes</option>
                @foreach (SedeViewModel sede in DatosEspaciosDemo.Sedes) {
                    <option value="@sede.Id">@sede.RazonSocial</option>
                }
            </select>
        </div>
        <div class="col-12 col-md">
            <label for="filtroNombreSala" class="form-label">Nombre</label>
            <input id="filtroNombreSala" class="form-control" placeholder="Ej.: Sala 1" @bind="Filtro" />
        </div>
        <div class="col-12 col-md-auto d-flex gap-2">
            <button type="button" class="btn btn-primary" @onclick="FiltrarSalas">Filtrar</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="LimpiarFiltro">Limpiar</button>
        </div>
    </div>
</div>

@if (!Salas.Any()) {
    <div class="empty-state" role="status">No hay salas registradas.</div>
}
else {
    <div class="data-table-wrapper">
    <QuickGrid Items="Salas" Pagination="Paginacion" Class="table table-striped table-hover">
        <PropertyColumn Title="Id" Property="s => s.Id" Sortable="true" />
        <PropertyColumn Title="Sede" Property="s => s.NombreSede" Sortable="true" />
        <PropertyColumn Title="Nombre" Property="s => s.Nombre" Sortable="true" />
        <PropertyColumn Title="Tipo" Property="s => s.TipoSala" Sortable="true" />
        <PropertyColumn Title="Aforo" Property="s => s.Aforo" Sortable="true" Align="Align.End" />
        <TemplateColumn Title="Activo" Align="Align.Center">
            <input type="checkbox" checked="@context.IsActivo" disabled />
        </TemplateColumn>
        <TemplateColumn Title="Acciones">
            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => VerButacas(context.Id)">
                Butacas
            </button>
            <button type="button" class="btn btn-primary btn-sm" @onclick="() => EditarSala(context.Id)">
                Editar
            </button>
            <button type="button" class="btn btn-danger btn-sm" @onclick="() => DesactivarSala(context.Id)">
                Desactivar
            </button>
        </TemplateColumn>
    </QuickGrid>
    </div>
    <Paginator State="Paginacion"></Paginator>
}
</div>

@code {
    [SupplyParameterFromQuery(Name = "sede")]
    public int? SedeInicial { get; set; }

    private IQueryable<SalaViewModel> Salas { get; set; } = Enumerable.Empty<SalaViewModel>().AsQueryable();
    private int FiltroSede { get; set; }
    private string Filtro { get; set; } = string.Empty;
    private PaginationState Paginacion { get; } = new() { ItemsPerPage = 5 };

    protected override void OnParametersSet() {
        FiltroSede = SedeInicial ?? 0;
        FiltrarSalas();
    }

    private void NuevaSala() {
        Nav.NavigateTo("/admin/salas/nuevo");
    }

    private void EditarSala(int id) {
        Nav.NavigateTo($"/admin/salas/editar/{id}");
    }

    private void VerButacas(int idSala) {
        Nav.NavigateTo($"/admin/salas/{idSala}/butacas");
    }

    private void DesactivarSala(int id) {
        // Lab 9: solo interfaz. Aquí se llamará al servicio de salas (eliminado lógico).
    }

    private void FiltrarSalas() {
        Salas = DatosEspaciosDemo.Salas
            .Where(s => FiltroSede == 0 || s.IdSede == FiltroSede)
            .Where(s => s.Nombre.Contains(Filtro, StringComparison.OrdinalIgnoreCase))
            .AsQueryable();
    }

    private void LimpiarFiltro() {
        FiltroSede = 0;
        Filtro = string.Empty;
        Salas = DatosEspaciosDemo.Salas.AsQueryable();
    }
}
