@page "/admin/sedes/nuevo"
@page "/admin/sedes/editar/{Id:int}"
@attribute [Authorize(Policy = "Espacios")]
@inject NavigationManager Nav

@using EntreFunciones.ViewModels

@* 11. Sedes · RF-M2-01 (Lab 9: solo interfaz, Guardar no registra nada) *@

<PageTitle>@(Id == null ? "Nueva sede" : "Editar sede")</PageTitle>

<div class="page-shell page-shell-narrow">
<div class="page-header">
    <div>
        <h1 class="page-title">@(Id == null ? "Nueva sede" : "Editar sede")</h1>
        <p class="page-description">Completa los datos de ubicación y contacto.</p>
    </div>
</div>
<div class="card card-body shadow-sm">

@if (MensajeError != null) {
    <div class="alert alert-danger" role="alert" aria-live="assertive">@MensajeError</div>
}

<EditForm Model="ViewModel" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label for="razonSocial" class="form-label">Razón social</label>
        <InputText id="razonSocial" class="form-control" @bind-Value="ViewModel.RazonSocial" />
        <ValidationMessage For="() => ViewModel.RazonSocial" />
    </div>
    <div class="mb-3">
        <label for="direccionSede" class="form-label">Dirección</label>
        <InputText id="direccionSede" class="form-control" @bind-Value="ViewModel.Direccion" />
        <ValidationMessage For="() => ViewModel.Direccion" />
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label for="ciudadSede" class="form-label">Ciudad</label>
            <InputText id="ciudadSede" class="form-control" @bind-Value="ViewModel.Ciudad" />
            <ValidationMessage For="() => ViewModel.Ciudad" />
        </div>
        <div class="col-md-6 mb-3">
            <label for="telefonoSede" class="form-label">Teléfono de contacto</label>
            <InputText id="telefonoSede" class="form-control" @bind-Value="ViewModel.TelefonoContacto" />
            <ValidationMessage For="() => ViewModel.TelefonoContacto" />
        </div>
    </div>
    <div class="form-check mb-3">
        <InputCheckbox id="sedeActiva" class="form-check-input" @bind-Value="ViewModel.IsActivo" />
        <label for="sedeActiva" class="form-check-label">Activo</label>
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a class="btn btn-outline-secondary" href="admin/sedes">Cancelar</a>
</EditForm>
</div>
</div>

@code {
    [Parameter]
    public int? Id { get; set; }

    private SedeViewModel ViewModel { get; set; } = new();
    private string? MensajeError { get; set; }

    protected override void OnParametersSet() {
        if (Id == null) {
            ViewModel = new SedeViewModel();
            return;
        }
        SedeViewModel? sede = DatosEspaciosDemo.Sedes.FirstOrDefault(s => s.Id == Id.Value);
        if (sede == null) {
            Nav.NavigateTo("/admin/sedes");
            return;
        }
        // Se trabaja sobre una copia para no modificar los datos de ejemplo
        ViewModel = sede.Clonar();
    }

    private void Guardar() {
        // Lab 9: solo interfaz. Aquí se llamará al servicio de sedes (insertar o modificar).
        Nav.NavigateTo("/admin/sedes");
    }
}
