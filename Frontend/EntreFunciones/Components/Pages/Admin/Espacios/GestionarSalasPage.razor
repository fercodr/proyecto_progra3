@page "/admin/salas/nuevo"
@page "/admin/salas/editar/{Id:int}"
@attribute [Authorize(Policy = "Espacios")]
@inject NavigationManager Nav;

@using EntreFunciones.ViewModels

@* 11. Salas · RF-M2-01 (Lab 9: solo interfaz, Guardar no registra nada) *@

<PageTitle>Salas</PageTitle>

<h3 class="mb-3">@(Id == null ? "Nueva sala" : "Editar sala")</h3>

@if (MensajeError != null) {
    <div class="alert alert-danger">@MensajeError</div>
}

<EditForm Model="ViewModel" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Sede</label>
        <InputSelect tabindex="1" class="form-select" @bind-Value="ViewModel.IdSede">
            <option value="0">-- Seleccione --</option>
            @foreach (SedeViewModel sede in DatosEspaciosDemo.Sedes) {
                <option value="@sede.Id">@sede.RazonSocial</option>
            }
        </InputSelect>
        <ValidationMessage For="() => ViewModel.IdSede" />
    </div>
    <div class="mb-3">
        <label class="form-label">Nombre</label>
        <InputText tabindex="2" class="form-control" @bind-Value="ViewModel.Nombre" />
        <ValidationMessage For="() => ViewModel.Nombre" />
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">Aforo</label>
            <InputNumber tabindex="3" class="form-control" @bind-Value="ViewModel.Aforo" />
            <ValidationMessage For="() => ViewModel.Aforo" />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Tipo de sala</label>
            <InputSelect tabindex="4" class="form-select" @bind-Value="ViewModel.TipoSala">
                <option value="">-- Seleccione --</option>
                @foreach (string tipo in DatosEspaciosDemo.TiposSala) {
                    <option value="@tipo">@tipo</option>
                }
            </InputSelect>
            <ValidationMessage For="() => ViewModel.TipoSala" />
        </div>
    </div>
    <div class="form-check mb-3">
        <InputCheckbox tabindex="5" class="form-check-input" @bind-Value="ViewModel.IsActivo" />
        <label class="form-check-label">Activo</label>
    </div>

    <button tabindex="6" type="submit" class="btn btn-primary">Guardar</button>
    <a tabindex="7" class="btn btn-outline-secondary" href="admin/salas">Cancelar</a>
</EditForm>

@code {
    [Parameter]
    public int? Id { get; set; }

    private SalaViewModel ViewModel { get; set; } = new();
    private string? MensajeError { get; set; }

    protected override void OnParametersSet() {
        if (Id == null) {
            ViewModel = new SalaViewModel();
            return;
        }
        SalaViewModel? sala = DatosEspaciosDemo.Salas.FirstOrDefault(s => s.Id == Id.Value);
        if (sala == null) {
            Nav.NavigateTo("/admin/salas");
            return;
        }
        // Se trabaja sobre una copia para no modificar los datos de ejemplo
        ViewModel = sala.Clonar();
    }

    private void Guardar() {
        // Lab 9: solo interfaz. Aquí se llamará al servicio de salas (insertar o modificar).
        Nav.NavigateTo("/admin/salas");
    }
}
