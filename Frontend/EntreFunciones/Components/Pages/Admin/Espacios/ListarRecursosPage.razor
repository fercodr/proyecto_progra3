@page "/admin/recursos"
@attribute [Authorize(Policy = "Espacios")]
@inject NavigationManager Nav;

@using Microsoft.AspNetCore.Components.QuickGrid
@using EntreFunciones.ViewModels

@* 13. Recursos · RF-M2-02 (Lab 9: solo interfaz, datos de ejemplo) *@

<PageTitle>Recursos</PageTitle>

<div class="d-flex justify-content-between mb-3">
    <h3 class="mb-3">Recursos</h3>
    <button tabindex="5" class="btn btn-success" @onclick="() => NuevoRecurso()">
        Nuevo recurso
    </button>
</div>

<div class="d-flex align-items-center gap-2 mb-3">
    <label class="text-nowrap">Tipo:</label>
    <select tabindex="1" class="form-select" @bind="FiltroTipo">
        <option value="">Todos los tipos</option>
        @foreach (string tipo in DatosEspaciosDemo.TiposRecurso) {
            <option value="@tipo">@tipo</option>
        }
    </select>
    <label class="text-nowrap">Nombre:</label>
    <input tabindex="2" class="form-control" placeholder="Ingrese el nombre..." @bind="Filtro" />
    <button tabindex="3" class="btn btn-primary" @onclick="() => FiltrarRecursos()">Filtrar</button>
    <button tabindex="4" class="btn btn-secondary" @onclick="() => LimpiarFiltro()">Limpiar</button>
</div>

@if (!Recursos.Any()) {
    <div class="alert alert-info">No hay recursos registrados.</div>
}
else {
    <QuickGrid Items="Recursos" Pagination="Paginacion" Class="table table-striped table-hover">
        <PropertyColumn Title="Id" Property="r => r.Id" Sortable="true" />
        <PropertyColumn Title="Nombre" Property="r => r.Nombre" Sortable="true" />
        <PropertyColumn Title="Tipo" Property="r => r.Tipo" Sortable="true" />
        <TemplateColumn Title="Activo" Align="Align.Center">
            <input type="checkbox" checked="@context.IsActivo" disabled />
        </TemplateColumn>
        <TemplateColumn Title="Acciones">
            <button class="btn btn-outline-warning btn-sm" @onclick="() => BloquearRecurso(context.Id)">
                Bloquear
            </button>
            <button class="btn btn-primary btn-sm" @onclick="() => EditarRecurso(context.Id)">
                Editar
            </button>
            <button class="btn btn-danger btn-sm" @onclick="() => DesactivarRecurso(context.Id)">
                Desactivar
            </button>
        </TemplateColumn>
    </QuickGrid>
    <Paginator State="Paginacion"></Paginator>
}

@code {
    private IQueryable<RecursoViewModel> Recursos { get; set; } = Enumerable.Empty<RecursoViewModel>().AsQueryable();
    private string FiltroTipo { get; set; } = string.Empty;
    private string Filtro { get; set; } = string.Empty;
    private PaginationState Paginacion { get; } = new() { ItemsPerPage = 5 };

    protected override void OnInitialized() {
        Recursos = DatosEspaciosDemo.Recursos.AsQueryable();
    }

    private void NuevoRecurso() {
        Nav.NavigateTo("/admin/recursos/nuevo");
    }

    private void EditarRecurso(int id) {
        Nav.NavigateTo($"/admin/recursos/editar/{id}");
    }

    private void BloquearRecurso(int id) {
        Nav.NavigateTo($"/admin/bloqueos/nuevo?recurso={id}");
    }

    private void DesactivarRecurso(int id) {
        // Lab 9: solo interfaz. Aquí se llamará al servicio de recursos (eliminado lógico).
    }

    private void FiltrarRecursos() {
        Recursos = DatosEspaciosDemo.Recursos
            .Where(r => FiltroTipo == string.Empty || r.Tipo == FiltroTipo)
            .Where(r => r.Nombre.Contains(Filtro, StringComparison.OrdinalIgnoreCase))
            .AsQueryable();
    }

    private void LimpiarFiltro() {
        FiltroTipo = string.Empty;
        Filtro = string.Empty;
        Recursos = DatosEspaciosDemo.Recursos.AsQueryable();
    }
}
