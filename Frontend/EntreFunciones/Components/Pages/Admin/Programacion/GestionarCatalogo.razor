@page "/admin/catalogo/nuevo"
@page "/admin/catalogo/editar/{Id:int}"
@inject NavigationManager Nav
@inject ICatalogoService Catalogo
@inject IImagenService ImagenService
@inject ISedeService SedeServicio
@inject ISalaService SalaServicio
@inject IBloqueoSalaService BloqueosSala
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@using EntreFunciones.DTOSS
@using EntreFunciones.Servicios
@using EntreFunciones.Servicios.Rest
@using EntreFunciones.ViewModels
@attribute [Authorize(Policy = "Programacion")]
<PageTitle>@(Id == null ? "Nuevo evento" : "Editar evento")</PageTitle>

<div class="page-shell page-shell-narrow">
    <div class="page-header">
        <div>
            <h1 class="page-title">@(Id == null ? "Nuevo evento" : "Editar evento")</h1>
            <p class="page-description">Selecciona el tipo de evento y completa sus datos.</p>
        </div>
    </div>

    @if (Cargando)
    {
        <div class="text-center my-5" role="status">
            <div class="spinner-border" aria-hidden="true"></div>
            <p class="text-muted mt-2">Cargando evento...</p>
        </div>
    }
    else
    {
        @if (MensajeError != null)
        {
            <div class="alert alert-danger" role="alert" aria-live="assertive">@MensajeError</div>
        }
        <form>
            <div class="mb-3">
                <label for="tipoEvento" class="form-label">Tipo de evento</label>
                <select id="tipoEvento" class="form-select" @bind="TipoEvento" disabled="@(Id != null)">
                    <option value="">-- Seleccione un tipo --</option>
                    <option value="PELICULA">Película</option>
                    <option value="ACTIVIDAD_CULTURAL">Actividad cultural</option>
                    <option value="OBRA_TEATRO">Obra de teatro</option>
                </select>
                @if (Id != null)
                {
                    <div class="form-text">El tipo de un evento no se puede cambiar una vez creado.</div>
                }
            </div>
            @if (TipoEvento != "")
            {
                <div class="card mb-3">
                    <div class="card-header">Datos generales</div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label for="tituloEvento" class="form-label">Título</label>
                            <input id="tituloEvento" type="text" class="form-control" @bind="Titulo" />
                        </div>
                        <div class="mb-3">
                            <label for="precioEvento" class="form-label">Precio (S/)</label>
                            <input id="precioEvento" type="number" step="0.01" min="0" class="form-control" @bind="Precio" />
                        </div>
                        <div class="mb-3">
                            <label for="tematicaEvento" class="form-label">Temática</label>
                            <input id="tematicaEvento" type="text" class="form-control" @bind="Tematica" />
                        </div>
                        <div class="mb-3">
                            <label for="publicoEvento" class="form-label">Público objetivo</label>
                            <input id="publicoEvento" type="text" class="form-control" @bind="PublicoObjetivo" />
                        </div>
                        @if (Id != null)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkActivo" @bind="Activo" />
                                <label class="form-check-label" for="chkActivo">Activo</label>
                            </div>
                        }
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header">Imagen del evento</div>
                    <div class="card-body">
                        <label for="imagenEvento" class="form-label">Seleccione una imagen</label>
                        <InputFile id="imagenEvento" class="form-control" accept="image/*" OnChange="CargarImagen" />
                        <div class="form-text">
                            Formatos: JPG, PNG o WEBP. Máximo 2 MB. Al pulsar "Guardar", el póster se sube
                            a Amazon S3 y su URL queda en el evento.
                        </div>

                        @if (ImagenPreview != null)
                        {
                            <img src="@ImagenPreview" alt="Vista previa de la imagen" class="img-thumbnail mt-3" style="max-height: 200px;" />
                        }
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header">Datos específicos</div>
                    <div class="card-body">

                        @if (TipoEvento == "PELICULA")
                        {
                            <div class="mb-3">
                                <label for="duracionPelicula" class="form-label">Duración (minutos)</label>
                                <input id="duracionPelicula" type="number" min="0" class="form-control" @bind="DuracionMinutos" />
                            </div>
                            <div class="mb-3">
                                <label for="generoPelicula" class="form-label">Género</label>
                                <select id="generoPelicula" class="form-select" @bind="Genero">
                                    <option value="ACCION">Acción</option>
                                    <option value="COMEDIA">Comedia</option>
                                    <option value="DRAMA">Drama</option>
                                    <option value="TERROR">Terror</option>
                                    <option value="ANIMACION">Animación</option>
                                    <option value="DOCUMENTAL">Documental</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label for="clasificacionPelicula" class="form-label">Clasificación por edad</label>
                                <select id="clasificacionPelicula" class="form-select" @bind="ClasificacionPorEdad">
                                    <option value="APTA_TODO_PUBLICO">Apta para todo público</option>
                                    <option value="PG13">PG-13</option>
                                    <option value="MAYORES_18">Solo mayores de 18</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label for="directorPelicula" class="form-label">Director</label>
                                <input id="directorPelicula" type="text" class="form-control" @bind="Director" />
                            </div>
                        }
                        else if (TipoEvento == "ACTIVIDAD_CULTURAL")
                        {
                            <div class="mb-3">
                                <label for="expositorActividad" class="form-label">Expositor</label>
                                <input id="expositorActividad" type="text" class="form-control" @bind="Expositor" />
                            </div>
                            <div class="mb-3">
                                <label for="tipoActividad" class="form-label">Tipo de actividad</label>
                                <select id="tipoActividad" class="form-select" @bind="TipoActividad">
                                    <option value="CONVERSATORIO">Conversatorio</option>
                                    <option value="TALLER">Taller</option>
                                    <option value="EXPOSICION">Exposición</option>
                                    <option value="CHARLA">Charla</option>
                                </select>
                            </div>
                        }
                        else if (TipoEvento == "OBRA_TEATRO")
                        {
                            <div class="mb-3">
                                <label for="directorObra" class="form-label">Nombre del director</label>
                                <input id="directorObra" type="text" class="form-control" @bind="NombreDirector" />
                            </div>
                            <div class="mb-3">
                                <label for="elencoObra" class="form-label">Elenco</label>
                                <textarea id="elencoObra" class="form-control" rows="3" @bind="Elenco"></textarea>
                            </div>
                        }

                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header">Programación integrada</div>
                    <div class="card-body">
                        <div class="form-check mb-3">
                            <input id="incluirProgramacion" class="form-check-input" type="checkbox" @bind="IncluirProgramacion" />
                            <label for="incluirProgramacion" class="form-check-label">
                                @(Id == null ? "Programar la primera función" : "Guardar contenido y programación en la misma operación")
                            </label>
                        </div>

                        @if (IncluirProgramacion)
                        {
                            @if (Id != null)
                            {
                                <div class="mb-3">
                                    <label for="funcionEvento" class="form-label">Función</label>
                                    <select id="funcionEvento" class="form-select" value="@FuncionSeleccionadaId" @onchange="CambiarFuncion">
                                        <option value="0">Nueva función</option>
                                        @foreach (FuncionDTO funcion in FuncionesExistentes)
                                        {
                                            <option value="@funcion.Id">@funcion.Fecha · @funcion.HoraInicio · @funcion.NombreSala</option>
                                        }
                                    </select>
                                </div>
                            }

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label for="sedeFuncion" class="form-label">Sede</label>
                                    <select id="sedeFuncion" class="form-select" value="@IdSedeFuncion" @onchange="CambiarSede">
                                        <option value="0">Seleccione una sede...</option>
                                        @foreach (SedeViewModel sede in Sedes)
                                        {
                                            <option value="@sede.Id">@sede.RazonSocial · @sede.Distrito</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label for="salaFuncion" class="form-label">Sala</label>
                                    <select id="salaFuncion" class="form-select" @bind="IdSalaFuncion" disabled="@(!Salas.Any())">
                                        <option value="0">Seleccione una sala...</option>
                                        @foreach (SalaViewModel sala in Salas)
                                        {
                                            <option value="@sala.Id">@sala.Nombre (aforo @sala.Aforo)</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label for="fechaFuncion" class="form-label">Fecha</label>
                                    <InputDate id="fechaFuncion" class="form-control" @bind-Value="FechaFuncion" />
                                </div>
                                <div class="col-md-4">
                                    <label for="inicioFuncion" class="form-label">Hora de inicio</label>
                                    <input id="inicioFuncion" type="time" class="form-control" @bind="HoraInicioFuncion" />
                                </div>
                                <div class="col-md-4">
                                    <label for="finFuncion" class="form-label">Hora de fin</label>
                                    <input id="finFuncion" type="time" class="form-control" @bind="HoraFinFuncion" />
                                </div>
                                <div class="col-md-6">
                                    <label for="idiomaFuncion" class="form-label">Idioma</label>
                                    <select id="idiomaFuncion" class="form-select" @bind="IdiomaFuncion">
                                        <option value="Español">Español</option>
                                        <option value="Subtitulada">Subtitulada</option>
                                        <option value="Doblada">Doblada</option>
                                    </select>
                                </div>
                                @if (FuncionSeleccionadaId > 0)
                                {
                                    <div class="col-md-6">
                                        <label class="form-label">Estado conservado</label>
                                        <input class="form-control" value="@EstadoFuncion" disabled />
                                    </div>
                                }
                            </div>
                            <div class="form-text mt-2">
                                El servidor vuelve a comprobar sala activa, bloqueos y cruces antes de confirmar la operación.
                            </div>
                        }
                    </div>
                </div>
                <button type="button" class="btn btn-primary" @onclick="Guardar" disabled="@Guardando">
                    @(Guardando ? "Guardando..." : "Guardar")
                </button>
                <a class="btn btn-outline-secondary" href="admin/catalogo">Cancelar</a>
            }
        </form>
    }
</div>

@code {
    [Parameter]
    public int? Id { get; set; }

    private bool Cargando = true;
    private bool Guardando;
    private string TipoEvento { get; set; } = "";
    private string? MensajeError { get; set; }
    private string? ImagenPreview { get; set; }

    // Póster: el que ya tiene el evento (URL de S3) y el nuevo elegido (aún sin subir)
    private string? ImagenUrlActual;
    private byte[]? ImagenBytes;
    private string ImagenTipo = "";

    private string Titulo = "";
    private double Precio;
    private bool Activo = true;
    private string? Tematica;
    private string? PublicoObjetivo;

    // Pelicula
    private int? DuracionMinutos;
    private string Genero = "ACCION";
    private string ClasificacionPorEdad = "APTA_TODO_PUBLICO";
    private string? Director;

    // ObraTeatro
    private string? NombreDirector;
    private string? Elenco;

    // ActividadCultural
    private string? Expositor;
    private string TipoActividad = "CONVERSATORIO";

    // RF-M3-01: contenido y programación viajan juntos en EventoDTO.Funciones.
    private bool IncluirProgramacion = true;
    private int FuncionSeleccionadaId;
    private List<FuncionDTO> FuncionesExistentes = new();
    private List<SedeViewModel> Sedes = new();
    private List<SalaViewModel> Salas = new();
    private int IdSedeFuncion;
    private int IdSalaFuncion;
    private DateOnly FechaFuncion = DateOnly.FromDateTime(DateTime.Today);
    private TimeOnly HoraInicioFuncion = new(18, 0);
    private TimeOnly HoraFinFuncion = new(20, 0);
    private string IdiomaFuncion = "Español";
    private string EstadoFuncion = "PROGRAMADA";

    protected override async Task OnParametersSetAsync()
    {
        Cargando = true;
        MensajeError = null;
        try
        {
            Sedes = (await SedeServicio.FindAll())
                .Where(s => s.IsActivo)
                .OrderBy(s => s.RazonSocial)
                .ToList();
            if (Id == null)
            {
                IncluirProgramacion = true;
                return;
            }

            EventoDTO evento = await Catalogo.ObtenerEvento(Id.Value, completo: true);
            TipoEvento = evento.Tipo;
            Titulo = evento.Titulo;
            Precio = evento.Precio;
            Activo = evento.Activo;
            Tematica = evento.Tematica;
            PublicoObjetivo = evento.PublicoObjetivo;
            DuracionMinutos = evento.DuracionMinutos;
            Genero = evento.Genero ?? "ACCION";
            ClasificacionPorEdad = evento.ClasificacionPorEdad ?? "APTA_TODO_PUBLICO";
            Director = evento.Director;
            NombreDirector = evento.NombreDirector;
            Elenco = evento.Elenco;
            Expositor = evento.Expositor;
            TipoActividad = evento.TipoActividad ?? "CONVERSATORIO";
            FuncionesExistentes = evento.Funciones ?? new();
            IncluirProgramacion = FuncionesExistentes.Count > 0;
            if (IncluirProgramacion)
            {
                await CargarFuncion(FuncionesExistentes[0]);
            }

            ImagenUrlActual = evento.ImagenUrl;
            if (ImagenUrlActual != null && ImagenUrlActual.StartsWith("http"))
            {
                ImagenPreview = ImagenUrlActual;   // póster actual guardado en S3
            }
        }
        catch (Exception ex)
        {
            MensajeError = ex.Message;
        }
        finally
        {
            Cargando = false;
        }
    }

    private async Task CambiarFuncion(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out int idFuncion) || idFuncion <= 0)
        {
            FuncionSeleccionadaId = 0;
            IdSedeFuncion = 0;
            IdSalaFuncion = 0;
            Salas = new();
            FechaFuncion = DateOnly.FromDateTime(DateTime.Today);
            HoraInicioFuncion = new TimeOnly(18, 0);
            HoraFinFuncion = new TimeOnly(20, 0);
            IdiomaFuncion = "Español";
            EstadoFuncion = "PROGRAMADA";
            return;
        }

        FuncionDTO? funcion = FuncionesExistentes.FirstOrDefault(f => f.Id == idFuncion);
        if (funcion != null)
        {
            await CargarFuncion(funcion);
        }
    }

    private async Task CargarFuncion(FuncionDTO funcion)
    {
        FuncionSeleccionadaId = funcion.Id;
        IdSedeFuncion = funcion.IdSede;
        await CargarSalas(funcion.IdSede);
        IdSalaFuncion = funcion.IdSala;
        FechaFuncion = DateOnly.TryParse(funcion.Fecha, out DateOnly fecha)
            ? fecha : DateOnly.FromDateTime(DateTime.Today);
        HoraInicioFuncion = TimeOnly.TryParse(funcion.HoraInicio, out TimeOnly inicio)
            ? inicio : new TimeOnly(18, 0);
        HoraFinFuncion = TimeOnly.TryParse(funcion.HoraFin, out TimeOnly fin)
            ? fin : new TimeOnly(20, 0);
        IdiomaFuncion = funcion.Idioma;
        EstadoFuncion = string.IsNullOrWhiteSpace(funcion.Estado) ? "PROGRAMADA" : funcion.Estado;
    }

    private async Task CambiarSede(ChangeEventArgs e)
    {
        int.TryParse(e.Value?.ToString(), out int idSede);
        IdSedeFuncion = idSede;
        IdSalaFuncion = 0;
        await CargarSalas(idSede);
    }

    private async Task CargarSalas(int idSede)
    {
        Salas = idSede <= 0
            ? new()
            : (await SalaServicio.FindBySede(idSede))
                .Where(s => s.IsActivo)
                .OrderBy(s => s.Nombre)
                .ToList();
    }

    private async Task CargarImagen(InputFileChangeEventArgs e)
    {
        IBrowserFile archivo = e.File;
        long maximo = 2 * 1024 * 1024; // 2 MB

        if (archivo.Size > maximo)
        {
            MensajeError = "La imagen no puede pesar más de 2 MB.";
            return;
        }

        // Sin maxAllowedSize el límite por defecto es 500 KB
        using var stream = archivo.OpenReadStream(maxAllowedSize: maximo);
        using var memoria = new MemoryStream();
        await stream.CopyToAsync(memoria);

        ImagenPreview = $"data:{archivo.ContentType};base64,{Convert.ToBase64String(memoria.ToArray())}";
        ImagenBytes = memoria.ToArray();      // se sube a S3 al pulsar "Guardar"
        ImagenTipo = archivo.ContentType;
        MensajeError = null;
    }

    private async Task Guardar()
    {
        if (string.IsNullOrWhiteSpace(TipoEvento))
        {
            MensajeError = "Seleccione un tipo de evento.";
            return;
        }
        if (string.IsNullOrWhiteSpace(Titulo))
        {
            MensajeError = "El título es obligatorio.";
            return;
        }
        if (IncluirProgramacion && IdSalaFuncion <= 0)
        {
            MensajeError = "Seleccione la sede y la sala de la función.";
            return;
        }
        if (IncluirProgramacion && HoraFinFuncion <= HoraInicioFuncion)
        {
            MensajeError = "La hora de fin debe ser posterior a la hora de inicio.";
            return;
        }

        Guardando = true;
        MensajeError = null;
        try
        {
            EventoDTO evento = new EventoDTO
            {
                Id = Id ?? 0,
                Tipo = TipoEvento,
                Titulo = Titulo,
                Precio = Precio,
                Activo = Activo,
                Tematica = Tematica,
                PublicoObjetivo = PublicoObjetivo,
                // Se reenvía la URL actual: si no, al editar se borraría el póster (imagen_url = NULL)
                ImagenUrl = ImagenUrlActual
            };

            switch (TipoEvento)
            {
                case "PELICULA":
                    evento.DuracionMinutos = DuracionMinutos;
                    evento.Genero = Genero;
                    evento.ClasificacionPorEdad = ClasificacionPorEdad;
                    evento.Director = Director;
                    break;
                case "OBRA_TEATRO":
                    evento.NombreDirector = NombreDirector;
                    evento.Elenco = Elenco;
                    break;
                case "ACTIVIDAD_CULTURAL":
                    evento.Expositor = Expositor;
                    evento.TipoActividad = TipoActividad;
                    break;
            }

            if (IncluirProgramacion)
            {
                DisponibilidadProgramacionDto disponibilidad =
                    await BloqueosSala.ConsultarDisponibilidad(
                        IdSalaFuncion,
                        FechaFuncion,
                        HoraInicioFuncion,
                        HoraFinFuncion,
                        FuncionSeleccionadaId > 0 ? FuncionSeleccionadaId : null);
                if (!disponibilidad.Disponible)
                {
                    MensajeError = disponibilidad.Motivo;
                    return;
                }

                evento.Funciones = new List<FuncionDTO>
                {
                    new()
                    {
                        Id = FuncionSeleccionadaId,
                        IdEvento = Id ?? 0,
                        IdSala = IdSalaFuncion,
                        IdSede = IdSedeFuncion,
                        Fecha = FechaFuncion.ToString("yyyy-MM-dd"),
                        HoraInicio = HoraInicioFuncion.ToString("HH:mm"),
                        HoraFin = HoraFinFuncion.ToString("HH:mm"),
                        Idioma = IdiomaFuncion,
                        Estado = EstadoFuncion
                    }
                };
            }

            EventoDTO guardado;
            if (Id == null)
            {
                guardado = await Catalogo.CrearEvento(evento);
            }
            else
            {
                guardado = await Catalogo.ActualizarEvento(evento);
            }

            // Si se eligió un póster nuevo, se sube después de guardar (así ya existe el id del evento)
            if (ImagenBytes != null)
            {
                int idEvento = Id ?? guardado.Id;
                await ImagenService.SubirPosterEvento(idEvento, ImagenBytes, ImagenTipo);
            }

            Nav.NavigateTo("admin/catalogo");
        }
        catch (Exception ex)
        {
            MensajeError = ex.Message;
        }
        finally
        {
            Guardando = false;
        }
    }
}
