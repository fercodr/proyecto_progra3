@page "/admin/funciones/nueva"
@page "/admin/funciones/editar/{Id:int}"
@attribute [Authorize(Policy = "Programacion")]
@inject NavigationManager Nav

<PageTitle>@(Id == null ? "Programar función" : "Editar función")</PageTitle>

<div class="page-shell">
<div class="page-header">
    <div>
        <h1 class="page-title">@(Id == null ? "Programar función" : "Editar función")</h1>
        <p class="page-description">Define el contenido, lugar, horario y precio de la función.</p>
    </div>
</div>

<div class="row g-4">

    <div class="col-lg-8">
        <EditForm Model="Formulario" OnSubmit="Guardar">

            <h5 class="mb-3">Contenido</h5>
            <div class="row g-3 mb-3">
                <div class="col-md-8">
                    <label for="evento" class="form-label">Evento</label>
                    <InputSelect id="evento" class="form-select" @bind-Value="Formulario.Evento">
                        <option value="">Seleccione un evento del catálogo...</option>
                        @foreach (string evento in Eventos)
                        {
                            <option value="@evento">@evento</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-4">
                    <label for="idioma" class="form-label">Idioma</label>
                    <InputSelect id="idioma" class="form-select" @bind-Value="Formulario.Idioma">
                        @foreach (string idioma in Idiomas)
                        {
                            <option value="@idioma">@idioma</option>
                        }
                    </InputSelect>
                </div>
            </div>

            <h5 class="mb-3">Lugar y horario</h5>
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label for="sede" class="form-label">Sede</label>
                    <InputSelect id="sede" class="form-select" @bind-Value="Formulario.Sede">
                        @foreach (string sede in Sedes)
                        {
                            <option value="@sede">@sede</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-6">
                    <label for="sala" class="form-label">Sala</label>
                    <InputSelect id="sala" class="form-select" @bind-Value="Formulario.Sala">
                        @foreach (string sala in Salas)
                        {
                            <option value="@sala">@sala</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-4">
                    <label for="fecha" class="form-label">Fecha</label>
                    <InputDate id="fecha" class="form-control" @bind-Value="Formulario.Fecha" />
                </div>
                <div class="col-md-4">
                    <label for="horaInicio" class="form-label">Hora de inicio</label>
                    <input id="horaInicio" type="time" class="form-control" @bind="Formulario.HoraInicio" />
                </div>
                <div class="col-md-4">
                    <label for="horaFin" class="form-label">Hora de fin</label>
                    <input id="horaFin" type="time" class="form-control" @bind="Formulario.HoraFin" />
                </div>
            </div>
            <div class="alert alert-danger" role="alert">
                <p class="mb-0">
                    la Sala 2 ya tiene la función “Coco”
                    confirmada de 18:00 a 19:45 ese día.
                </p>
            </div>
            

            <h5 class="mb-3">Venta</h5>
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label for="precio" class="form-label">Precio (S/)</label>
                    <InputNumber id="precio" class="form-control" @bind-Value="Formulario.Precio" />
                </div>
             

            </div>

            <button type="submit" class="btn btn-primary">Guardar</button>
            <a class="btn btn-outline-secondary" href="admin/funciones">Cancelar</a>
        </EditForm>
    </div>
</div>
</div>

@code {
    [Parameter]
    public int? Id { get; set; }


    private class FuncionFormulario
    {
        public string Evento { get; set; } = "";
        public string Idioma { get; set; } = "Español";
        public string Sede { get; set; } = "Sede Miraflores";
        public string Sala { get; set; } = "Sala 1";
        public DateTime Fecha { get; set; } = DateTime.Today;
        public TimeOnly HoraInicio { get; set; } = new TimeOnly(18, 0);
        public TimeOnly HoraFin { get; set; } = new TimeOnly(20, 0);
        public double Precio { get; set; }
    }

    private FuncionFormulario Formulario { get; set; } = new();


    private string[] Eventos = { "Coco", "Interestelar", "La casa de Bernarda Alba", "Taller de fotografía urbana" };
    private string[] Idiomas = { "Español", "Subtitulada", "Doblada" };
    private string[] Sedes = { "Sede Miraflores", "Sede Barranco" };
    private string[] Salas = { "Sala 1", "Sala 2", "Sala 3" };

    protected override void OnParametersSet()
    {
        if (Id == null)
        {
            Formulario = new FuncionFormulario();  
            return;
        }
   
        Formulario = new FuncionFormulario
        {
            Evento = "Coco",
            Idioma = "Español",
            Sede = "Sede Miraflores",
            Sala = "Sala 2",
            Fecha = new DateTime(2026, 11, 7),
            HoraInicio = new TimeOnly(18, 0),
            HoraFin = new TimeOnly(19, 45),
            Precio = 18.00
        };
    }

    private void Guardar()
    {
     
        Nav.NavigateTo("/admin/funciones");
    }
}
