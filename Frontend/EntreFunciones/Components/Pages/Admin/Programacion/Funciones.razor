@page "/admin/funciones"
@using Microsoft.AspNetCore.Components.QuickGrid
@using EntreFunciones.DTOSS
@using EntreFunciones.Servicios.Rest
@attribute [Authorize(Policy = "Programacion")]
@inject NavigationManager Nav
@inject ICatalogoService Catalogo
@rendermode InteractiveServer

<PageTitle>Funciones</PageTitle>

<div class="page-shell">
<div class="page-header">
    <div>
        <h1 class="page-title">Funciones</h1>
        <p class="page-description">Consulta horarios y estados de la programación.</p>
    </div>
    <button type="button" class="btn btn-primary" @onclick='() => Nav.NavigateTo("admin/funciones/nueva")'>
        Programar función
    </button>
</div>

@if (Cargando)
{
    <div class="text-center my-5" role="status">
        <div class="spinner-border" aria-hidden="true"></div>
        <p class="text-muted mt-2">Cargando funciones...</p>
    </div>
}
else if (ErrorCarga is not null)
{
    <div class="alert alert-danger" role="alert">
        No se pudo cargar la programación: @ErrorCarga
        <button type="button" class="btn btn-sm btn-outline-danger ms-2" @onclick="Cargar">Reintentar</button>
    </div>
}
else
{
    @if (MensajeAccion is not null)
    {
        <div class="alert alert-danger" role="alert" aria-live="assertive">@MensajeAccion</div>
    }

    <div class="filter-panel">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-4">
                <label for="filtroEvento" class="form-label">Evento</label>
                <input id="filtroEvento" class="form-control" placeholder="Ingrese el nombre del evento" @bind="FiltroEvento" />
            </div>
            <div class="col-12 col-md-3">
                <label for="filtroSede" class="form-label">Sede</label>
                <select id="filtroSede" class="form-select" @bind="FiltroSede">
                    <option value="">Todas</option>
                    @foreach (string sede in Sedes)
                    {
                        <option value="@sede">@sede</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-3">
                <label for="filtroEstado" class="form-label">Estado</label>
                <select id="filtroEstado" class="form-select" @bind="FiltroEstado">
                    <option value="">Todos</option>
                    <option value="PROGRAMADA">Programada</option>
                    <option value="CONFIRMADA">Confirmada</option>
                    <option value="CANCELADA">Cancelada</option>
                </select>
            </div>
            <div class="col-12 col-md-auto d-flex gap-2">
                <button type="button" class="btn btn-primary" @onclick="AplicarFiltros">Filtrar</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="LimpiarFiltros">Limpiar</button>
            </div>
        </div>
    </div>

    @if (!FuncionesVisibles.Any())
    {
        <div class="empty-state" role="status">No hay funciones que coincidan con el filtro.</div>
    }
    else
    {
        <div class="data-table-wrapper">
        <QuickGrid Items="FuncionesVisibles" Pagination="Paginacion" Class="table table-striped table-hover">
            <PropertyColumn Title="Id" Property="f => f.Id" Sortable="true" />
            <PropertyColumn Title="Evento" Property="f => f.TituloEvento" Sortable="true" />
            <TemplateColumn Title="Sede / Sala">
                @context.NombreSede · @context.NombreSala
            </TemplateColumn>
            <TemplateColumn Title="Fecha" Sortable="true" SortBy="@(GridSort<FuncionDTO>.ByAscending(f => f.Fecha))">
                @FormatearFecha(context.Fecha)
            </TemplateColumn>
            <TemplateColumn Title="Horario">
                @FormatearHora(context.HoraInicio) – @FormatearHora(context.HoraFin)
            </TemplateColumn>
            <PropertyColumn Title="Idioma" Property="f => f.Idioma" />
            <TemplateColumn Title="Estado" Sortable="true" SortBy="@(GridSort<FuncionDTO>.ByAscending(f => f.Estado))">
                @EstadoBadge(context.Estado)
            </TemplateColumn>
            <TemplateColumn Title="Acciones">
                @if (context.Estado == "PROGRAMADA")
                {
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick='() => Nav.NavigateTo($"admin/funciones/editar/{context.Id}")'>Editar</button>
                    <button type="button" class="btn btn-success btn-sm" @onclick="() => Confirmar(context)">Confirmar</button>
                    <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => PedirConfirmacionCancelar(context)">Cancelar</button>
                }
                else if (context.Estado == "CONFIRMADA")
                {
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick='() => Nav.NavigateTo($"admin/funciones/editar/{context.Id}")'>Editar</button>
                    <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => PedirConfirmacionCancelar(context)">Cancelar</button>
                }
                else
                {
                    <span class="text-muted small">Sin acciones</span>
                }
            </TemplateColumn>
        </QuickGrid>
        </div>
        <Paginator State="Paginacion"></Paginator>
    }
}
</div>

<ModalConfirmacion Visible="FuncionACancelar != null" Titulo="¿Cancelar función?" Variante="danger"
                   Icono="bi-exclamation-triangle" TextoConfirmar="Sí, cancelar" Procesando="Procesando"
                   OnConfirmar="ConfirmarCancelacion" OnCancelar="() => FuncionACancelar = null">
    @if (FuncionACancelar != null)
    {
        <p class="mb-0">
            Se cancelará la función de <strong>@FuncionACancelar.TituloEvento</strong> del
            @FormatearFecha(FuncionACancelar.Fecha) a las @FormatearHora(FuncionACancelar.HoraInicio).
            Esta acción no se puede deshacer.
        </p>
    }
</ModalConfirmacion>

@code {
    private bool Cargando = true;
    private string? ErrorCarga;
    private string? MensajeAccion;
    private bool Procesando;

    private FuncionDTO? FuncionACancelar;
    private readonly PaginationState Paginacion = new() { ItemsPerPage = 10 };

    private string FiltroEvento = "";
    private string FiltroSede = "";
    private string FiltroEstado = "";

    private List<FuncionDTO> Todas = new();
    private IQueryable<FuncionDTO> FuncionesVisibles = Enumerable.Empty<FuncionDTO>().AsQueryable();

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }

    private async Task Cargar()
    {
        Cargando = true;
        ErrorCarga = null;
        try
        {
            Todas = (await Catalogo.ListarFuncionesAdministrativas())
                .OrderBy(f => f.Fecha).ThenBy(f => f.HoraInicio)
                .ToList();
            AplicarFiltros();
        }
        catch (Exception ex)
        {
            ErrorCarga = ex.Message;
        }
        finally
        {
            Cargando = false;
        }
    }

    private List<string> Sedes => Todas.Select(f => f.NombreSede ?? "").Where(s => s != "").Distinct().OrderBy(s => s).ToList();

    private void AplicarFiltros()
    {
        FuncionesVisibles = Todas.Where(f =>
            (string.IsNullOrWhiteSpace(FiltroEvento) || (f.TituloEvento ?? "").Contains(FiltroEvento, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(FiltroSede) || f.NombreSede == FiltroSede) &&
            (string.IsNullOrEmpty(FiltroEstado) || f.Estado == FiltroEstado))
            .AsQueryable();
    }

    private void LimpiarFiltros()
    {
        FiltroEvento = "";
        FiltroSede = "";
        FiltroEstado = "";
        AplicarFiltros();
    }

    private async Task Confirmar(FuncionDTO funcion)
    {
        MensajeAccion = null;
        try
        {
            funcion.Estado = "CONFIRMADA";
            await Catalogo.ActualizarFuncion(funcion);
            await Cargar();
        }
        catch (Exception ex)
        {
            MensajeAccion = ex.Message;
        }
    }

    private void PedirConfirmacionCancelar(FuncionDTO funcion)
    {
        MensajeAccion = null;
        FuncionACancelar = funcion;
    }

    private async Task ConfirmarCancelacion()
    {
        if (FuncionACancelar == null) return;

        Procesando = true;
        try
        {
            await Catalogo.CancelarFuncion(FuncionACancelar.Id);
            FuncionACancelar = null;
            await Cargar();
        }
        catch (Exception ex)
        {
            MensajeAccion = ex.Message;
            FuncionACancelar = null;
        }
        finally
        {
            Procesando = false;
        }
    }

    private string FormatearFecha(string fechaIso) =>
        DateOnly.TryParse(fechaIso, out DateOnly fecha) ? fecha.ToString("dd/MM/yyyy") : fechaIso;

    private string FormatearHora(string horaIso) =>
        TimeOnly.TryParse(horaIso, out TimeOnly hora) ? hora.ToString("HH:mm") : horaIso;

    private MarkupString EstadoBadge(string estado) => estado switch
    {
        "CONFIRMADA" => new MarkupString("<span class=\"badge bg-success\">Confirmada</span>"),
        "PROGRAMADA" => new MarkupString("<span class=\"badge bg-warning text-dark\">Programada</span>"),
        "CANCELADA" => new MarkupString("<span class=\"badge bg-secondary\">Cancelada</span>"),
        _ => new MarkupString($"<span class=\"badge bg-light text-dark\">{estado}</span>")
    };
}
