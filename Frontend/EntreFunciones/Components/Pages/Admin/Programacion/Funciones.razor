@page "/admin/funciones"
@attribute [Authorize(Policy = "Programacion")]
@inject NavigationManager Nav

<PageTitle>Funciones</PageTitle>

<div class="page-shell">
<div class="page-header">
    <div>
        <h1 class="page-title">Funciones</h1>
        <p class="page-description">Consulta horarios y estados de la programación.</p>
    </div>
    <button type="button" class="btn btn-primary" @onclick='() => Nav.NavigateTo("admin/funciones/nueva")'>
        Programar función
    </button>
</div>

<div class="filter-panel">
    <div class="row g-3 align-items-end">
        <div class="col-12 col-md">
            <label for="filtroEvento" class="form-label">Evento</label>
            <input id="filtroEvento" class="form-control" placeholder="Ingrese el nombre del evento" />
        </div>
        <div class="col-12 col-md-auto d-flex gap-2">
            <button type="button" class="btn btn-primary">Filtrar</button>
            <button type="button" class="btn btn-outline-secondary">Limpiar</button>
        </div>
    </div>
</div>

<div class="data-table-wrapper">
<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Id</th>
            <th>Evento</th>
            <th>Sede / Sala</th>
            <th>Fecha</th>
            <th>Horario</th>
            <th>Idioma</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>1</td>
            <td>Coco</td>
            <td>Sede Miraflores · Sala 2</td>
            <td>07/11/2026</td>
            <td>18:00 – 19:45</td>
            <td>Español</td>
            <td><span class="badge bg-success">Confirmada</span></td>
            <td>
                <button type="button" class="btn btn-outline-danger btn-sm">Cancelar</button>
            </td>
        </tr>
        <tr>
            <td>2</td>
            <td>Interestelar</td>
            <td>Sede Miraflores · Sala 1</td>
            <td>07/11/2026</td>
            <td>20:30 – 23:20</td>
            <td>Subtitulada</td>
            <td><span class="badge bg-warning text-dark">Programada</span></td>
            <td>
                <button type="button" class="btn btn-success btn-sm">Confirmar</button>
                <button type="button" class="btn btn-outline-danger btn-sm">Cancelar</button>
            </td>
        </tr>
        <tr>
            <td>3</td>
            <td>La casa de Bernarda Alba</td>
            <td>Sede Barranco · Sala Principal</td>
            <td>08/11/2026</td>
            <td>19:00 – 21:00</td>
            <td>Español</td>
            <td><span class="badge bg-warning text-dark">Programada</span></td>
            <td>
                <button type="button" class="btn btn-success btn-sm">Confirmar</button>
                <button type="button" class="btn btn-outline-danger btn-sm">Cancelar</button>
            </td>
        </tr>
        <tr>
            <td>4</td>
            <td>Taller de fotografía urbana</td>
            <td>Sede Barranco · Sala Taller</td>
            <td>09/11/2026</td>
            <td>10:00 – 12:00</td>
            <td>Español</td>
            <td><span class="badge bg-success">Confirmada</span></td>
            <td>
                <button type="button" class="btn btn-outline-danger btn-sm">Cancelar</button>
            </td>
        </tr>
        <tr>
            <td>5</td>
            <td>El avaro</td>
            <td>Sede Miraflores · Sala 3</td>
            <td>10/11/2026</td>
            <td>20:00 – 22:00</td>
            <td>Español</td>
            <td><span class="badge bg-secondary">Cancelada</span></td>
            <td><span class="text-muted small">Sin acciones</span></td>
        </tr>
    </tbody>
</table>
</div>
</div>
