@page "/admin/funciones"
@using System.Globalization
@using EntreFunciones.DTOSS
@using EntreFunciones.Servicios.Rest
@attribute [Authorize(Policy = "Programacion")]
@inject NavigationManager Nav
@inject ICatalogoService Catalogo
@rendermode InteractiveServer

<PageTitle>Funciones</PageTitle>

<div class="page-shell">
<div class="page-header">
    <div>
        <h1 class="page-title">Funciones</h1>
        <p class="page-description">Consulta horarios y estados de la programación.</p>
    </div>
    <button type="button" class="btn btn-primary" @onclick='() => Nav.NavigateTo("admin/funciones/nueva")'>
        Programar función
    </button>
</div>

@if (Cargando)
{
    <div class="text-center my-5" role="status">
        <div class="spinner-border" aria-hidden="true"></div>
        <p class="text-muted mt-2">Cargando funciones...</p>
    </div>
}
else if (ErrorCarga is not null)
{
    <div class="alert alert-danger" role="alert">
        No se pudo cargar la programación: @ErrorCarga
        <button type="button" class="btn btn-sm btn-outline-danger ms-2" @onclick="Cargar">Reintentar</button>
    </div>
}
else
{
    @if (MensajeAccion is not null)
    {
        <div class="alert alert-danger" role="alert" aria-live="assertive">@MensajeAccion</div>
    }

    <div class="filter-panel">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md">
                <label for="filtroEvento" class="form-label">Evento</label>
                <input id="filtroEvento" class="form-control" placeholder="Ingrese el nombre del evento" @bind="FiltroEvento" @bind:event="oninput" />
            </div>
            <div class="col-12 col-md-auto d-flex gap-2">
                <button type="button" class="btn btn-outline-secondary" @onclick="() => FiltroEvento = string.Empty">Limpiar</button>
            </div>
        </div>
    </div>

    <div class="data-table-wrapper">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Id</th>
                <th>Evento</th>
                <th>Sede / Sala</th>
                <th>Fecha</th>
                <th>Horario</th>
                <th>Idioma</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (FuncionDTO funcion in FuncionesFiltradas)
            {
                <tr>
                    <td>@funcion.Id</td>
                    <td>@funcion.TituloEvento</td>
                    <td>@funcion.NombreSede · @funcion.NombreSala</td>
                    <td>@FormatearFecha(funcion.Fecha)</td>
                    <td>@FormatearHora(funcion.HoraInicio) – @FormatearHora(funcion.HoraFin)</td>
                    <td>@funcion.Idioma</td>
                    <td>@EstadoBadge(funcion.Estado)</td>
                    <td>
                        @if (funcion.Estado == "PROGRAMADA")
                        {
                            <button type="button" class="btn btn-success btn-sm" disabled="@(Procesando == funcion.Id)" @onclick="() => Confirmar(funcion)">Confirmar</button>
                            <button type="button" class="btn btn-outline-danger btn-sm" disabled="@(Procesando == funcion.Id)" @onclick="() => Cancelar(funcion.Id)">Cancelar</button>
                        }
                        else if (funcion.Estado == "CONFIRMADA")
                        {
                            <button type="button" class="btn btn-outline-danger btn-sm" disabled="@(Procesando == funcion.Id)" @onclick="() => Cancelar(funcion.Id)">Cancelar</button>
                        }
                        else
                        {
                            <span class="text-muted small">Sin acciones</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (!FuncionesFiltradas.Any())
    {
        <div class="empty-state" role="status">No hay funciones que coincidan con el filtro.</div>
    }
    </div>
}
</div>

@code {
    private bool Cargando = true;
    private string? ErrorCarga;
    private string? MensajeAccion;
    private int? Procesando;
    private string FiltroEvento = "";

    private List<FuncionDTO> ListaFunciones = new();

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }

    private async Task Cargar()
    {
        Cargando = true;
        ErrorCarga = null;
        try
        {
            ListaFunciones = (await Catalogo.ListarFunciones())
                .OrderBy(f => f.Fecha).ThenBy(f => f.HoraInicio)
                .ToList();
        }
        catch (Exception ex)
        {
            ErrorCarga = ex.Message;
        }
        finally
        {
            Cargando = false;
        }
    }

    private IEnumerable<FuncionDTO> FuncionesFiltradas => ListaFunciones.Where(f =>
        string.IsNullOrWhiteSpace(FiltroEvento) ||
        (f.TituloEvento ?? "").Contains(FiltroEvento, StringComparison.OrdinalIgnoreCase));

    private async Task Confirmar(FuncionDTO funcion)
    {
        Procesando = funcion.Id;
        MensajeAccion = null;
        try
        {
            funcion.Estado = "CONFIRMADA";
            await Catalogo.ActualizarFuncion(funcion);
            await Cargar();
        }
        catch (Exception ex)
        {
            MensajeAccion = ex.Message;
        }
        finally
        {
            Procesando = null;
        }
    }

    private async Task Cancelar(int id)
    {
        Procesando = id;
        MensajeAccion = null;
        try
        {
            await Catalogo.CancelarFuncion(id);
            await Cargar();
        }
        catch (Exception ex)
        {
            MensajeAccion = ex.Message;
        }
        finally
        {
            Procesando = null;
        }
    }

    private string FormatearFecha(string fechaIso) =>
        DateOnly.TryParse(fechaIso, out DateOnly fecha) ? fecha.ToString("dd/MM/yyyy") : fechaIso;

    private string FormatearHora(string horaIso) =>
        TimeOnly.TryParse(horaIso, out TimeOnly hora) ? hora.ToString("HH:mm") : horaIso;

    private MarkupString EstadoBadge(string estado) => estado switch
    {
        "CONFIRMADA" => new MarkupString("<span class=\"badge bg-success\">Confirmada</span>"),
        "PROGRAMADA" => new MarkupString("<span class=\"badge bg-warning text-dark\">Programada</span>"),
        "CANCELADA" => new MarkupString("<span class=\"badge bg-secondary\">Cancelada</span>"),
        _ => new MarkupString($"<span class=\"badge bg-light text-dark\">{estado}</span>")
    };
}
