@page "/login"

<PageTitle>Iniciar sesión</PageTitle>

<div class="col-md-4 mx-auto">
    <h3 class="mb-3">Iniciar sesión</h3>

    @if (Error)
    {
        <div class="alert alert-danger">Credenciales incorrectas</div>
    }
    @if (Registrado)
    {
        <div class="alert alert-success">Registro exitoso. Ya puede iniciar sesión.</div>
    }

    @* Este formulario es un POST normal a /cuenta/login: así el servidor puede crear la cookie de sesión. *@
    <form method="post" action="cuenta/login">
        <AntiforgeryToken />
        <div class="mb-3">
            <label class="form-label">Correo</label>
            <input tabindex="1" name="userName" type="email" class="form-control" placeholder="correo@ejemplo.com" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Contraseña</label>
            <input tabindex="2" name="password" type="password" class="form-control" required />
        </div>
        <button tabindex="3" type="submit" class="btn btn-primary w-100">Ingresar</button>
    </form>

    <div class="d-flex justify-content-between mt-3">
        <a tabindex="4" href="recuperar">¿Olvidaste tu contraseña?</a>
        <a tabindex="5" href="registro">Registrarse</a>
    </div>

    <div class="alert alert-secondary mt-4 small">
        <strong>Datos de prueba (contraseña 123456):</strong><br />
        Administrador: admin@entrefunciones.com<br />
        Cliente: cliente@entrefunciones.com
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public bool Error { get; set; }

    [SupplyParameterFromQuery]
    public bool Registrado { get; set; }
}
