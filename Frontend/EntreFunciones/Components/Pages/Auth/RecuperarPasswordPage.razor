@page "/recuperar"
@using System.Text.RegularExpressions

<PageTitle>Recuperar contraseña</PageTitle>

<div class="page-shell page-shell-narrow">
    <div class="page-header">
        <div>
            <h1 class="page-title">Recuperar contraseña</h1>
            <p class="page-description">Ingresa el correo con el que te registraste.</p>
        </div>
    </div>
    <div class="card card-body shadow-sm">

    @if (Enviado)
    {
        <div class="alert alert-success" role="status" aria-live="polite">
            Si el correo <strong>@Correo</strong> está registrado, recibirá un mensaje
            con las instrucciones para restablecer su contraseña.
        </div>
        <a class="btn btn-primary w-100" href="login">Volver al inicio de sesión</a>
    }
    else
    {
        <form @onsubmit="Enviar">
            <div class="mb-3">
                <label for="correoRecuperacion" class="form-label">Correo registrado</label>
                <input id="correoRecuperacion" type="email" autocomplete="email" class="form-control @(MensajeError != null ? "is-invalid" : "")"
                       placeholder="correo@ejemplo.com" @bind="Correo" @bind:event="oninput" />
                <div class="invalid-feedback">@MensajeError</div>
            </div>

            <button type="submit" class="btn btn-primary">Enviar</button>
            <a class="btn btn-outline-secondary" href="login">Volver</a>
        </form>
    }
    </div>
</div>

@code {
    private string Correo { get; set; } = string.Empty;
    private string? MensajeError { get; set; }
    private bool Enviado { get; set; }

    private void Enviar()
    {
        if (string.IsNullOrWhiteSpace(Correo))
        {
            MensajeError = "El correo es obligatorio";
            return;
        }
        if (!Regex.IsMatch(Correo, @"^[^@\s]+@[^@\s]+\.[^@\s]+$"))
        {
            MensajeError = "El correo debe tener formato válido";
            return;
        }
        MensajeError = null;
        Enviado = true;
    }
}
