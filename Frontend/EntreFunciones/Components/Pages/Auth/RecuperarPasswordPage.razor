@page "/recuperar"
@using System.Text.RegularExpressions
@using EntreFunciones.Servicios
@using EntreFunciones.Servicios.Rest
@inject ICuentaService CuentaService

<PageTitle>Recuperar contraseña</PageTitle>

<div class="page-shell page-shell-narrow">
    <div class="page-header">
        <div>
            <h1 class="page-title">Recuperar contraseña</h1>
            <p class="page-description">Confirma tu identidad con tu correo y DNI, y elige una contraseña nueva.</p>
        </div>
    </div>
    <div class="card card-body shadow-sm">

    @if (Listo)
    {
        <div class="alert alert-success" role="status" aria-live="polite">
            Tu contraseña se cambió correctamente. Ya puedes iniciar sesión con la nueva.
        </div>
        <a class="btn btn-primary w-100" href="login">Ir al inicio de sesión</a>
    }
    else
    {
        @if (!string.IsNullOrEmpty(ErrorServidor))
        {
            <div class="alert alert-danger" role="alert" aria-live="assertive">@ErrorServidor</div>
        }

        <form @onsubmit="Enviar">
            <div class="mb-3">
                <label for="correoRecuperacion" class="form-label">Correo registrado</label>
                <input id="correoRecuperacion" type="email" autocomplete="email" class="form-control @Clase("Correo")"
                       placeholder="correo@ejemplo.com" @bind="Correo" @bind:event="oninput" />
                <div class="invalid-feedback">@Errores.GetValueOrDefault("Correo")</div>
            </div>
            <div class="mb-3">
                <label for="dniRecuperacion" class="form-label">DNI</label>
                <input id="dniRecuperacion" inputmode="numeric" maxlength="8" class="form-control @Clase("Dni")"
                       @bind="Dni" @bind:event="oninput" />
                <div class="invalid-feedback">@Errores.GetValueOrDefault("Dni")</div>
            </div>
            <div class="mb-3">
                <label for="passwordRecuperacion" class="form-label">Nueva contraseña</label>
                <input id="passwordRecuperacion" type="password" autocomplete="new-password" class="form-control @Clase("Password")"
                       @bind="Password" @bind:event="oninput" />
                <div class="invalid-feedback">@Errores.GetValueOrDefault("Password")</div>
            </div>
            <div class="mb-3">
                <label for="confirmarRecuperacion" class="form-label">Confirmar contraseña</label>
                <input id="confirmarRecuperacion" type="password" autocomplete="new-password" class="form-control @Clase("ConfirmarPassword")"
                       @bind="ConfirmarPassword" @bind:event="oninput" />
                <div class="invalid-feedback">@Errores.GetValueOrDefault("ConfirmarPassword")</div>
            </div>

            <button type="submit" class="btn btn-primary">Cambiar contraseña</button>
            <a class="btn btn-outline-secondary" href="login">Volver</a>
        </form>
    }
    </div>
</div>

@code {
    private string Correo { get; set; } = string.Empty;
    private string Dni { get; set; } = string.Empty;
    private string Password { get; set; } = string.Empty;
    private string ConfirmarPassword { get; set; } = string.Empty;
    private Dictionary<string, string> Errores { get; set; } = new();
    private string? ErrorServidor { get; set; }
    private bool Listo { get; set; }

    private string Clase(string campo) => Errores.ContainsKey(campo) ? "is-invalid" : "";

    private bool Validar()
    {
        Errores = new();
        if (!Regex.IsMatch(Correo, @"^[^@\s]+@[^@\s]+\.[^@\s]+$"))
        {
            Errores["Correo"] = "El correo debe tener formato válido";
        }
        if (!Regex.IsMatch(Dni, @"^\d{8}$"))
        {
            Errores["Dni"] = "El DNI debe tener 8 dígitos";
        }
        if (Password.Length < 6)
        {
            Errores["Password"] = "Mínimo 6 caracteres";
        }
        if (ConfirmarPassword != Password)
        {
            Errores["ConfirmarPassword"] = "Las contraseñas no coinciden";
        }
        return Errores.Count == 0;
    }

    private async Task Enviar()
    {
        ErrorServidor = null;
        if (!Validar())
        {
            return;
        }
        try
        {
            // POST /cuentas/recuperar: Java comprueba correo + DNI, cifra y guarda
            await CuentaService.Recuperar(Correo.Trim(), Dni, Password);
            Listo = true;
        }
        catch (ServiceException ex)
        {
            ErrorServidor = ex.Message;   // "El correo y el DNI no coinciden con una cuenta activa"
        }
    }
}
