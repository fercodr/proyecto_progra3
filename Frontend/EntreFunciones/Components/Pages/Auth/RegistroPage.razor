@page "/registro"
@using System.Text.RegularExpressions
@using EntreFunciones.DTOSS.Usuarios
@using EntreFunciones.Servicios
@using EntreFunciones.Servicios.Rest
@inject NavigationManager Nav
@inject IClienteService ClienteService

<PageTitle>Registro</PageTitle>

<div class="page-shell page-shell-narrow">
    <div class="page-header">
        <div>
            <h1 class="page-title">Registro de cliente</h1>
            <p class="page-description">Crea una cuenta para reservar y administrar tus compras.</p>
        </div>
    </div>
    <div class="card card-body shadow-sm">

    @if (Errores.Any())
    {
        <div class="alert alert-danger" role="alert" aria-live="assertive">Revisa los campos marcados en rojo.</div>
    }

    @if (!string.IsNullOrEmpty(ErrorServidor))
    {
        <div class="alert alert-danger" role="alert" aria-live="assertive">@ErrorServidor</div>
    }

    <form @onsubmit="Registrar">
        <h5>Cuenta de usuario</h5>
        <div class="mb-3">
            <label for="correoRegistro" class="form-label">Correo electrónico</label>
            <input id="correoRegistro" type="email" autocomplete="email" class="form-control @Clase("Correo")" @bind="Correo" @bind:event="oninput" />
            <div class="invalid-feedback">@Errores.GetValueOrDefault("Correo")</div>
        </div>
        <div class="mb-3">
            <label for="passwordRegistro" class="form-label">Contraseña</label>
            <input id="passwordRegistro" type="password" autocomplete="new-password" class="form-control @Clase("Password")" @bind="Password" @bind:event="oninput" />
            <div class="invalid-feedback">@Errores.GetValueOrDefault("Password")</div>
        </div>
        <div class="mb-3">
            <label for="confirmarPassword" class="form-label">Confirmar contraseña</label>
            <input id="confirmarPassword" type="password" autocomplete="new-password" class="form-control @Clase("ConfirmarPassword")" @bind="ConfirmarPassword" @bind:event="oninput" />
            <div class="invalid-feedback">@Errores.GetValueOrDefault("ConfirmarPassword")</div>
        </div>

        <h5 class="mt-4">Datos personales</h5>
        <div class="mb-3">
            <label for="dniRegistro" class="form-label">DNI</label>
            <input id="dniRegistro" inputmode="numeric" class="form-control @Clase("Dni")" maxlength="8" @bind="Dni" @bind:event="oninput" />
            <div class="invalid-feedback">@Errores.GetValueOrDefault("Dni")</div>
        </div>
        <div class="mb-3">
            <label for="nombresRegistro" class="form-label">Nombres</label>
            <input id="nombresRegistro" autocomplete="given-name" class="form-control @Clase("Nombres")" @bind="Nombres" @bind:event="oninput" />
            <div class="invalid-feedback">@Errores.GetValueOrDefault("Nombres")</div>
        </div>
        <div class="mb-3">
            <label for="apellidosRegistro" class="form-label">Apellidos</label>
            <input id="apellidosRegistro" autocomplete="family-name" class="form-control @Clase("Apellidos")" @bind="Apellidos" @bind:event="oninput" />
            <div class="invalid-feedback">@Errores.GetValueOrDefault("Apellidos")</div>
        </div>
        <div class="mb-3">
            <label for="telefonoRegistro" class="form-label">Teléfono</label>
            <input id="telefonoRegistro" type="tel" inputmode="numeric" autocomplete="tel" class="form-control @Clase("Telefono")" maxlength="9" @bind="Telefono" @bind:event="oninput" />
            <div class="invalid-feedback">@Errores.GetValueOrDefault("Telefono")</div>
        </div>

        <button type="submit" class="btn btn-primary">Registrarse</button>
        <a class="btn btn-outline-secondary" href="login">Cancelar</a>
    </form>
    </div>
</div>

@code {
    private string Correo { get; set; } = string.Empty;
    private string Password { get; set; } = string.Empty;
    private string ConfirmarPassword { get; set; } = string.Empty;
    private string Dni { get; set; } = string.Empty;
    private string Nombres { get; set; } = string.Empty;
    private string Apellidos { get; set; } = string.Empty;
    private string Telefono { get; set; } = string.Empty;
    private Dictionary<string, string> Errores { get; set; } = new();
    private string? ErrorServidor { get; set; }

    private string Clase(string campo) => Errores.ContainsKey(campo) ? "is-invalid" : "";

    private bool Validar()
    {
        Errores = new();
        if (string.IsNullOrWhiteSpace(Correo))
        {
            Errores["Correo"] = "El correo es obligatorio";
        }
        else if (!Regex.IsMatch(Correo, @"^[^@\s]+@[^@\s]+\.[^@\s]+$"))
        {
            Errores["Correo"] = "El correo debe tener formato válido";
        }
        if (string.IsNullOrWhiteSpace(Password))
        {
            Errores["Password"] = "La contraseña es obligatoria";
        }
        else if (Password.Length < 6)
        {
            Errores["Password"] = "Mínimo 6 caracteres";
        }
        if (ConfirmarPassword != Password)
        {
            Errores["ConfirmarPassword"] = "Las contraseñas no coinciden";
        }
        if (!Regex.IsMatch(Dni, @"^\d{8}$"))
        {
            Errores["Dni"] = "El DNI debe tener 8 dígitos";
        }
        if (string.IsNullOrWhiteSpace(Nombres))
        {
            Errores["Nombres"] = "Los nombres son obligatorios";
        }
        if (string.IsNullOrWhiteSpace(Apellidos))
        {
            Errores["Apellidos"] = "Los apellidos son obligatorios";
        }
        if (!Regex.IsMatch(Telefono, @"^9\d{8}$"))
        {
            Errores["Telefono"] = "El teléfono debe tener 9 dígitos y empezar con 9";
        }
        return Errores.Count == 0;
    }

    private async Task Registrar()
    {
        ErrorServidor = null;
        if (!Validar())
        {
            return;
        }

        ClienteDTO nuevo = new()
        {
            Correo = Correo.Trim(),
            Contrasena = Password,
            Dni = Dni,
            Nombres = Nombres.Trim(),
            Apellidos = Apellidos.Trim(),
            Telefono = Telefono
        };

        try
        {
            // POST /clientes: Java valida, cifra la contraseña y guarda
            await ClienteService.Registrar(nuevo);
            Nav.NavigateTo("/login?registrado=true");
        }
        catch (ServiceException ex)
        {
            // Mensaje que manda Java, p. ej. "Ya existe una cuenta con ese correo"
            ErrorServidor = ex.Message;
        }
    }
}