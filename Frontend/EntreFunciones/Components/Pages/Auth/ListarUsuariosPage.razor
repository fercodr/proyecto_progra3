@page "/admin/usuarios"
@attribute [Authorize(Policy = "UsuariosRoles")]
@inject NavigationManager Nav

@using Microsoft.AspNetCore.Components.QuickGrid

<PageTitle>Usuarios y roles</PageTitle>

<div class="page-shell">
<div class="page-header">
    <div>
        <h1 class="page-title">Usuarios y roles</h1>
        <p class="page-description">Consulta clientes y administra las cuentas del equipo.</p>
    </div>
    @if (PestanaActiva == "administradores") {
        <button type="button" class="btn btn-primary" @onclick="NuevoAdministrador">
            Nuevo administrador
        </button>
    }
</div>

<ul class="nav nav-tabs mb-3" role="tablist" aria-label="Tipos de usuario">
    <li class="nav-item">
        <button type="button" class="nav-link @(PestanaActiva == "clientes" ? "active" : "")" role="tab" aria-selected="@(PestanaActiva == "clientes")"
                @onclick='() => CambiarPestana("clientes")'>Clientes</button>
    </li>
    <li class="nav-item">
        <button type="button" class="nav-link @(PestanaActiva == "administradores" ? "active" : "")" role="tab" aria-selected="@(PestanaActiva == "administradores")"
                @onclick='() => CambiarPestana("administradores")'>Administradores</button>
    </li>
</ul>

@if (MensajeExito != null) {
    <div class="alert alert-success" role="status" aria-live="polite">@MensajeExito</div>
}

<div class="filter-panel">
    <div class="row g-3 align-items-end">
        <div class="col-12 col-md">
            <label for="filtroUsuario" class="form-label">Nombre</label>
            <input id="filtroUsuario" class="form-control" placeholder="Ingrese nombres o apellidos" @bind="Filtro" />
        </div>
        <div class="col-12 col-md-auto d-flex gap-2">
            <button type="button" class="btn btn-primary" @onclick="Filtrar">Filtrar</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="LimpiarFiltro">Limpiar</button>
        </div>
    </div>
</div>

@if (PestanaActiva == "clientes") {
    @if (!Clientes.Any()) {
        <div class="empty-state" role="status">No hay clientes registrados.</div>
    }
    else {
        <div class="data-table-wrapper">
        <QuickGrid Items="Clientes" Pagination="PaginacionClientes" Class="table table-striped table-hover">
            <PropertyColumn Title="Id" Property="c => c.Id" Sortable="true" />
            <PropertyColumn Title="DNI" Property="c => c.Dni" Sortable="true" />
            <PropertyColumn Title="Nombres" Property="c => c.Nombres" Sortable="true" />
            <PropertyColumn Title="Apellidos" Property="c => c.Apellidos" Sortable="true" />
            <PropertyColumn Title="Correo" Property="c => c.Correo" Sortable="true" />
            <PropertyColumn Title="Teléfono" Property="c => c.Telefono" />
            <TemplateColumn Title="Activo" Align="Align.Center">
                <input type="checkbox" checked="@context.IsActivo" disabled />
            </TemplateColumn>
            <TemplateColumn Title="Acciones">
                <button type="button" class="btn btn-sm @(context.IsActivo ? "btn-warning" : "btn-success")"
                        @onclick="() => CambiarEstadoCliente(context)">
                    @(context.IsActivo ? "Desactivar" : "Activar")
                </button>
            </TemplateColumn>
        </QuickGrid>
        </div>
        <Paginator State="PaginacionClientes"></Paginator>
    }
}
else {
    @if (!Administradores.Any()) {
        <div class="empty-state" role="status">No hay administradores registrados.</div>
    }
    else {
        <div class="data-table-wrapper">
        <QuickGrid Items="Administradores" Pagination="PaginacionAdministradores" Class="table table-striped table-hover">
            <PropertyColumn Title="Id" Property="a => a.Id" Sortable="true" />
            <PropertyColumn Title="Cód. empleado" Property="a => a.CodigoEmpleado" Sortable="true" />
            <PropertyColumn Title="Nombres" Property="a => a.Nombres" Sortable="true" />
            <PropertyColumn Title="Apellidos" Property="a => a.Apellidos" Sortable="true" />
            <PropertyColumn Title="Correo" Property="a => a.Correo" Sortable="true" />
            <TemplateColumn Title="Activo" Align="Align.Center">
                <input type="checkbox" checked="@context.IsActivo" disabled />
            </TemplateColumn>
            <TemplateColumn Title="Acciones">
                <button type="button" class="btn btn-sm @(context.IsActivo ? "btn-warning" : "btn-success")"
                        @onclick="() => CambiarEstadoAdministrador(context)">
                    @(context.IsActivo ? "Desactivar" : "Activar")
                </button>
            </TemplateColumn>
        </QuickGrid>
        </div>
        <Paginator State="PaginacionAdministradores"></Paginator>
    }
}
</div>

@code {
    [SupplyParameterFromQuery(Name = "pestana")]
    public string? Pestana { get; set; }

    private IQueryable<ClienteDemo> Clientes { get; set; } = Enumerable.Empty<ClienteDemo>().AsQueryable();
    private IQueryable<AdministradorDemo> Administradores { get; set; } = Enumerable.Empty<AdministradorDemo>().AsQueryable();
    private string PestanaActiva { get; set; } = "clientes";
    private string Filtro { get; set; } = string.Empty;
    private string? MensajeExito { get; set; }
    private PaginationState PaginacionClientes { get; } = new() { ItemsPerPage = 5 };
    private PaginationState PaginacionAdministradores { get; } = new() { ItemsPerPage = 5 };

    protected override void OnInitialized() {
        if (Pestana == "administradores") {
            PestanaActiva = "administradores";
        }
        CargarTodo();
    }

    private void CargarTodo() {
        Clientes = DatosDemo.Clientes.AsQueryable();
        Administradores = DatosDemo.Administradores.AsQueryable();
    }

    private void CambiarPestana(string pestana) {
        PestanaActiva = pestana;
        MensajeExito = null;
        LimpiarFiltro();
    }

    private void NuevoAdministrador() {
        Nav.NavigateTo("/admin/usuarios/administradores/nuevo");
    }

    private void Filtrar() {
        string f = Filtro.Trim().ToLower();
        Clientes = DatosDemo.Clientes
            .Where(c => (c.Nombres + " " + c.Apellidos).ToLower().Contains(f))
            .AsQueryable();
        Administradores = DatosDemo.Administradores
            .Where(a => (a.Nombres + " " + a.Apellidos).ToLower().Contains(f))
            .AsQueryable();
    }

    private void LimpiarFiltro() {
        Filtro = string.Empty;
        CargarTodo();
    }

    private void CambiarEstadoCliente(ClienteDemo cliente) {
        cliente.IsActivo = !cliente.IsActivo;
        MensajeExito = $"Cliente {cliente.Nombres} {(cliente.IsActivo ? "activado" : "desactivado")}.";
    }

    private void CambiarEstadoAdministrador(AdministradorDemo admin) {
        admin.IsActivo = !admin.IsActivo;
        MensajeExito = $"Administrador {admin.Nombres} {(admin.IsActivo ? "activado" : "desactivado")}.";
    }
}
