@page "/admin/usuarios/administradores/nuevo"
@attribute [Authorize(Policy = "UsuariosRoles")]
@using System.Text.RegularExpressions
@using EntreFunciones.DTOSS.Usuarios
@using EntreFunciones.Servicios
@using EntreFunciones.Servicios.Rest
@inject NavigationManager Nav
@inject IGestionAdministradorService AdministradorService

<PageTitle>Nuevo administrador</PageTitle>

<div class="page-shell page-shell-narrow">
<div class="page-header">
    <div>
        <h1 class="page-title">Nuevo administrador</h1>
        <p class="page-description">Registra los datos de acceso de un integrante del equipo.</p>
    </div>
</div>
<div class="card card-body shadow-sm">

@if (Errores.Any())
{
    <div class="alert alert-danger" role="alert" aria-live="assertive">Revisa los campos marcados en rojo.</div>
}
@if (!string.IsNullOrEmpty(ErrorServidor))
{
    <div class="alert alert-danger" role="alert" aria-live="assertive">@ErrorServidor</div>
}

<form @onsubmit="Guardar">
    <div class="mb-3">
        <label for="codigoEmpleado" class="form-label">Código de empleado</label>
        <input id="codigoEmpleado" class="form-control @Clase("CodigoEmpleado")" placeholder="EMP-0000"
               @bind="CodigoEmpleado" @bind:event="oninput" />
        <div class="invalid-feedback">@Errores.GetValueOrDefault("CodigoEmpleado")</div>
    </div>
    <div class="mb-3">
        <label for="dniAdministrador" class="form-label">DNI</label>
        <input id="dniAdministrador" inputmode="numeric" maxlength="8" class="form-control @Clase("Dni")" @bind="Dni" @bind:event="oninput" />
        <div class="invalid-feedback">@Errores.GetValueOrDefault("Dni")</div>
    </div>
    <div class="mb-3">
        <label for="nombresAdministrador" class="form-label">Nombres</label>
        <input id="nombresAdministrador" autocomplete="given-name" class="form-control @Clase("Nombres")" @bind="Nombres" @bind:event="oninput" />
        <div class="invalid-feedback">@Errores.GetValueOrDefault("Nombres")</div>
    </div>
    <div class="mb-3">
        <label for="apellidosAdministrador" class="form-label">Apellidos</label>
        <input id="apellidosAdministrador" autocomplete="family-name" class="form-control @Clase("Apellidos")" @bind="Apellidos" @bind:event="oninput" />
        <div class="invalid-feedback">@Errores.GetValueOrDefault("Apellidos")</div>
    </div>
    <div class="mb-3">
        <label for="correoAdministrador" class="form-label">Correo electrónico</label>
        <input id="correoAdministrador" type="email" autocomplete="email" class="form-control @Clase("Correo")" @bind="Correo" @bind:event="oninput" />
        <div class="invalid-feedback">@Errores.GetValueOrDefault("Correo")</div>
    </div>
    <div class="mb-3">
        <label for="passwordAdministrador" class="form-label">Contraseña</label>
        <input id="passwordAdministrador" type="password" autocomplete="new-password" class="form-control @Clase("Password")" @bind="Password" @bind:event="oninput" />
        <div class="invalid-feedback">@Errores.GetValueOrDefault("Password")</div>
    </div>
    <div class="form-check mb-3">
        <input id="administradorActivo" type="checkbox" class="form-check-input" @bind="IsActivo" />
        <label for="administradorActivo" class="form-check-label">Activo</label>
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a class="btn btn-outline-secondary" href="admin/usuarios?pestana=administradores">Cancelar</a>
</form>
</div>
</div>

@code {
    private string CodigoEmpleado { get; set; } = string.Empty;
    private string Dni { get; set; } = string.Empty;
    private string Nombres { get; set; } = string.Empty;
    private string Apellidos { get; set; } = string.Empty;
    private string Correo { get; set; } = string.Empty;
    private string Password { get; set; } = string.Empty;
    private bool IsActivo { get; set; } = true;
    private Dictionary<string, string> Errores { get; set; } = new();
    private string? ErrorServidor { get; set; }

    private string Clase(string campo) => Errores.ContainsKey(campo) ? "is-invalid" : "";

    private bool Validar()
    {
        Errores = new();
        if (!Regex.IsMatch(CodigoEmpleado, @"^EMP-\d{4}$"))
        {
            Errores["CodigoEmpleado"] = "Formato esperado: EMP-0000";
        }
        if (!Regex.IsMatch(Dni, @"^\d{8}$"))
        {
            Errores["Dni"] = "El DNI debe tener 8 dígitos";
        }
        if (string.IsNullOrWhiteSpace(Nombres))
        {
            Errores["Nombres"] = "Los nombres son obligatorios";
        }
        if (string.IsNullOrWhiteSpace(Apellidos))
        {
            Errores["Apellidos"] = "Los apellidos son obligatorios";
        }
        if (string.IsNullOrWhiteSpace(Correo))
        {
            Errores["Correo"] = "El correo es obligatorio";
        }
        else if (!Regex.IsMatch(Correo, @"^[^@\s]+@[^@\s]+\.[^@\s]+$"))
        {
            Errores["Correo"] = "El correo debe tener formato válido";
        }
        if (string.IsNullOrWhiteSpace(Password))
        {
            Errores["Password"] = "La contraseña es obligatoria";
        }
        else if (Password.Length < 6)
        {
            Errores["Password"] = "Mínimo 6 caracteres";
        }
        return Errores.Count == 0;
    }

    private async Task Guardar()
    {
        ErrorServidor = null;
        if (!Validar())
        {
            return;
        }

        AdministradorDTO nuevo = new()
        {
            CodigoEmpleado = CodigoEmpleado.Trim(),
            Dni = Dni,
            Nombres = Nombres.Trim(),
            Apellidos = Apellidos.Trim(),
            Correo = Correo.Trim(),
            Contrasena = Password,
            Activo = IsActivo
        };

        try
        {
            // POST /administradores: Java valida, cifra la contraseña y guarda
            await AdministradorService.Registrar(nuevo);
            Nav.NavigateTo("/admin/usuarios?pestana=administradores");
        }
        catch (ServiceException ex)
        {
            ErrorServidor = ex.Message;   // p. ej. "Ya existe una cuenta con ese correo"
        }
    }
}