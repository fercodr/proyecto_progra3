

<div class="card h-100 w-100 bg-light text-start">
    <div class="card-body p-3">
        
        <h6 class="small fw-semibold text-secondary mb-1">@Atribute</h6>
        <h5 class="fs-2 fw-bold text-dark mb-0 text-nowrap">@TextoResumen</h5>

    </div>
</div>
@code {
    [Parameter, EditorRequired]
    public string Atribute { get; set; } = default!;

    [Parameter, EditorRequired]
    public decimal Amount { get; set; }

    [Parameter]
    public string Unit { get; set; } = default!;

    [Parameter]
    public string? AmountText { get; set; }

    private bool EsMonetario => string.Equals(Unit, "S/", StringComparison.Ordinal);

    private string TextoResumen
    {
        get
        {
            string valor = AmountText
                ?? Amount.ToString(EsMonetario ? "N2" : "N0");
            if (string.IsNullOrWhiteSpace(Unit))
            {
                return valor;
            }

            return EsMonetario ? $"{Unit} {valor}" : $"{valor} {Unit}";
        }
    }

}
