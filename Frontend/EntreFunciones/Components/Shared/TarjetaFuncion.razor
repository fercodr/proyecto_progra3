<div class="card h-100 shadow-sm">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <h5 class="card-title mb-0">@Evento</h5>
            <span class="badge @ColorEstado">@Estado</span>
        </div>
        <p class="mb-1"> @Fecha  @HoraInicio – @HoraFin</p>
        <p class="mb-1 text-muted"> @Sede · @Sala</p>
        <p class="mb-0 text-muted small">Idioma: @Idioma</p>
    </div>
    <div class="card-footer bg-transparent d-flex gap-2">
        @if (Estado == "Programada")
        {
            <button class="btn btn-success btn-sm">Confirmar</button>
            <button class="btn btn-outline-danger btn-sm">Cancelar</button>
        }
        else if (Estado == "Confirmada")
        {
            <button class="btn btn-outline-danger btn-sm">Cancelar</button>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Evento { get; set; } = default!;
    [Parameter, EditorRequired] public string Fecha { get; set; } = default!;
    [Parameter, EditorRequired] public string HoraInicio { get; set; } = default!;
    [Parameter, EditorRequired] public string HoraFin { get; set; } = default!;
    [Parameter, EditorRequired] public string Sede { get; set; } = default!;
    [Parameter, EditorRequired] public string Sala { get; set; } = default!;
    [Parameter] public string Idioma { get; set; } = "Español";
    [Parameter, EditorRequired] public string Estado { get; set; } = default!;

    // Color de la etiqueta según el estado (solo presentación)
    private string ColorEstado => Estado switch
    {
        "Confirmada" => "bg-success",
        "Programada" => "bg-warning text-dark",
        _ => "bg-secondary"
    };
}