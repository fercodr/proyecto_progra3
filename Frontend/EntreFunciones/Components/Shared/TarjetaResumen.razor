<div class="card h-100 shadow-sm">
    <img src="@Imagen" class="card-img-top" alt="@Titulo"
         style="height: 260px; object-fit: cover;" />

    <div class="card-body">
        <span class="badge theme-primary align-self-start">@Tipo</span>
        <h5 class="card-title">@Titulo</h5>
        <p class="card-text small fg-3">@Detalle</p>
    </div>

    <div class="card-footer bg-transparent">
        <a class="btn-solid theme-primary btn-sm" href="@Enlace">Editar</a>
    </div>
</div>

@code {
    [Parameter, EditorRequired] 
    public string Titulo { get; set; } = default!;
    [Parameter, EditorRequired] 
    public string Tipo { get; set; } = default!;
    [Parameter, EditorRequired] 
    public string Imagen { get; set; } = default!;
    [Parameter] 
    public string Detalle { get; set; } = "";
    [Parameter, EditorRequired] 
    public string Enlace { get; set; } = default!;
}