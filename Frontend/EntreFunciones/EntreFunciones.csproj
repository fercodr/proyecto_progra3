<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Components\Pages\CarteleraSeleccion\**" />
    <Compile Remove="Components\Pages\Espacios\**" />
    <Compile Remove="Components\Pages\IngresoSeguimiento\**" />
    <Compile Remove="Components\Pages\Ventas\**" />
    <Content Remove="Components\Pages\CarteleraSeleccion\**" />
    <Content Remove="Components\Pages\Espacios\**" />
    <Content Remove="Components\Pages\IngresoSeguimiento\**" />
    <Content Remove="Components\Pages\Ventas\**" />
    <EmbeddedResource Remove="Components\Pages\CarteleraSeleccion\**" />
    <EmbeddedResource Remove="Components\Pages\Espacios\**" />
    <EmbeddedResource Remove="Components\Pages\IngresoSeguimiento\**" />
    <EmbeddedResource Remove="Components\Pages\Ventas\**" />
    <None Remove="Components\Pages\CarteleraSeleccion\**" />
    <None Remove="Components\Pages\Espacios\**" />
    <None Remove="Components\Pages\IngresoSeguimiento\**" />
    <None Remove="Components\Pages\Ventas\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.QuickGrid" Version="10.0.14" />
    <!-- Dibuja el código QR de cada entrada dentro del propio servidor (RF-M5-03), sin servicios externos. -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

</Project>
