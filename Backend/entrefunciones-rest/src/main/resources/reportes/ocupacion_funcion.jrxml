<jasperReport name="OcupacionFuncion" pageWidth="842" pageHeight="595"
              orientation="Landscape" whenNoDataType="AllSectionsNoDetail"
              columnWidth="802" leftMargin="20" rightMargin="20"
              topMargin="20" bottomMargin="20">
    <property name="net.sf.jasperreports.export.pdf.metadata.title" value="Ocupación por función"/>
    <style name="Base" default="true" fontName="SansSerif" fontSize="9.0"/>
    <style name="Encabezado" mode="Opaque" forecolor="#FFFFFF" backcolor="#273746"
           bold="true" vTextAlign="Middle"/>
    <parameter name="TITULO" class="java.lang.String"/>
    <parameter name="FILTROS" class="java.lang.String"/>
    <field name="funcion" class="java.lang.String"/>
    <field name="fecha" class="java.lang.String"/>
    <field name="sala" class="java.lang.String"/>
    <field name="aforo" class="java.lang.Integer"/>
    <field name="entradasVigentes" class="java.lang.Integer"/>
    <field name="porcentajeOcupacion" class="java.math.BigDecimal"/>
    <title height="72">
        <element kind="textField" x="0" y="0" width="802" height="28"
                 fontSize="20.0" bold="true">
            <expression><![CDATA[$P{TITULO}]]></expression>
        </element>
        <element kind="staticText" x="0" y="36" width="50" height="16" bold="true">
            <text><![CDATA[Filtros:]]></text>
        </element>
        <element kind="textField" x="52" y="36" width="750" height="30"
                 textAdjust="StretchHeight">
            <expression><![CDATA[$P{FILTROS}]]></expression>
        </element>
    </title>
    <columnHeader height="30">
        <element kind="staticText" x="0" y="0" width="250" height="30" style="Encabezado">
            <text><![CDATA[Función]]></text><box leftPadding="5"/>
        </element>
        <element kind="staticText" x="250" y="0" width="90" height="30" style="Encabezado">
            <text><![CDATA[Fecha]]></text><box leftPadding="5"/>
        </element>
        <element kind="staticText" x="340" y="0" width="150" height="30" style="Encabezado">
            <text><![CDATA[Sala]]></text><box leftPadding="5"/>
        </element>
        <element kind="staticText" x="490" y="0" width="80" height="30" style="Encabezado" hTextAlign="Right">
            <text><![CDATA[Aforo]]></text><box rightPadding="5"/>
        </element>
        <element kind="staticText" x="570" y="0" width="125" height="30" style="Encabezado" hTextAlign="Right">
            <text><![CDATA[Entradas vigentes]]></text><box rightPadding="5"/>
        </element>
        <element kind="staticText" x="695" y="0" width="107" height="30" style="Encabezado" hTextAlign="Right">
            <text><![CDATA[Ocupación]]></text><box rightPadding="5"/>
        </element>
    </columnHeader>
    <detail>
        <band height="25">
            <element kind="textField" x="0" y="0" width="250" height="24" textAdjust="StretchHeight" vTextAlign="Middle">
                <expression><![CDATA[$F{funcion}]]></expression><box leftPadding="5"><bottomPen lineWidth="0.5" lineColor="#D5D8DC"/></box>
            </element>
            <element kind="textField" x="250" y="0" width="90" height="24" vTextAlign="Middle">
                <expression><![CDATA[$F{fecha}]]></expression><box leftPadding="5"><bottomPen lineWidth="0.5" lineColor="#D5D8DC"/></box>
            </element>
            <element kind="textField" x="340" y="0" width="150" height="24" textAdjust="StretchHeight" vTextAlign="Middle">
                <expression><![CDATA[$F{sala}]]></expression><box leftPadding="5"><bottomPen lineWidth="0.5" lineColor="#D5D8DC"/></box>
            </element>
            <element kind="textField" x="490" y="0" width="80" height="24" hTextAlign="Right" vTextAlign="Middle" pattern="#0">
                <expression><![CDATA[$F{aforo}]]></expression><box rightPadding="5"><bottomPen lineWidth="0.5" lineColor="#D5D8DC"/></box>
            </element>
            <element kind="textField" x="570" y="0" width="125" height="24" hTextAlign="Right" vTextAlign="Middle" pattern="#0">
                <expression><![CDATA[$F{entradasVigentes}]]></expression><box rightPadding="5"><bottomPen lineWidth="0.5" lineColor="#D5D8DC"/></box>
            </element>
            <element kind="textField" x="695" y="0" width="107" height="24" hTextAlign="Right" vTextAlign="Middle" pattern="#0.00' %'">
                <expression><![CDATA[$F{porcentajeOcupacion}]]></expression><box rightPadding="5"><bottomPen lineWidth="0.5" lineColor="#D5D8DC"/></box>
            </element>
        </band>
    </detail>
    <pageFooter height="22">
        <element kind="textField" x="690" y="7" width="112" height="15" hTextAlign="Right">
            <expression><![CDATA["Página " + $V{PAGE_NUMBER}]]></expression>
        </element>
    </pageFooter>
    <summary height="35">
        <element kind="staticText" x="0" y="10" width="802" height="20" hTextAlign="Center" italic="true">
            <printWhenExpression><![CDATA[$V{REPORT_COUNT} == 0]]></printWhenExpression>
            <text><![CDATA[No se encontraron resultados para los filtros seleccionados.]]></text>
        </element>
    </summary>
</jasperReport>
